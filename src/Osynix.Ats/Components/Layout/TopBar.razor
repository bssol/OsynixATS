@implements IDisposable
@inject RecruitmentUpdates Updates
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Osynix.Ats.Data
@inject AuthenticationStateProvider Auth
@inject IDbContextFactory<AtsDbContext> Factory
<header class="ats-topbar">
    <div class="header-brand">
        <a class="topbar-logo" href="@home" aria-label="Osynix Group dashboard"><img src="/images/osynix-group-logo.png" alt="Osynix Group" width="175" height="30" /></a>
    </div>

    <form class="global-search" action="/search" method="get" role="search">
        <svg width="23" height="23" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input id="workspace-search" name="q" aria-label="Search candidates and jobs" placeholder="Search candidates, jobs, or keywords..." autocomplete="off" />
        <button type="submit" class="search-submit" aria-label="Submit search">Search</button>
    </form>
    <AuthorizeView><Authorized>
        <div class="topbar-actions">
            <RecruiterNotifications />
            <details class="header-menu profile-menu">
                <summary aria-label="Open profile menu">
                    <img class="user-avatar" src="@avatar" alt="Profile avatar" width="40" height="40" />
                    <span class="user-label"><strong>@name</strong><small>@role</small></span>
                    <svg class="menu-chevron" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
                </summary>
                <div class="header-popover profile-popover">@if(canSwitch){<div class="profile-mode-picker"><small>Working Profile</small>@foreach(var mode in new[]{"Employer","Agency"}){<form method="post" action="/Account/ProfileMode" data-enhance="false"><AntiforgeryToken /><input type="hidden" name="Mode" value="@mode"/><button class="secondary profile-mode-button @(currentMode==mode?"selected":"")" disabled="@(currentMode==mode)" type="submit">@mode @(currentMode==mode?"✓":"")</button></form>}</div>}<a href="/profile">My Profile</a><LogoutButton CssClass="text-button profile-logout" /></div>
            </details>
        </div>
    </Authorized><NotAuthorized><a href="/Account/Login">Sign in</a></NotAuthorized></AuthorizeView>
</header>
@code {
    [Parameter] public EventCallback OnToggleSidebar {get;set;}
    bool canSwitch,agencyEnabled;string currentMode="Employer";
    string avatar="/images/profile-avatar.svg";
    string name = "", role = "", home="/";bool employer;
    protected override async Task OnInitializedAsync(){Updates.Changed+=Changed;await LoadProfile();}
    void Changed()=>_=InvokeAsync(async()=>{await LoadProfile();StateHasChanged();});
    public void Dispose()=>Updates.Changed-=Changed;
    async Task LoadProfile()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true) return;
        employer=user.IsInRole("Employer")&&!user.IsInRole("Admin");home=employer?"/employer":"/";
        name = user.Identity.Name ?? "My account";
        role = string.Join(", ", user.FindAll(ClaimTypes.Role).Select(x => x.Value));
        await using var db = await Factory.CreateDbContextAsync();
        var account = await db.Users.FindAsync(user.FindFirstValue(ClaimTypes.NameIdentifier));
        if(account is not null)avatar=SelfProfileService.ImageUrl(account);
        if (!string.IsNullOrWhiteSpace(account?.FullName)) name = account.FullName;
        canSwitch=false;agencyEnabled=false;if(account is not null&&account.AccountType!=AccountTypes.Legacy){role=account.AccountType;try{var active=await WorkspaceContext.Resolve(db,user);if(active.Membership is not null){role="Team Member";home="/";}else if(active.Owner&&account.AccountType==AccountTypes.Employer){var w=await db.EmployerWorkspaces.AsNoTracking().SingleAsync(w=>w.Id==active.Id);canSwitch=w.Kind==AccountTypes.Employer;agencyEnabled=w.AgencyEnabled;currentMode=await ProfileModes.Selected(db,user,active)==true?"Agency":"Employer";role=currentMode;}}catch(UnauthorizedAccessException){}}
    }
}
