@page "/assessment"
@attribute [Authorize(Roles="Admin,Recruiter")]
@inherits PageBase
@inject AtsService Ats
@inject AiService Ai
@inject WorkspaceService Workspace
<PageTitle>Candidate assessment · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">EVIDENCE BASED SCREENING</div><h1>Candidate assessment</h1><p class="muted">Assess one CV or a batch of up to five against approved criteria.</p></div></div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<section class="panel"><div class="form-grid"><label>Client<select @bind="client"><option value="">All clients</option>@foreach(var name in positions.Select(x=>x.Client).Distinct().Order()){<option>@name</option>}</select></label><label>Position<select @bind="positionId"><option value="">Select active position</option>@foreach(var p in positions.Where(x=>x.Status=="Active"&&x.CriteriaLocked&&(client==""||x.Client==client))){<option value="@p.Id">#@p.Reference — @p.Title · @p.Client</option>}</select></label><label>Mode<select @bind="batch"><option value="false">Single CV</option><option value="true">Batch CV (maximum five)</option></select></label></div>
@if(positionId is not null&&positions.FirstOrDefault(x=>x.Id==positionId) is Position selected){<details class="criterion-editor"><summary>Approved assessment framework · @selected.Criteria.Count criteria</summary>@foreach(var c in selected.Criteria){<p><b>@c.Name</b> · @c.Weight% @(c.Knockout?"· Must-have":"")<small>@c.EvidenceExpected</small></p>}</details>}
@if(CandidateId is not null){<p>Updated CV for <b>@people.FirstOrDefault(x=>x.Id==CandidateId)?.Name</b></p><label class="check"><input type="checkbox" @bind="refreshProfile" /> Explicitly refresh this person's permanent profile and master CV when saved</label>}
<label class="upload-zone">Upload CVs<InputFile OnChange="Choose" multiple="@batch" accept=".pdf,.docx,.txt" /><small>PDF, DOCX or TXT · 10 MB each</small></label><ul>@foreach(var file in files){<li>@file.Name</li>}</ul><p class="muted small">Assessment sends these documents to your configured AI account. Results remain drafts until Save to ATS.</p><button disabled="@(Busy||files.Count==0||positionId is null)" @onclick="AssessFiles">Run assessment</button></section>
<section class="panel"><div class="section-heading"><h2>Assessment workspace</h2><div><button class="secondary" disabled="@SaveDisabled" @onclick="SaveAll">Save Remaining</button>@if(CurrentResults.Count>0){<a class="button secondary" href="@ReportUrl" target="_blank">Batch PDF</a>}</div></div><label>Current batch<select @bind="selectedBatch"><option value="">Unbatched drafts</option>@foreach(var b in batches){<option value="@b.Id">@b.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC · @b.Mode · @b.Items.Count file(s)</option>}</select></label>
<div class="table-wrap"><table><thead><tr><th>File / candidate</th><th>Match / must-have</th><th>Decision</th><th>State</th><th>Actions</th></tr></thead><tbody>
@if(selectedBatch is not null){@foreach(var item in CurrentItems.OrderBy(x=>x.Index)){var a=results.FirstOrDefault(x=>x.Id==item.AssessmentId);<tr><td>@item.FileName<small>@a?.CandidateName</small></td><td>@a?.MatchPercent%<small>@a?.MustHaveFit</small></td><td>@if(a is not null){<DecisionBadge Value="@a.Decision" />}</td><td>@item.State@if(item.Error.Length>0){<small class="error">@item.Error</small>}</td><td>@if(a is not null){<a href="@($"/assessment/{a.Id}")">View</a>@if(item.State=="Draft"){<button class="secondary" disabled="@Busy" @onclick="()=>Save(a.Id)">Save to ATS</button>}}@if(item.State=="Failed"){<label>Retry original file<InputFile OnChange="e=>Retry(e,item)" accept=".pdf,.docx,.txt" disabled="@Busy" /></label>}</td></tr>}}else{@foreach(var a in CurrentResults){<tr><td>@a.CandidateName<small>@a.SourceFileName</small></td><td>@a.MatchPercent%<small>@a.MustHaveFit</small></td><td>@a.Decision</td><td>@a.State</td><td><a href="@($"/assessment/{a.Id}")">View</a><button class="secondary" disabled="@Busy" @onclick="()=>Save(a.Id)">Save to ATS</button></td></tr>}}
</tbody></table></div><p class="muted small">Retry a failed item by selecting its original file below. Saved items are never repeated; retry uses the original position and profile-refresh mode.</p></section>
@code{
[SupplyParameterFromQuery(Name="candidate")]public Guid? CandidateId{get;set;}
List<Position> positions=[];List<Candidate> people=[];List<Assessment> results=[];List<AssessmentBatch> batches=[];IReadOnlyList<IBrowserFile> files=[];Guid? positionId,selectedBatch;bool batch,refreshProfile;string client="";
List<BatchItem> CurrentItems=>batches.FirstOrDefault(x=>x.Id==selectedBatch)?.Items??[];
List<Assessment> CurrentResults=>selectedBatch is null?results.Where(x=>x.BatchId is null&&x.State=="Draft").ToList():results.Where(x=>CurrentItems.Any(i=>i.AssessmentId==x.Id)).DistinctBy(x=>x.Id).ToList();
bool SaveDisabled=>Busy||(selectedBatch is null?CurrentResults.Count==0:CurrentItems.All(x=>x.State!="Draft"));
string ReportUrl=>"/reports?format=pdf&ids="+string.Join(',',CurrentResults.Select(a=>a.Id));
protected override Task OnInitializedAsync()=>Run(async()=>{positions=await Ats.Positions();people=await Ats.Candidates();await Reload();selectedBatch=batches.FirstOrDefault(x=>x.State=="Open")?.Id;});
async Task Reload(){results=await Ats.Assessments();batches=await Workspace.Batches();}
void Choose(InputFileChangeEventArgs e){try{files=e.GetMultipleFiles(batch&&CandidateId is null?5:1);Error="";}catch(InvalidOperationException){files=[];Error="Select at most five CVs, or one for a profile refresh.";}}
Task AssessFiles()=>Run(async()=>{selectedBatch=await Workspace.CreateBatch(positionId!.Value,files.Select(x=>x.Name).ToArray(),CandidateId,refreshProfile);var failures=new List<string>();for(var i=0;i<files.Count;i++){var file=files[i];try{using var stream=new MemoryStream();await file.OpenReadStream(AiService.MaxFileSize).CopyToAsync(stream);var id=await Ai.Assess(positionId!.Value,file.Name,stream.ToArray(),batchId:selectedBatch,batchIndex:i,candidateId:CandidateId,refreshProfile:refreshProfile);await Workspace.SetBatchItem(selectedBatch.Value,i,id);}catch(Exception e){var message=e is InvalidOperationException?e.Message:"Upload or provider request failed.";failures.Add(file.Name+": "+message);await Workspace.SetBatchItem(selectedBatch.Value,i,null,message);}}files=[];await Reload();Error=string.Join(" | ",failures);Notice="Batch results ready for review.";});
Task Retry(InputFileChangeEventArgs e,BatchItem item)=>Run(async()=>{
var original=batches.Single(x=>x.Id==item.BatchId);if(e.File.Name!=item.FileName)throw new InvalidOperationException("Choose the original file named "+item.FileName+".");
try{using var stream=new MemoryStream();await e.File.OpenReadStream(AiService.MaxFileSize).CopyToAsync(stream);var id=await Ai.Assess(original.PositionId,e.File.Name,stream.ToArray(),batchId:original.Id,batchIndex:item.Index,candidateId:original.SourceCandidateId,refreshProfile:original.RefreshProfile);await Workspace.SetBatchItem(original.Id,item.Index,id);Notice="Retried item is ready for review.";}
catch(Exception failure){await Workspace.SetBatchItem(original.Id,item.Index,null,failure is InvalidOperationException?failure.Message:"Upload or provider request failed.");throw;}finally{await Reload();}
});
Task Save(Guid id)=>Run(async()=>{await Ats.SaveDraft(id);await Reload();Notice="Assessment saved.";});
Task SaveAll()=>Run(async()=>{var ids=selectedBatch is null?CurrentResults.Select(x=>x.Id).ToList():CurrentItems.Where(x=>x.State=="Draft"&&x.AssessmentId is not null).Select(x=>x.AssessmentId!.Value).ToList();var errors=new List<string>();foreach(var id in ids){try{await Ats.SaveDraft(id);}catch(InvalidOperationException e){errors.Add(e.Message);}}await Reload();if(selectedBatch is not null&&CurrentItems.All(x=>x.State=="Saved"))await Workspace.CompleteBatch(selectedBatch.Value);Notice="Remaining drafts processed.";Error=string.Join(" | ",errors);});
}
