@page "/assessment/{Id:guid}"
@attribute [Authorize(Roles="Admin,Recruiter")]
@inherits PageBase
@inject AtsService Ats
@inject NavigationManager Nav
<PageTitle>Assessment · Osynix ATS</PageTitle>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(a is not null&&view is not null&&snapshot is not null){<div class="page-heading"><div><a href="/assessment">← Assessment workspace</a><h1>@a.CandidateName</h1><p class="muted">@snapshot.PositionTitle · @snapshot.Client · #@snapshot.Reference</p></div><a class="button" href="@ReportUrl">Download PDF</a></div>
@if(versions.Count>0){<label>Assessment history<select @bind="number" @bind:after="SelectVersion">@foreach(var v in versions){<option value="@v.Number">Version @v.Number · @v.CreatedUtc.ToString("yyyy-MM-dd") · @v.Decision</option>}</select></label>}
<AssessmentSummary Application="view" Snapshot="snapshot" Framework="@(a.Position?.Criteria??[])" />
@if(a.State=="Saved"){<section class="panel"><h2>Current recruitment progress</h2><LifecycleEditor Application="a" OnSaved="Load" /><p><a href="@($"/candidates?id={a.CandidateId}")">Open permanent candidate profile</a></p></section>}
<section class="panel"><h2>Candidate message</h2><p class="muted small">Review and copy manually.</p><textarea rows="8" readonly>@ScoringEngine.Message(a.CandidateName,snapshot.PositionTitle,view.Decision)</textarea></section>
@if(a.State=="Draft"){<button disabled="@Busy" @onclick="Save">Save to ATS</button>}}
@code{
[Parameter]public Guid Id{get;set;}Assessment? a,view;AssessmentSnapshot? snapshot;List<AssessmentVersion> versions=[];int number;
string ReportUrl=>$"/reports?format=pdf&ids={a?.Id}"+(a?.State=="Saved"?$"&version={number}":"");
protected override Task OnParametersSetAsync()=>Run(Load);
async Task Load(){a=(await Ats.Assessments()).SingleOrDefault(x=>x.Id==Id);if(a is null){Error="Assessment not found.";return;}if(a.ReplacedByAssessmentId is not null){Nav.NavigateTo($"/assessment/{a.ReplacedByAssessmentId}",replace:true);return;}a.Position=(await Ats.Positions()).Single(x=>x.Id==a.PositionId);versions=await Ats.Versions(a.Id);number=a.VersionNumber;SelectVersion();}
void SelectVersion(){if(a is null)return;view=JsonSerializer.Deserialize<Assessment>(JsonSerializer.Serialize(a));var v=versions.FirstOrDefault(x=>x.Number==number);if(v is not null){view!.SnapshotJson=v.SnapshotJson;view.Decision=v.Decision;view.MatchPercent=v.MatchPercent;view.MustHaveFit=v.MustHaveFit;view.CoreRoleFit=v.CoreRoleFit;view.EvidenceStrength=v.EvidenceStrength;view.VersionNumber=v.Number;}snapshot=JsonSerializer.Deserialize<AssessmentSnapshot>(view!.SnapshotJson);}
Task Save()=>Run(async()=>{var saved=await Ats.SaveDraft(Id);if(saved!=Id)Nav.NavigateTo($"/assessment/{saved}");else await Load();Notice="Saved to ATS.";});
}
