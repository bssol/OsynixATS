@implements IDisposable
@inject RecruitmentUpdates Updates
@page "/candidates"
@page "/talent"
@page "/master-talent"
@attribute [Authorize(Roles="Admin,Recruiter,Employer")]
@inherits PageBase
@inject AtsService Ats
@inject WorkspaceService Workspace
@inject Access Access
@inject AiService Ai
@inject NavigationManager Nav
<PageTitle>@(IsTalent?(IsMaster?"Osynix Master Talent Pool":"My Talent Pool"):"Candidate Profiles") · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">@(IsTalent?"PERMANENT CANDIDATE REPOSITORY":"CANDIDATES AND APPLICATIONS")</div><h1>@(IsTalent?(IsMaster?"Osynix Master Talent Pool":"My Talent Pool"):"Candidate Profiles")</h1><p class="muted">@(IsTalent?"Find and reuse candidate intelligence across vacancies.":"Manage recruitment progress with the person and selected application in context.")</p></div></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(IsMaster&&isAdmin){<p><a class="button secondary" href="/settings/talent-review">Review Duplicate Identities</a></p>}
@if(IsTalent&&!canTalent){<section class="panel"><h2>@(IsMaster?"Master Talent Pool Is Locked":"Workspace Talent Pool Access Is Disabled")</h2><p class="muted">@(IsMaster?"Admin Has Not Granted Access In This Workspace. No Master Profiles Are Loaded Or Displayed.":"Ask Your Employer To Enable Your Workspace Talent Pool Permission.")</p><div class="table-wrap"><table aria-label="Locked Talent Pool Results"><thead><tr><th>Candidate</th><th>Role</th><th>Location</th></tr></thead><tbody></tbody></table></div><p class="empty">No Results — Access Not Granted.</p></section>}
else{
@if(!IsTalent){<div class="kpis"><button class="kpi" @onclick="Clear"><span>Total people</span><strong>@all.Count</strong></button>@foreach(var queue in Queues){<button class="kpi" @onclick="()=>Queue=queue"><span>@queue</span><strong>@all.Count(c=>Lifecycle.Classify(Context(c),c.TalentStatus)==queue)</strong></button>}</div>}
<section class="panel candidate-directory"><div class="toolbar"><input placeholder="Search ID, name, email, phone or job title…" aria-label="Search candidates" @bind="search" @bind:event="oninput" /><select aria-label="City Filter" @bind="location"><option value="">All Cities</option>@foreach(var s in all.Select(CandidateCity.Display).Where(x=>x.Length>0).Distinct().Order()){<option>@s</option>}</select><select aria-label="Seniority filter" @bind="seniority"><option value="">All seniority</option>@foreach(var s in all.Select(x=>x.Seniority).Where(x=>x.Length>0).Distinct().Order()){<option>@s</option>}</select><select aria-label="Talent status" @bind="talent"><option value="">All talent status</option>@foreach(var s in Choices.TalentStatuses){<option>@s</option>}</select><button class="secondary" @onclick="Clear">Clear</button></div>
@if(!IsTalent){<div class="toolbar"><select aria-label="Position filter" @bind="PositionReference"><option value="">All positions</option>@foreach(var p in positions){<option value="@p.Reference">#@p.Reference — @p.Title · @p.Client</option>}</select><select aria-label="Lifecycle queue" @bind="Queue"><option value="">All lifecycle queues</option>@foreach(var q in Queues){<option>@q</option>}</select><select aria-label="AI decision" @bind="decision"><option value="">All AI decisions</option>@foreach(var d in Choices.Decisions){<option>@d</option>}</select></div>}
<div class="pager"><span>@Filtered.Count Candidates · Page @Page / @Pages</span><button class="secondary" disabled="@(Page<=1)" @onclick="()=>page=Page-1">Previous</button><button class="secondary" disabled="@(Page>=Pages)" @onclick="()=>page=Page+1">Next</button></div>
<div class="table-wrap"><table class="candidate-contact-table" aria-label="Candidate Directory"><thead><tr><th>Candidate ID</th><th>Name</th><th>Email</th><th>Phone</th><th>City</th><th>Current Job Title</th><th>Seniority</th><th></th></tr></thead><tbody>
@foreach(var c in Filtered.Skip((Page-1)*25).Take(25)){<tr><td><span class="candidate-reference">@Shown(c.LegacyId)</span></td><td><b>@c.Name</b></td><td>@Shown(c.Email)</td><td class="candidate-phone">@Shown(c.Phone)</td><td>@Shown(CandidateCity.Display(c))</td><td>@Shown(c.CurrentRole)</td><td><span class="candidate-seniority">@Shown(c.Seniority)</span></td><td><button type="button" aria-label="@($"View {c.Name}")" disabled="@Busy" @onclick="()=>OpenSafely(c)">View</button></td></tr>}
</tbody></table></div>@if(Filtered.Count==0){<p class="empty">No Candidates Match These Filters.</p>}</section>
@if(selected is not null){<div class="overlay" role="presentation" @onclick="Close"><section class="drawer wide candidate-workspace" role="dialog" aria-modal="true" aria-label="Candidate profile" @onclick:stopPropagation="true"><div class="drawer-head candidate-profile-heading"><div class="candidate-heading-identity"><div class="candidate-monogram" aria-hidden="true">@Initials(selected.Name)</div><div><span class="eyebrow">CANDIDATE PROFILE</span><h2>@selected.Name</h2><div class="candidate-inline"><NavIcon Name="positions" /><span>@Shown(selected.CurrentRole)</span><NavIcon Name="clients" /><span>@Shown(selected.CurrentCompany)</span></div><div class="profile-header-actions">@if(selected.DocumentId is not null){<a class="button secondary" target="_blank" rel="noopener noreferrer" href="@($"/files/{selected.DocumentId}?view=true")">View Original CV</a>}else if(Uri.TryCreate(selected.LegacyCvLink,UriKind.Absolute,out var cv)&&cv.Scheme=="https"){<a class="button secondary" href="@cv" target="_blank" rel="noopener noreferrer">View Original CV</a>}else{<button type="button" class="secondary" disabled title="No Original CV Is Attached To This Record">View Original CV</button>}</div></div></div><button type="button" class="secondary" aria-label="Close candidate profile" @onclick="Close">Close</button></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(selected is not null&&selected.CvProfileStatus=="Failed"){<div class="error" role="alert"><b>CV Profile Extraction Needs Review</b><div>@selected.CvProfileError</div><div class="small">The application and original CV are saved. Review the CV manually before deciding whether to run a position assessment.</div></div>}
else if(selected is not null&&selected.CvProfileStatus=="Pending"){<div class="notice" role="status">CV profile details are being extracted. The original CV and application are saved.</div>}
<div class="candidate-split-profile"><CandidateIdentityCard Person="selected" CanEdit="canOperate" Edit="BeginProfileEdit" /><div class="candidate-profile-content"><nav class="tabs" aria-label="Candidate Profile Sections">@foreach(var t in (canOperate?new[]{"Overview","Assessment","Notes","Activity"}:new[]{"Overview","Assessment"})){<button class="@(tab==t?"active":"")" @onclick="()=>tab=t">@(t=="Assessment"?"Assessments & Decisions":t)</button>}</nav>
@if(tab=="Overview"){
@if(editingProfile){<section class="panel candidate-profile-editor"><div class="section-heading"><h3>Edit Candidate Details</h3><button class="secondary" @onclick="CancelProfileEdit">Cancel</button></div><div class="form-grid"><label>Name<input @bind="selected.Name" /></label><label>Email<input type="email" @bind="selected.Email" /></label><label>Phone<input @bind="selected.Phone" /></label><label>City Only<input @bind="selected.City" @bind:event="oninput" placeholder="e.g. Lahore" maxlength="80" /></label><label>Current Job Title<input @bind="selected.CurrentRole" /></label><label>Current Employer<input @bind="selected.CurrentCompany" /></label><label>Total Experience (Years)<input type="number" min="0" max="80" step="0.5" @bind="selected.TotalExperience" /></label><label>Seniority<input @bind="selected.Seniority" /></label><label>Talent Status<select @bind="selected.TalentStatus">@foreach(var status in Choices.TalentStatuses){<option>@status</option>}</select></label><label>Primary Function<input @bind="selected.Function" /></label><label>Specialization<input @bind="selected.Specialization" /></label><label>Industry<input @bind="selected.Industry" /></label><label>Systems / Tools<input @bind="selected.Systems" /></label><label>Market Exposure<input @bind="selected.Markets" /></label></div><label>Skills<textarea @bind="selected.Skills"></textarea></label><label>Professional Summary<textarea rows="4" @bind="selected.Summary"></textarea></label><label>Career Summary<textarea rows="4" @bind="selected.CareerSummary"></textarea></label><button disabled="@Busy" @onclick="SaveProfile">Save Candidate Details</button></section>}<CandidateCvOverview Person="selected" />
@if(canOperate){<p class="muted small"><a href="@($"/assessment?candidate={selected.Id}")">Upload An Updated CV</a></p>}
}
@if(tab=="Assessment"){
<div class="section-heading candidate-assessment-title"><h3>Assessments By Position</h3><small>@History.Count Positions</small></div>
@foreach(var a in History){var expanded=applicationId==a.Id;var region=$"candidate-assessment-{a.Id}";<section class="candidate-assessment-group" @key="a.Id"><button class="candidate-assessment-toggle" aria-expanded="@expanded" aria-controls="@region" @onclick="()=>ToggleAssessment(a.Id)"><span class="candidate-assessment-icon"><NavIcon Name="positions" /></span><span><b>@(a.Position?.Title??"Position Unavailable")</b><small><NavIcon Name="clients" />@a.Position?.Client · #@a.Position?.Reference</small></span><span class="candidate-assessment-chevron" aria-hidden="true">@(expanded?"⌄":"›")</span></button>
@if(expanded&&view is not null){<div class="candidate-assessment-body" id="@region">@if(reportSnapshot is not null){<div class="candidate-inline-report-heading"><h3>Assessment Report</h3><button class="secondary" @onclick="()=>reportSnapshot=null">Back To Assessment</button></div><AssessmentSummary Application="view" Snapshot="reportSnapshot" Framework="@(a.Position?.Criteria??[])" ShowReportLink="canExport" ReportLinkLabel="Export Report" />}else{<AssessmentMetricCards Application="view" /><div class="candidate-report-actions">@if(versions.Count>1){<label>Assessment Version<select aria-label="Assessment Version" @bind="versionNumber" @bind:after="SelectVersion">@foreach(var version in versions){<option value="@version.Number">Version @version.Number · @version.CreatedUtc.ToString("dd MMM yyyy")</option>}</select></label>}else{<small>Version @view.VersionNumber · @((a.LastAssessedDate??a.CreatedUtc).ToString("dd MMM yyyy"))</small>}<button @onclick="OpenReport">View Report</button></div><section class="candidate-assessment-outcome"><div class="section-heading"><h4>Assessment Outcome</h4><DecisionBadge Value="@view.Decision" /></div>@if(PositionNote(a) is string summary&&summary.Length>0){<small>Latest Position Note</small><p class="preserve">@ShortNote(summary)</p>}else{<p class="muted small">No Position Notes Yet.</p>}@if(canOperate){<button class="text-button" @onclick="()=>OpenPositionNotes(a.Id)">View Position Notes (@NoteCount(a))</button>}</section>}</div>}
</section>}
@if(History.Count==0){<p class="empty">No Saved Assessments In This Workspace.</p>}
@if(canTalent){<details class="panel candidate-reassessment"><summary>Assess Against Another Position</summary><select aria-label="Reassessment position" @bind="reassessPosition"><option value="">Choose An Active, Approved Position</option>@foreach(var p in positions.Where(x=>x.Status=="Active"&&x.CriteriaLocked)){<option value="@p.Id">#@p.Reference — @p.Title · @p.Client</option>}</select><p class="muted small">Uses Stored Profile Evidence. Missing Evidence Remains Unavailable.</p><button disabled="@(Busy||reassessPosition is null)" @onclick="Reassess">Assess Stored Profile</button></details>}
}
@if(tab=="Notes"){
<div class="section-heading candidate-assessment-title"><h3>Position Notes</h3><small>@History.Count Positions</small></div>
@foreach(var a in History){var expanded=noteApplication==a.Id;var region=$"candidate-notes-{a.Id}";<section class="candidate-assessment-group" @key="a.Id"><button class="candidate-assessment-toggle" aria-expanded="@expanded" aria-controls="@region" @onclick="()=>ToggleNotes(a.Id)"><span class="candidate-assessment-icon"><NavIcon Name="message" /></span><span><b>@(a.Position?.Title??"Position Unavailable")</b><small>@a.Position?.Client · #@a.Position?.Reference</small></span><span class="candidate-note-count">@NoteCount(a) Notes</span><span class="candidate-assessment-chevron" aria-hidden="true">@(expanded?"⌄":"›")</span></button>@if(expanded){<div class="candidate-assessment-body" id="@region">@if(a.RecruiterNotes.Length>0){<article class="candidate-position-note"><small>Existing Application Note</small><p class="preserve">@a.RecruiterNotes</p></article>}@foreach(var note in notes.Where(n=>n.AssessmentId==a.Id)){<CandidateNoteCard @key="note.Id" Note="note" CanEdit="@(isAdmin||note.AuthorId==currentUser)" OnSaved="ReloadNotes" />}@if(NoteCount(a)==0){<p class="muted">No Notes For This Position Yet.</p>}<details class="candidate-add-note"><summary>Add Position Note</summary><label>Note For @a.Position?.Title<textarea rows="3" maxlength="10000" @bind="noteText" @bind:event="oninput"></textarea></label><button disabled="@Busy" @onclick="()=>AddNote(a.Id)">Save Position Note</button></details></div>}</section>}
@if(History.Count==0){<p class="empty">No Position Assessments In This Workspace.</p>}
@if(selected.Notes.Length>0||notes.Any(n=>n.AssessmentId is null)){<details class="panel candidate-legacy-notes"><summary>General Candidate Notes (Legacy)</summary>@if(selected.Notes.Length>0){<p class="preserve">@selected.Notes</p>}@foreach(var note in notes.Where(n=>n.AssessmentId is null)){<CandidateNoteCard @key="note.Id" Note="note" CanEdit="@(isAdmin||note.AuthorId==currentUser)" OnSaved="ReloadNotes" />}</details>}
}
@if(tab=="Activity"){@if(activity.Count==0){<p class="empty">No recorded candidate activity yet.</p>}@foreach(var item in activity){<div class="timeline-item"><b>@item.Action</b><p class="preserve">@item.Detail</p><small>@(item.ActorName.Length>0?item.ActorName:item.UserId) · @item.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</small></div>}}
</div></div></section></div>}
}
@code{
[SupplyParameterFromQuery(Name="id")] public Guid? CandidateId{get;set;}
[SupplyParameterFromQuery(Name="ref")] public string? PositionReference{get;set;}
[SupplyParameterFromQuery(Name="queue")] public string? Queue{get;set;}
List<Candidate> all=[];List<Assessment> assessments=[];List<Position> positions=[];List<CandidateNote> notes=[];List<AuditEntry> activity=[];List<AssessmentVersion> versions=[];
Candidate? selected;Assessment? view;AssessmentSnapshot? reportSnapshot;Guid? applicationId,reassessPosition,noteApplication;int versionNumber=1,page=1;bool editingProfile,isAdmin,canTalent,canOperate,canExport;string currentUser="";string search="",location="",seniority="",talent="",decision="",tab="Overview",noteText="";
bool IsMaster=>new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').EndsWith("/master-talent",StringComparison.OrdinalIgnoreCase);
bool IsTalent=>IsMaster||new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').EndsWith("/talent",StringComparison.OrdinalIgnoreCase);
static readonly string[] Queues=["Shortlisted","On Hold","In Interview","Action Required","Pending Decision","Hired","Rejected"];
List<Assessment> History=>assessments.Where(x=>x.CandidateId==selected?.Id&&x.State=="Saved").OrderByDescending(x=>x.LastAssessedDate??x.DateScreened??x.CreatedUtc).ToList();
Assessment? Application=>History.FirstOrDefault(x=>x.Id==applicationId);
Assessment? Context(Candidate c)=>assessments.Where(x=>x.CandidateId==c.Id&&x.State=="Saved"&&(string.IsNullOrEmpty(PositionReference)||x.Position?.Reference==PositionReference)).OrderByDescending(x=>x.LastAssessedDate??x.DateScreened??x.CreatedUtc).FirstOrDefault();
List<Candidate> Filtered=>all.Where(c=>(location==""||CandidateCity.Display(c)==location)&&(seniority==""||c.Seniority==seniority)&&(talent==""||c.TalentStatus==talent)&&$"{c.Name} {c.LegacyId} {c.Email} {c.Phone} {c.CurrentRole} {CandidateCity.Display(c)} {c.Skills} {c.Industry}".Contains(search,StringComparison.OrdinalIgnoreCase)&&(IsTalent||((string.IsNullOrEmpty(PositionReference)||Context(c) is not null)&&(string.IsNullOrEmpty(Queue)||Lifecycle.Classify(Context(c),c.TalentStatus)==Queue)&&(decision==""||Context(c)?.Decision==decision)))).ToList();
int Pages=>Math.Max(1,(int)Math.Ceiling(Filtered.Count/25d));int Page=>Math.Min(page,Pages);
protected override void OnInitialized()=>Updates.Changed+=AccessChanged;
void AccessChanged()=>_=InvokeAsync(async()=>{if(IsTalent){await OnParametersSetAsync();StateHasChanged();}else if(selected?.CvProfileStatus=="Pending"){var current=(await Ats.Candidates()).FirstOrDefault(x=>x.Id==selected.Id);if(current is not null){selected=current;selected.City=CandidateCity.Display(selected);CandidateProfile.ReadStructuredHistory(selected);StateHasChanged();}}});
public void Dispose()=>Updates.Changed-=AccessChanged;
protected override Task OnParametersSetAsync()=>Run(async()=>{canTalent=await Access.Can(IsMaster?"Talent.Master":"Talent.View");if(IsTalent&&!canTalent){all=[];assessments=[];positions=[];Close();return;}var user=await Access.Require();currentUser=await Access.UserId();canExport=await Access.Can("Reports.Export");isAdmin=user.IsInRole("Admin");await Load();if(CandidateId is not null&&selected?.Id!=CandidateId&&all.FirstOrDefault(x=>x.Id==CandidateId) is Candidate c)await Open(c);});
async Task Load(){all=IsTalent?await Ats.TalentCandidates(IsMaster):await Ats.Candidates();assessments=await Ats.Assessments();positions=await Ats.Positions();foreach(var a in assessments)a.Position=positions.FirstOrDefault(x=>x.Id==a.PositionId);}
void Clear(){search=location=seniority=talent=decision="";Queue=PositionReference="";page=1;}
Task OpenSafely(Candidate c)=>Run(()=>Open(c));
async Task Open(Candidate c){if(IsTalent)await Access.RequireTalentCandidate(c.Id);else await Access.RequireCandidate(c.Id);selected=JsonSerializer.Deserialize<Candidate>(JsonSerializer.Serialize(c));selected!.City=CandidateCity.Display(selected);CandidateProfile.ReadStructuredHistory(selected);tab="Overview";editingProfile=false;reassessPosition=null;noteText="";applicationId=Context(c)?.Id;noteApplication=applicationId;Error=Notice="";await LoadAssessment();canOperate=isAdmin||(await Ats.Candidates()).Any(x=>x.Id==c.Id);notes=canOperate?await Workspace.Notes(c.Id):[];activity=canOperate?await Workspace.Activity(c.Id):[];}
void BeginProfileEdit(){tab="Overview";editingProfile=true;}
Task CancelProfileEdit()=>Run(async()=>{await RefreshSelected();editingProfile=false;});
static string Shown(string? value)=>string.IsNullOrWhiteSpace(value)?"Not Provided":value;
static string Initials(string name)=>string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n=>char.ToUpperInvariant(n[0])));
void Close(){selected=null;view=null;reportSnapshot=null;applicationId=null;noteApplication=null;reassessPosition=null;versions=[];notes=[];activity=[];editingProfile=false;}
Task OpenReport()=>Run(async()=>{if(Application is null||view is null)throw new InvalidOperationException("Choose An Assessment First.");await Access.RequireApplication(Application.Id);reportSnapshot=JsonSerializer.Deserialize<AssessmentSnapshot>(view.SnapshotJson)??throw new InvalidOperationException("No Saved Assessment Report Is Available.");});
Task ToggleAssessment(Guid id)=>Run(async()=>{reportSnapshot=null;if(applicationId==id){applicationId=null;view=null;versions=[];}else{applicationId=id;await LoadAssessment();}});
void ToggleNotes(Guid id){noteApplication=noteApplication==id?null:id;noteText="";}
void OpenPositionNotes(Guid id){tab="Notes";noteApplication=id;noteText="";}
int NoteCount(Assessment a)=>notes.Count(n=>n.AssessmentId==a.Id)+(a.RecruiterNotes.Length>0?1:0);
string PositionNote(Assessment a)=>notes.FirstOrDefault(n=>n.AssessmentId==a.Id)?.Text??a.RecruiterNotes;
static string ShortNote(string value)=>value.Length>200?value[..200]+"…":value;
Task ReloadNotes()=>Run(async()=>{notes=await Workspace.Notes(selected!.Id);activity=await Workspace.Activity(selected.Id);});
async Task LoadAssessment(){reportSnapshot=null;versions=applicationId is null?[]:await Ats.Versions(applicationId.Value);versionNumber=Application?.VersionNumber??1;SelectVersion();}
void SelectVersion(){reportSnapshot=null;if(Application is null){view=null;return;}view=JsonSerializer.Deserialize<Assessment>(JsonSerializer.Serialize(Application));var v=versions.FirstOrDefault(x=>x.Number==versionNumber);if(v is not null){view!.SnapshotJson=v.SnapshotJson;view.MatchPercent=v.MatchPercent;view.MustHaveFit=v.MustHaveFit;view.CoreRoleFit=v.CoreRoleFit;view.EvidenceStrength=v.EvidenceStrength;view.Decision=v.Decision;view.VersionNumber=v.Number;}}
async Task RefreshSelected(){var id=selected!.Id;await Load();selected=JsonSerializer.Deserialize<Candidate>(JsonSerializer.Serialize(all.Single(x=>x.Id==id)))!;selected.City=CandidateCity.Display(selected);CandidateProfile.ReadStructuredHistory(selected);await LoadAssessment();activity=await Workspace.Activity(id);}
Task SaveProfile()=>Run(async()=>{selected!.Location=selected.City;await Ats.SaveCandidate(selected);await RefreshSelected();editingProfile=false;Notice="Permanent profile saved.";});
Task AddNote(Guid assessmentId)=>Run(async()=>{await Workspace.AddNote(selected!.Id,assessmentId,noteText);noteText="";notes=await Workspace.Notes(selected.Id);activity=await Workspace.Activity(selected.Id);Notice="Position Note Saved.";});
Task Reassess()=>Run(async()=>{var id=await Ai.AssessStored(selected!.Id,reassessPosition!.Value);Nav.NavigateTo($"/assessment/{id}");});
static string Dates(string? start,string? end)=>string.IsNullOrWhiteSpace(start)&&string.IsNullOrWhiteSpace(end)?"Dates not stated":$"{(string.IsNullOrWhiteSpace(start)?"Not stated":start)} – {(string.IsNullOrWhiteSpace(end)?"Not stated":end)}";
}
