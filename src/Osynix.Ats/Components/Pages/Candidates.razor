@page "/candidates"
@attribute [Authorize(Roles="Admin,Recruiter")]
@inherits PageBase
@inject AtsService Ats
<PageTitle>Candidate database · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">YOUR PERMANENT TALENT POOL</div><h1>Candidate database</h1><p class="muted">A complete view of your talent, beyond a single vacancy.</p></div></div><Feedback Error="Error" Notice="Notice" Busy="Busy" />
<div class="kpis"><div class="kpi"><span>Talent pool</span><strong>@all.Count</strong><button class="text-button" @onclick="Clear">Clear filters</button></div><div class="kpi"><span>Seniority</span>@foreach(var g in all.GroupBy(x=>x.Seniority.Length>0?x.Seniority:"Others").OrderByDescending(g=>g.Count()).Take(4)){<button class="distribution" @onclick="()=>seniority=g.Key">@g.Key <b>@g.Count()</b></button>}</div><div class="kpi"><span>Locations</span>@foreach(var g in all.GroupBy(x=>x.Location.Length>0?x.Location:"Others").OrderByDescending(g=>g.Count()).Take(4)){<button class="distribution" @onclick="()=>location=g.Key">@g.Key <b>@g.Count()</b></button>}</div><div class="kpi"><span>Talent status</span>@foreach(var g in all.GroupBy(x=>x.TalentStatus)){<button class="distribution" @onclick="()=>talent=g.Key">@g.Key <b>@g.Count()</b></button>}</div></div>
<section class="panel"><div class="toolbar sticky"><input placeholder="Search name, role, skills or industry…" aria-label="Search candidates" @bind="search" @bind:event="oninput" /><select aria-label="Location" @bind="location"><option value="">All locations</option><option>Others</option>@foreach(var s in all.Select(x=>x.Location).Where(x=>x.Length>0).Distinct().Order()){<option>@s</option>}</select><select aria-label="Seniority" @bind="seniority"><option value="">All seniority</option><option>Others</option>@foreach(var s in all.Select(x=>x.Seniority).Where(x=>x.Length>0).Distinct().Order()){<option>@s</option>}</select><select aria-label="Talent status" @bind="talent"><option value="">All talent status</option>@foreach(var s in all.Select(x=>x.TalentStatus).Distinct().Order()){<option>@s</option>}</select></div>
<div class="pager"><span>@Filtered.Count candidate(s) · Page @Page / @Pages</span><button class="secondary" disabled="@(Page<=1)" @onclick="()=>page=Page-1">Previous</button><button class="secondary" disabled="@(Page>=Pages)" @onclick="()=>page=Page+1">Next</button></div><div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Location</th><th>Industry</th><th>Seniority</th><th>Positions assessed</th><th>Talent status</th><th></th></tr></thead><tbody>@foreach(var c in Filtered.Skip((Page-1)*25).Take(25)){<tr><td><b>@c.Name</b><small>@c.CurrentRole · @c.CurrentCompany</small></td><td>@c.Location</td><td>@c.Industry</td><td>@c.Seniority</td><td>@string.Join(", ",assessments.Where(a=>a.CandidateId==c.Id).Select(a=>a.Position?.Reference+" — "+a.Position?.Title))</td><td>@c.TalentStatus</td><td><button class="secondary" @onclick="()=>Open(c)">View</button></td></tr>}</tbody></table></div>@if(Filtered.Count==0){<p class="empty">No candidates match these filters.</p>}</section>
@if(selected is not null){<div class="overlay"><section class="drawer wide" role="dialog" aria-modal="true" aria-label="Candidate details"><div class="drawer-head"><div><h2>@selected.Name</h2><p class="muted">@selected.CurrentRole · @selected.CurrentCompany</p><p>☎ @selected.Phone &nbsp; ✉ @selected.Email &nbsp; ⌖ @selected.Location</p></div><button class="secondary" @onclick="()=>selected=null">Close</button></div><Feedback Error="Error" Notice="Notice" Busy="Busy" /><nav class="tabs">@foreach(var t in new[]{"Overview","Career","Education","Assessments","Documents","Edit profile"}){<button class="@(tab==t?"active":"")" @onclick="()=>tab=t">@t</button>}</nav>
@if(tab=="Overview"){<h3>Professional summary</h3><p class="preserve">@selected.Summary</p><h3>Key skills</h3><div class="skills">@foreach(var skill in Skills.Take(showAllSkills?int.MaxValue:8)){<span>@skill</span>}@if(Skills.Length>8){<button class="secondary" @onclick="()=>showAllSkills=!showAllSkills">@(showAllSkills?"Show less":"+ More")</button>}</div><div class="form-grid"><div><h3>Primary function</h3><p>@selected.Function</p><h3>Industry</h3><p>@selected.Industry</p></div><div><h3>Systems &amp; tools</h3><p>@selected.Systems</p><h3>Market exposure</h3><p>@selected.Markets</p></div></div>}
@if(tab=="Career"){<h3>Employment history</h3><p class="preserve history">@selected.Employment</p>}
@if(tab=="Education"){<h3>Education</h3><p class="preserve history">@selected.Education</p>}
@if(tab=="Assessments"){<h3>Position-specific assessments</h3>@foreach(var a in assessments.Where(a=>a.CandidateId==selected.Id)){<a class="recent" href="@($"/assessment/{a.Id}")"><span><b>Ref #@a.Position?.Reference — @a.Position?.Title</b><small>@a.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC · @a.MatchPercent% · @a.Stage</small></span><DecisionBadge Value="a.Decision" /></a>}}
@if(tab=="Documents"){<h3>Candidate documents</h3>@if(selected.DocumentId is not null){<a class="button secondary" href="@($"/files/{selected.DocumentId}")">Download latest CV</a>}else{<p>No CV binary has been uploaded to this database.</p>}@if(Uri.TryCreate(selected.LegacyCvLink,UriKind.Absolute,out var link)&&link.Scheme=="https"){<p><a href="@link" target="_blank" rel="noopener noreferrer">Open original CV link</a></p>}}
@if(tab=="Edit profile"){<div class="form-grid"><label>Name<input @bind="selected.Name" /></label><label>Email<input @bind="selected.Email" type="email" /></label><label>Phone<input @bind="selected.Phone" /></label><label>City<input @bind="selected.Location" /></label><label>Current role<input @bind="selected.CurrentRole" /></label><label>Current company<input @bind="selected.CurrentCompany" /></label><label>Seniority<input @bind="selected.Seniority" /></label><label>Talent status<select @bind="selected.TalentStatus"><option>Active</option><option>Placed</option><option>Unavailable</option><option>Archived</option></select></label><label>Industry<input @bind="selected.Industry" /></label><label>Function<input @bind="selected.Function" /></label></div><label>Skills<textarea @bind="selected.Skills"></textarea></label><label>Professional summary<textarea rows="4" @bind="selected.Summary"></textarea></label><label>Employment history<textarea rows="6" @bind="selected.Employment"></textarea></label><label>Education<textarea rows="4" @bind="selected.Education"></textarea></label><label>Recruiter notes<textarea rows="5" @bind="selected.Notes"></textarea></label><button disabled="Busy" @onclick="Save">Save profile</button>}
</section></div>}
@code{
List<Candidate> all=[];List<Assessment> assessments=[];Candidate? selected;string search="",location="",seniority="",talent="",tab="Overview";int page=1;bool showAllSkills;
List<Candidate> Filtered=>all.Where(c=>(location==""||(c.Location.Length==0?"Others":c.Location)==location)&&(seniority==""||(c.Seniority.Length==0?"Others":c.Seniority)==seniority)&&(talent==""||c.TalentStatus==talent)&&$"{c.Name} {c.CurrentRole} {c.Skills} {c.Industry}".Contains(search,StringComparison.OrdinalIgnoreCase)).ToList();
int Pages=>Math.Max(1,(int)Math.Ceiling(Filtered.Count/25d));int Page=>Math.Min(page,Pages);
string[] Skills=>selected?.Skills.Split([',',';','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)??[];
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load(){all=await Ats.Candidates();assessments=(await Ats.Assessments()).Where(a=>a.State=="Saved").ToList();}
void Clear(){search=location=seniority=talent="";page=1;}
void Open(Candidate c){selected=JsonSerializer.Deserialize<Candidate>(JsonSerializer.Serialize(c));tab="Overview";showAllSkills=false;Error=Notice="";}
Task Save()=>Run(async()=>{var id=selected!.Id;await Ats.SaveCandidate(selected);await Load();selected=all.Single(x=>x.Id==id);Notice="Profile saved.";});
}
