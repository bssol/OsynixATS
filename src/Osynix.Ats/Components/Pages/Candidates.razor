@page "/candidates"
@page "/talent"
@attribute [Authorize(Roles="Admin,Recruiter")]
@inherits PageBase
@inject AtsService Ats
@inject WorkspaceService Workspace
@inject Access Access
@inject AiService Ai
@inject NavigationManager Nav
<PageTitle>@(IsTalent?"Talent Pool":"Candidate Database") · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">@(IsTalent?"PERMANENT CANDIDATE REPOSITORY":"CANDIDATES AND APPLICATIONS")</div><h1>@(IsTalent?"Talent Pool":"Candidate Database")</h1><p class="muted">@(IsTalent?"Find and reuse candidate intelligence across vacancies.":"Manage recruitment progress with the person and selected application in context.")</p></div></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<div class="kpis"><button class="kpi" @onclick="Clear"><span>Total people</span><strong>@all.Count</strong></button>@foreach(var queue in Queues){<button class="kpi" @onclick="()=>Queue=queue"><span>@queue</span><strong>@all.Count(c=>Lifecycle.Classify(Context(c),c.TalentStatus)==queue)</strong></button>}</div>
<section class="panel"><div class="toolbar"><input placeholder="Search candidate, role, skills or industry…" aria-label="Search candidates" @bind="search" @bind:event="oninput" /><select aria-label="Location filter" @bind="location"><option value="">All locations</option>@foreach(var s in all.Select(x=>x.Location).Where(x=>x.Length>0).Distinct().Order()){<option>@s</option>}</select><select aria-label="Seniority filter" @bind="seniority"><option value="">All seniority</option>@foreach(var s in all.Select(x=>x.Seniority).Where(x=>x.Length>0).Distinct().Order()){<option>@s</option>}</select><select aria-label="Talent status" @bind="talent"><option value="">All talent status</option>@foreach(var s in Choices.TalentStatuses){<option>@s</option>}</select><button class="secondary" @onclick="Clear">Clear</button></div>
@if(!IsTalent){<div class="toolbar"><select aria-label="Position filter" @bind="PositionReference"><option value="">All positions</option>@foreach(var p in positions){<option value="@p.Reference">#@p.Reference — @p.Title · @p.Client</option>}</select><select aria-label="Lifecycle queue" @bind="Queue"><option value="">All lifecycle queues</option>@foreach(var q in Queues){<option>@q</option>}</select><select aria-label="AI decision" @bind="decision"><option value="">All AI decisions</option>@foreach(var d in Choices.Decisions){<option>@d</option>}</select></div>}
<div class="pager"><span>@Filtered.Count people · Page @Page / @Pages</span><button class="secondary" disabled="@(Page<=1)" @onclick="()=>page=Page-1">Previous</button><button class="secondary" disabled="@(Page>=Pages)" @onclick="()=>page=Page+1">Next</button></div><div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Location / seniority</th><th>Application context</th><th>AI decision</th><th>Lifecycle</th><th>Talent status</th><th></th></tr></thead><tbody>
@foreach(var c in Filtered.Skip((Page-1)*25).Take(25)){var a=Context(c);<tr><td><b>@c.Name</b><small>@c.LegacyId · @c.CurrentRole · @c.CurrentCompany</small></td><td>@c.Location<small>@c.Seniority</small></td><td>@(a?.Position?.Title??"No application")<small>@a?.Position?.Client @if(a is not null){<span>· #@a.Position?.Reference</span>}</small></td><td>@if(a is not null){<DecisionBadge Value="@a.Decision" />}</td><td>@(Lifecycle.Classify(a,c.TalentStatus) is string q&&q.Length>0?q:"Unclassified")<small>@a?.Stage</small></td><td>@c.TalentStatus</td><td><button class="secondary" @onclick="()=>Open(c)">View</button></td></tr>}
</tbody></table></div>@if(Filtered.Count==0){<p class="empty">No candidates match these filters.</p>}</section>
@if(selected is not null){<div class="overlay"><section class="drawer wide candidate-workspace" role="dialog" aria-modal="true" aria-label="Candidate profile"><div class="drawer-head"><div><h2>@selected.Name</h2><p>@selected.CurrentRole · @selected.CurrentCompany</p><p>@selected.LegacyId · @selected.Phone · @selected.Email · @selected.Location</p><div class="profile-header-actions">@if(selected.DocumentId is not null){<a class="button secondary" target="_blank" href="@($"/files/{selected.DocumentId}?view=true")">View CV</a><a class="button secondary" href="@($"/files/{selected.DocumentId}")">Download CV</a>}else if(Uri.TryCreate(selected.LegacyCvLink,UriKind.Absolute,out var cv)&&cv.Scheme=="https"){<a class="button secondary" href="@cv" target="_blank" rel="noopener noreferrer">View original CV</a>}<button class="secondary" @onclick="()=>editingProfile=!editingProfile">@(editingProfile?"Finish editing":"Edit profile")</button></div></div><button class="secondary" @onclick="Close">Close</button></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<nav class="tabs">@foreach(var t in new[]{"Overview","Assessment","Notes","Activity"}){<button class="@(tab==t?"active":"")" @onclick="()=>tab=t">@t</button>}</nav>
@if(tab=="Overview"){
<div class="profile-grid"><div>
@if(editingProfile){<section class="panel"><h3>Edit permanent profile</h3><div class="form-grid"><label>Name<input @bind="selected.Name" /></label><label>Email<input type="email" @bind="selected.Email" /></label><label>Phone<input @bind="selected.Phone" /></label><label>Location<input @bind="selected.Location" /></label><label>Seniority<input @bind="selected.Seniority" /></label><label>Talent status<select @bind="selected.TalentStatus">@foreach(var s in Choices.TalentStatuses){<option>@s</option>}</select></label><label>Primary function<input @bind="selected.Function" /></label><label>Specialization<input @bind="selected.Specialization" /></label><label>Industry<input @bind="selected.Industry" /></label><label>Systems / tools<input @bind="selected.Systems" /></label><label>Market exposure<input @bind="selected.Markets" /></label></div><label>Skills<textarea @bind="selected.Skills"></textarea></label><label>Professional summary<textarea rows="4" @bind="selected.Summary"></textarea></label><label>Career profile summary<textarea rows="4" @bind="selected.CareerSummary"></textarea></label><button disabled="@Busy" @onclick="SaveProfile">Save permanent profile</button></section>}
@if(selected.Summary.Length>0){<section class="panel"><h3>Professional summary</h3><p class="preserve">@selected.Summary</p></section>}
<section class="panel"><div class="form-grid"><div><h3>Current role / company</h3><p>@selected.CurrentRole<br />@selected.CurrentCompany</p><h3>Experience / seniority</h3><p>@(selected.TotalExperience is null?"Unavailable":$"{selected.TotalExperience:0.#} years") · @selected.Seniority</p></div><div><h3>Function / specialization</h3><p>@selected.Function<br />@selected.Specialization</p><h3>Talent status</h3><p>@selected.TalentStatus</p></div></div></section>
@if(selected.CareerSummary.Length>0){<section class="panel"><h3>Career profile summary</h3><p class="preserve">@selected.CareerSummary</p></section>}
@if(selected.EmploymentHistory.Count>0||selected.Employment.Length>0){<details class="panel" open><summary>Employment / career history</summary>@if(selected.EmploymentHistory.Count>0){@foreach(var job in selected.EmploymentHistory.OrderBy(x=>x.SortOrder)){<div class="timeline-item"><b>@job.Designation</b><p>@job.CompanyName</p><small>@Dates(job.StartDate,job.EndDate) · @job.Location</small></div>}}else{<p class="preserve">@selected.Employment</p>}</details>}
@if(selected.EducationHistory.Count>0||selected.Education.Length>0){<details class="panel" open><summary>Education</summary>@if(selected.EducationHistory.Count>0){@foreach(var education in selected.EducationHistory.OrderBy(x=>x.SortOrder)){<div class="timeline-item"><b>@education.Qualification</b><p>@education.Institution</p><small>@Dates(education.StartDate,education.EndDate) · @education.Location</small></div>}}else{<p class="preserve">@selected.Education</p>}</details>}
@if(selected.Skills.Length>0){<section class="panel"><h3>Core skills</h3><div class="skills">@foreach(var skill in selected.Skills.Split([',',';','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)){<span>@skill</span>}</div></section>}
@if($"{selected.Industry}{selected.Systems}{selected.Markets}".Length>0){<section class="panel"><h3>Industries / domains</h3><p>@selected.Industry</p><h3>Systems / tools</h3><p>@selected.Systems</p><h3>Market exposure</h3><p>@selected.Markets</p></section>}
</div><div>
<section class="panel"><h3>Applications</h3><select aria-label="Selected application" @bind="applicationId" @bind:after="LoadAssessment"><option value="">Select application</option>@foreach(var a in History){<option value="@a.Id">#@a.Position?.Reference — @a.Position?.Title · @a.Position?.Client</option>}</select>@if(Application is not null){<p><DecisionBadge Value="@Application.Decision" /></p><p>@Application.Stage · @Application.InterviewStatus · @Application.ClientStatus</p><button class="secondary" @onclick="OpenAssessmentTab">Open assessment</button>}</section>
@if(Application is not null){<section class="panel"><h3>Recruitment progress</h3><LifecycleEditor Application="Application" OnSaved="RefreshSelected" /></section>}
<section class="panel"><h3>Assess against another position</h3><select aria-label="Reassessment position" @bind="reassessPosition"><option value="">Choose an active, approved position</option>@foreach(var p in positions.Where(x=>x.Status=="Active"&&x.CriteriaLocked)){<option value="@p.Id">#@p.Reference — @p.Title · @p.Client</option>}</select><p class="muted small">Uses stored profile/source evidence. This is an intentional AI assessment; missing evidence remains unavailable.</p><button disabled="@(Busy||reassessPosition is null)" @onclick="Reassess">Assess stored profile</button><p><a href="@($"/assessment?candidate={selected.Id}")">Upload an updated CV for explicit profile refresh</a></p></section>
</div></div>}
@if(tab=="Assessment"){
<select aria-label="Assessment application" @bind="applicationId" @bind:after="LoadAssessment"><option value="">Choose application</option>@foreach(var a in History){<option value="@a.Id">#@a.Position?.Reference — @a.Position?.Title · @a.Position?.Client</option>}</select>
@if(Application is not null&&view is not null&&snapshot is not null){<label>Assessment version<select @bind="versionNumber" @bind:after="SelectVersion">@foreach(var v in versions){<option value="@v.Number">Version @v.Number · @v.CreatedUtc.ToString("yyyy-MM-dd") · @v.Decision</option>}</select></label><AssessmentSummary Application="view" Snapshot="snapshot" Framework="@(Application.Position?.Criteria??[])" /><section class="panel"><h3>Current application status</h3><LifecycleEditor Application="Application" OnSaved="RefreshSelected" /></section>}else{<p class="empty">No saved application for this candidate.</p>}}
@if(tab=="Notes"){
<section class="panel"><h3>Add recruiter note</h3><label>Context<select @bind="noteApplication"><option value="">Permanent candidate</option>@foreach(var a in History){<option value="@a.Id">#@a.Position?.Reference — @a.Position?.Title</option>}</select></label><label>Note<textarea rows="4" @bind="noteText"></textarea></label><button disabled="@Busy" @onclick="AddNote">Add note</button></section>
@if(selected.Notes.Length>0){<section class="panel"><h3>Existing candidate notes</h3><p class="preserve">@selected.Notes</p></section>}
@foreach(var a in History.Where(x=>x.RecruiterNotes.Length>0)){<section class="panel"><h3>Application notes · #@a.Position?.Reference</h3><p class="preserve">@a.RecruiterNotes</p></section>}
@foreach(var note in notes){<section class="panel">@if(editingNote==note.Id){<label>Edit note<textarea @bind="editedNote"></textarea></label><button disabled="@Busy" @onclick="SaveNote">Save note</button> <button class="secondary" @onclick="()=>editingNote=null">Cancel</button>}else{<p class="preserve">@note.Text</p>@if(isAdmin||note.AuthorId==currentUser){<button class="secondary" @onclick="()=>BeginNote(note)">Edit</button>}}<small>@note.AuthorName · @note.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC · @(note.AssessmentId is null?"Candidate":"Application #"+History.FirstOrDefault(x=>x.Id==note.AssessmentId)?.Position?.Reference)</small></section>}}
@if(tab=="Activity"){@if(activity.Count==0){<p class="empty">No recorded candidate activity yet.</p>}@foreach(var item in activity){<div class="timeline-item"><b>@item.Action</b><p class="preserve">@item.Detail</p><small>@(item.ActorName.Length>0?item.ActorName:item.UserId) · @item.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</small></div>}}
</section></div>}
@code{
[SupplyParameterFromQuery(Name="id")] public Guid? CandidateId{get;set;}
[SupplyParameterFromQuery(Name="ref")] public string? PositionReference{get;set;}
[SupplyParameterFromQuery(Name="queue")] public string? Queue{get;set;}
List<Candidate> all=[];List<Assessment> assessments=[];List<Position> positions=[];List<CandidateNote> notes=[];List<AuditEntry> activity=[];List<AssessmentVersion> versions=[];
Candidate? selected;Assessment? view;AssessmentSnapshot? snapshot;Guid? applicationId,reassessPosition,noteApplication;int versionNumber=1,page=1;bool editingProfile,isAdmin;Guid? editingNote;string editedNote="",currentUser="";string search="",location="",seniority="",talent="",decision="",tab="Overview",noteText="";
bool IsTalent=>new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').EndsWith("/talent",StringComparison.OrdinalIgnoreCase);
static readonly string[] Queues=["Shortlisted","On Hold","In Interview","Pending Decision","Hired","Rejected"];
List<Assessment> History=>assessments.Where(x=>x.CandidateId==selected?.Id&&x.State=="Saved").OrderByDescending(x=>x.LastAssessedDate??x.DateScreened??x.CreatedUtc).ToList();
Assessment? Application=>History.FirstOrDefault(x=>x.Id==applicationId);
Assessment? Context(Candidate c)=>assessments.Where(x=>x.CandidateId==c.Id&&x.State=="Saved"&&(string.IsNullOrEmpty(PositionReference)||x.Position?.Reference==PositionReference)).OrderByDescending(x=>x.LastAssessedDate??x.DateScreened??x.CreatedUtc).FirstOrDefault();
List<Candidate> Filtered=>all.Where(c=>(location==""||c.Location==location)&&(seniority==""||c.Seniority==seniority)&&(talent==""||c.TalentStatus==talent)&&$"{c.Name} {c.LegacyId} {c.CurrentRole} {c.Skills} {c.Industry}".Contains(search,StringComparison.OrdinalIgnoreCase)&&(IsTalent||((string.IsNullOrEmpty(PositionReference)||Context(c) is not null)&&(string.IsNullOrEmpty(Queue)||Lifecycle.Classify(Context(c),c.TalentStatus)==Queue)&&(decision==""||Context(c)?.Decision==decision)))).ToList();
int Pages=>Math.Max(1,(int)Math.Ceiling(Filtered.Count/25d));int Page=>Math.Min(page,Pages);
protected override Task OnParametersSetAsync()=>Run(async()=>{try{if(IsTalent)await Access.RequirePermission("Talent.View");}catch{all=[];assessments=[];positions=[];Close();throw;}var user=await Access.Require();currentUser=await Access.UserId();isAdmin=user.IsInRole("Admin");await Load();if(CandidateId is not null&&selected?.Id!=CandidateId&&all.FirstOrDefault(x=>x.Id==CandidateId) is Candidate c)await Open(c);});
async Task Load(){all=await Ats.Candidates();assessments=await Ats.Assessments();positions=await Ats.Positions();foreach(var a in assessments)a.Position=positions.FirstOrDefault(x=>x.Id==a.PositionId);}
void Clear(){search=location=seniority=talent=decision="";Queue=PositionReference="";page=1;}
async Task Open(Candidate c){selected=JsonSerializer.Deserialize<Candidate>(JsonSerializer.Serialize(c));tab="Overview";editingProfile=false;reassessPosition=null;noteText="";applicationId=Context(c)?.Id;Error=Notice="";await LoadAssessment();notes=await Workspace.Notes(c.Id);activity=await Workspace.Activity(c.Id);}
void OpenAssessmentTab()=>tab="Assessment";
void Close(){selected=null;editingProfile=false;editingNote=null;}
void BeginNote(CandidateNote note){editingNote=note.Id;editedNote=note.Text;}
Task SaveNote()=>Run(async()=>{await Workspace.EditNote(editingNote!.Value,editedNote);editingNote=null;notes=await Workspace.Notes(selected!.Id);activity=await Workspace.Activity(selected.Id);Notice="Note updated.";});
async Task LoadAssessment(){versions=applicationId is null?[]:await Ats.Versions(applicationId.Value);versionNumber=Application?.VersionNumber??1;SelectVersion();}
void SelectVersion(){if(Application is null){view=null;snapshot=null;return;}view=JsonSerializer.Deserialize<Assessment>(JsonSerializer.Serialize(Application));var v=versions.FirstOrDefault(x=>x.Number==versionNumber);if(v is not null){view!.SnapshotJson=v.SnapshotJson;view.MatchPercent=v.MatchPercent;view.MustHaveFit=v.MustHaveFit;view.CoreRoleFit=v.CoreRoleFit;view.EvidenceStrength=v.EvidenceStrength;view.Decision=v.Decision;view.VersionNumber=v.Number;}snapshot=JsonSerializer.Deserialize<AssessmentSnapshot>(view!.SnapshotJson);}
async Task RefreshSelected(){var id=selected!.Id;await Load();selected=JsonSerializer.Deserialize<Candidate>(JsonSerializer.Serialize(all.Single(x=>x.Id==id)));await LoadAssessment();activity=await Workspace.Activity(id);}
Task SaveProfile()=>Run(async()=>{await Ats.SaveCandidate(selected!);await RefreshSelected();editingProfile=false;Notice="Permanent profile saved.";});
Task AddNote()=>Run(async()=>{await Workspace.AddNote(selected!.Id,noteApplication,noteText);noteText="";notes=await Workspace.Notes(selected.Id);activity=await Workspace.Activity(selected.Id);Notice="Note added.";});
Task Reassess()=>Run(async()=>{var id=await Ai.AssessStored(selected!.Id,reassessPosition!.Value);Nav.NavigateTo($"/assessment/{id}");});
static string Dates(string? start,string? end)=>string.IsNullOrWhiteSpace(start)&&string.IsNullOrWhiteSpace(end)?"Dates not stated":$"{(string.IsNullOrWhiteSpace(start)?"Not stated":start)} – {(string.IsNullOrWhiteSpace(end)?"Not stated":end)}";
}
