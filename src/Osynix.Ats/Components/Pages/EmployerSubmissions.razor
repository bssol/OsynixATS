@page "/employer/submissions"
@attribute [Authorize(Roles="Employer")]
@inherits PageBase
@inject EmployerSubmissionService Reviews
@inject RecruitmentUpdates Updates
@implements IDisposable
<PageTitle>Team Profile Submissions · Osynix ATS</PageTitle>
<div class="page-heading"><div><h1>Team Profile Submissions</h1><p class="muted">Review The Submitted Assessment Report And Return A Decision To Your Recruiter.</p></div></div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<section class="panel table-wrap"><table><thead><tr><th>Candidate</th><th>Position</th><th>Submitted By</th><th>Employer Decision</th><th></th></tr></thead><tbody>@foreach(var row in rows){<tr><td>@row.Candidate</td><td>@row.Position<small>#@row.Reference</small></td><td>@row.Recruiter<small>@row.Submission.SubmittedUtc.ToString("dd MMM yyyy HH:mm") UTC</small></td><td>@row.Submission.Status<small>@row.Submission.Remarks</small></td><td><a class="button secondary" target="_blank" rel="noopener" href="@($"/reports?ids={row.Submission.AssessmentId}&version={row.Submission.AssessmentVersion}")">View Submitted Assessment</a> <button class="secondary" @onclick="()=>Select(row)">Give Feedback</button></td></tr>}</tbody></table>@if(rows.Count==0){<p class="empty">No Profiles Submitted By Your Team Yet.</p>}</section>
@if(selected is not null){<section class="panel"><h2>@selected.Candidate</h2><label>Employer Decision<select @bind="decision">@foreach(var choice in EmployerSubmissionService.Decisions){<option>@choice</option>}</select></label><label>Remarks<textarea maxlength="5000" @bind="remarks"></textarea></label><button disabled="@Busy" @onclick="Save">Save Feedback</button> <button class="secondary" @onclick="()=>selected=null">Cancel</button></section>}
@code{List<EmployerSubmittedProfile> rows=[];EmployerSubmittedProfile? selected;string decision="Shortlisted",remarks="";protected override Task OnInitializedAsync(){Updates.Changed+=Changed;return Run(Load);}async Task Load()=>rows=await Reviews.Inbox();void Select(EmployerSubmittedProfile row){selected=row;decision=EmployerSubmissionService.Decisions.Contains(row.Submission.Status)?row.Submission.Status:"Shortlisted";remarks=row.Submission.Remarks;}Task Save()=>Run(async()=>{await Reviews.Decide(selected!.Submission.Id,selected.Submission.Revision,decision,remarks);selected=null;await Load();Notice="Employer Feedback Saved.";});void Changed()=>_=InvokeAsync(async()=>{await Run(Load);StateHasChanged();});public void Dispose()=>Updates.Changed-=Changed;}
