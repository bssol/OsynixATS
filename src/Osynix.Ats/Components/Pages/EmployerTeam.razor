@page "/employer/team"
@attribute [Authorize(Roles="Employer")]
@inherits PageBase
@inject EmployerTeamService Teams
@inject IJSRuntime JS
@inject FreelancerDirectory Directory
@inject RecruitmentUpdates Updates
@implements IDisposable
@inject NavigationManager Navigation
<PageTitle>My Team · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">YOUR WORKSPACE</div><h1>My Team</h1><p class="muted">Manage Internal Staff, External Recruiters And Position Assignments.</p></div><button @onclick="OpenInvite">+ Invite Team Member</button></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(team is not null){
<section class="panel"><div class="section-heading"><h2>@team.Members.Count(m=>m.Status=="Active"&&!m.External) / @(team.Workspace.FreeRecruiterSeats+team.Workspace.AdditionalRecruiterSeats) Internal Team Seats Used</h2><a class="button secondary" href="/employer/subscriptions">Request Extra Seats</a></div><p class="muted">One Free Internal Resource · External Freelance Recruiters Do Not Use Internal Seats · Pending Invitations Do Not Count.</p></section>
<nav class="recruiter-work-tabs employer-team-tabs" aria-label="Team Views"><button class="@(view=="internal"?"active":"")" @onclick='()=>view="internal"'>Internal Team (@team.Members.Count(m=>!m.External))</button><button class="@(view=="external"?"active":"")" @onclick='()=>view="external"'>External Team (@team.Members.Count(m=>m.External))</button><button class="@(view=="directory"?"active":"")" @onclick='()=>view="directory"'>Find Freelance Recruiters</button></nav>
@if(view=="directory"){
<section class="panel"><h2>Find Your Recruitment Partner</h2><p class="muted">Explore Freelance Recruiter Profiles And Invite Relevant Recruiters. Each Recruiter Must Accept Before You Assign Positions.</p><div class="toolbar"><input aria-label="Search Freelance Recruiters" placeholder="Search name, specialism, industry or location…" @bind="recruiterSearch" @bind:event="oninput" @bind:after="ResetDirectoryPage" /><select aria-label="Recruiter Availability" @bind="availability" @bind:after="ResetDirectoryPage"><option value="">All Availability</option><option>Available</option><option>Limited Availability</option><option>Not Available</option></select></div><div class="recruiter-directory-grid">@foreach(var item in Listings.Skip((directoryPage-1)*9).Take(9)){<article class="panel recruiter-directory-card"><div class="recruiter-card-identity"><span class="recruiter-initial">@Initial(item.Name)</span><div><h3>@item.Name</h3><small>@item.Location</small></div></div><b>@item.Headline</b><span class="badge">@item.Availability</span><p>@item.YearsExperience Years In Recruitment</p><p class="muted">@item.Skills</p><div class="recruiter-profile-actions"><a class="button secondary" href="@($"/employer/recruiters/{item.Id}")">View Profile</a><button disabled="@Busy" @onclick="()=>OpenProjectInvite(item)">Invite To Project</button></div>@if(team.Members.Any(m=>m.Id==item.Id)){<span class="muted small">In Your External Team · Invite To Another Assignment</span>}</article>}</div>@if(Listings.Count==0){<p class="empty">No recruiter profiles match your search. Verified freelancers appear automatically when their subscription includes Marketplace visibility. You can also invite a known freelance recruiter by email.</p>}<div class="pager"><button class="secondary" disabled="@(directoryPage<=1)" @onclick="()=>directoryPage--">Previous</button><span>@Listings.Count Profiles</span><button class="secondary" disabled="@(directoryPage*9>=Listings.Count)" @onclick="()=>directoryPage++">Next</button></div></section>
}else{
<section class="panel table-wrap"><div class="section-heading"><h2>@(view=="external"?"External Freelance Recruiters":"Internal Team")</h2>@if(view=="external"){<button class="secondary" @onclick='()=>view="directory"'>Find Recruiters</button>}</div><p class="muted">@(view=="external"?"External Partners Do Not Consume Internal Seats. Assign One Or More Open Positions Through Manage Access.":"Internal Resources Use Your Team Seat Allowance.")</p><table><thead><tr><th>Team Member</th><th>Status</th><th>Create Clients</th><th>Create Positions</th><th></th></tr></thead><tbody>@foreach(var member in team.Members.Where(m=>m.External==(view=="external"))){<tr><td><b>@member.Name</b><small>@member.Email</small></td><td>@member.Status</td><td>@(member.CanCreateClients?"Allowed":"Not Allowed")</td><td>@(member.CanCreatePositions?"Allowed":"Not Allowed")</td><td><button class="secondary" @onclick="()=>Edit(member)">Manage Access</button></td></tr>}</tbody></table>@if(!team.Members.Any(m=>m.External==(view=="external"))){<p class="empty">No Members In This Team Yet.</p>}</section>}
<section class="panel table-wrap"><h2>Invitations</h2>@if(team.Invitations.Count==0){<p class="muted">No Invitations Yet.</p>}else{<table><thead><tr><th>Invited Team Member</th><th>Status</th><th>Delivery</th><th>Expires (UTC)</th><th></th></tr></thead><tbody>@foreach(var invitation in team.Invitations){<tr><td>@invitation.FullName<small>@invitation.Email</small></td><td>@(invitation.Status=="Pending"&&invitation.ExpiresUtc<DateTime.UtcNow?"Expired":invitation.Status)</td><td>@invitation.Delivery</td><td>@invitation.ExpiresUtc.ToString("dd MMM yyyy HH:mm")</td><td>@if(invitation.Status=="Pending"&&invitation.ExpiresUtc>DateTime.UtcNow){<button class="secondary" @onclick="()=>CopyInvitation(invitation.Id)">Copy Link</button><button class="secondary" disabled="@(Busy||!Teams.CanEmail)" @onclick="()=>EmailInvitation(invitation.Id)">Send Email</button><button class="secondary danger" @onclick="()=>Cancel(invitation.Id)">Cancel</button>}</td></tr>}</tbody></table>}</section>
@if(inviteLink.Length>0&&!inviteOpen){<section class="panel"><label>Private Invitation Link<input id="hiring-review-link" readonly value="@inviteLink" /></label><button class="secondary" @onclick="()=>Copy(inviteLink)">Copy Link</button></section>}
@if(!Teams.CanEmail){<p class="muted">Invitation Email Requires A Public HTTPS ATS Address And Working Email Settings. Copy Links For Local Testing.</p>}
@if(inviteOpen){<div class="overlay"><section class="drawer" role="dialog" aria-modal="true" aria-label="Invite Team Member"><div class="drawer-head"><h2>Invite Team Member</h2><button class="secondary" @onclick="()=>inviteOpen=false">Close</button></div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" /><label>Full Name<input maxlength="100" @bind="inviteName" /></label><label>Email Address<input type="email" maxlength="320" @bind="inviteEmail" /></label><p class="muted">Existing Freelance Recruiter Accounts Join Your External Team Without Using An Internal Seat. New Internal Members Must Verify Their Email And Accept. Creation Permissions Start Disabled.</p><button disabled="@Busy" @onclick="Invite">Create Invitation</button>@if(inviteLink.Length>0){<label>Private Invitation Link<input id="hiring-review-link" readonly value="@inviteLink" /></label><button class="secondary" @onclick="()=>Copy(inviteLink)">Copy Link</button>}</section></div>}
@if(selected is not null){<div class="overlay"><section class="drawer" role="dialog" aria-modal="true" aria-label="Team Member Access"><div class="drawer-head"><div><h2>Team Member Access</h2><p>@selected.Name · @selected.Email</p></div><button class="secondary" @onclick="()=>selected=null">Close</button></div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" /><h3>Assigned Positions</h3><p class="muted">Choose One Or More Open Positions. Multiple Recruiters Can Work On The Same Position.</p>@foreach(var p in assignable){<label class="check"><input type="checkbox" checked="@assigned.Contains(p.Id)" @onchange="e=>SetAssignment(p.Id,(bool)e.Value!)" /> #@p.Reference · @p.Title <small>@p.Client</small></label>}@if(assignable.Count==0){<p class="muted">No Open Positions Available.</p>}<button class="secondary" disabled="@(Busy||selected.Status!="Active")" @onclick="SaveAssignments">Save Position Assignments</button><h3>Creation Permissions</h3><label class="check"><input type="checkbox" @bind="canClients" /> Create And Edit Clients</label><label class="check"><input type="checkbox" @bind="canPositions" /> Create Positions</label><h3>Reports &amp; Talent Pool</h3><label class="check"><input type="checkbox" @bind="canExport" /> Export Reports</label><label class="check"><input type="checkbox" @bind="canTalent" /> Use Workspace Talent Pool</label><label class="check"><input type="checkbox" @bind="canMaster" /> Use Osynix Master Talent Pool When Subscribed</label><p class="muted">Master Pool Subscription: @(team.Workspace.MasterTalentPoolEnabled?"Enabled":"Not Enabled"). Permissions Cannot Override Subscription Capacity.</p><label>Workspace Membership Status<select @bind="memberStatus"><option>Active</option><option>Inactive</option></select></label><p class="muted">Deactivation Ends Workspace Access And Preserves History. Only Internal Members Use Seats.</p><button disabled="@Busy" @onclick="SaveMember">Save Access</button></section></div>}
}
@if(projectRecruiter is not null){<ProjectInviteDialog FreelancerId="projectRecruiter.Id" FreelancerName="projectRecruiter.Name" Close="()=>projectRecruiter=null" Sent="ProjectSent" />}
@code{
[SupplyParameterFromQuery(Name="view")] public string? RequestedView {get;set;}
RecruiterListing? projectRecruiter;
void OpenProjectInvite(RecruiterListing person){projectRecruiter=person;}
void ProjectSent(Guid id){projectRecruiter=null;Navigation.NavigateTo($"/messages?conversation={id}");}
string view="internal",recruiterSearch="",availability="";int directoryPage=1;List<RecruiterListing> directory=[];List<Position> assignable=[];HashSet<Guid> assigned=[];
List<RecruiterListing> Listings=>directory.Where(p=>(availability.Length==0||p.Availability==availability)&&$"{p.Name} {p.Headline} {p.Skills} {p.Location}".Contains(recruiterSearch,StringComparison.OrdinalIgnoreCase)).ToList();
void ResetDirectoryPage()=>directoryPage=1;
string Initial(string name)=>name.Length>0?name[..1].ToUpperInvariant():"R";
void SetAssignment(Guid id,bool value){if(value)assigned.Add(id);else assigned.Remove(id);}
Task SaveAssignments()=>Run(async()=>{await Teams.AssignPositions(selected!.Id,assigned);Notice="Position Assignments Updated.";});
Task InviteRecruiter(string id)=>Run(async()=>{var result=await Directory.Invite(id);inviteLink=result.Link;await Load();Notice=result.Message;});
EmployerTeamOverview? team;TeamMember? selected;bool inviteOpen,canClients,canPositions,canExport,canTalent,canMaster;string inviteName="",inviteEmail="",inviteLink="",memberStatus="Active";
protected override Task OnInitializedAsync(){Updates.Changed+=DirectoryChanged;if(RequestedView is "directory" or "external")view=RequestedView;return Run(Load);}
void DirectoryChanged()=>_=InvokeAsync(async()=>{if(!Busy)await Run(async()=>directory=await Directory.Search());StateHasChanged();});
public void Dispose()=>Updates.Changed-=DirectoryChanged;
async Task Load(){team=await Teams.Team();directory=await Directory.Search();assignable=await Teams.AssignablePositions();}
void OpenInvite(){inviteName=inviteEmail=inviteLink="";Error=Notice="";inviteOpen=true;}
async Task Edit(TeamMember member){assigned=(await Teams.Assignments(member.Id)).ToHashSet();selected=member;memberStatus=member.Status;canClients=member.CanCreateClients;canPositions=member.CanCreatePositions;canExport=member.CanExportReports;canTalent=member.CanViewTalentPool;canMaster=member.CanUseMasterPool;Error=Notice="";}
Task Invite()=>Run(async()=>{var result=await Teams.Invite(inviteName,inviteEmail);inviteLink=result.Link;await Load();Notice=result.Message;});
Task SaveMember()=>Run(async()=>{await Teams.Update(selected! with{Status=memberStatus,CanCreateClients=canClients,CanCreatePositions=canPositions,CanExportReports=canExport,CanViewTalentPool=canTalent,CanUseMasterPool=canMaster});selected=null;await Load();Notice="Team Access Updated.";});
Task Cancel(Guid id)=>Run(async()=>{await Teams.Cancel(id);await Load();Notice="Invitation Cancelled.";});
Task EmailInvitation(Guid id)=>Run(async()=>{await Teams.EmailInvitation(id);await Load();Notice="Invitation Email Sent.";});
async Task Copy(string link){var copied=await JS.InvokeAsync<bool>("osynixCopyReviewLink",link);Notice=copied?"Invitation Link Copied.":"Select The Invitation Link And Press Ctrl+C.";}
Task CopyInvitation(Guid id)=>Run(async()=>{inviteLink=await Teams.InvitationLink(id);await Copy(inviteLink);});
}
