@page "/employer/team"
@attribute [Authorize(Roles="Employer")]
@inherits PageBase
@inject EmployerTeamService Teams
@inject IJSRuntime JS
<PageTitle>My Team · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">YOUR WORKSPACE</div><h1>My Team</h1><p class="muted">Invite Recruiters And Manage Their Access.</p></div><button @onclick="OpenInvite">+ Invite Recruiter</button></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(team is not null){
<section class="panel"><div class="section-heading"><h2>@team.Members.Count(m=>m.Status=="Active") / @(team.Workspace.FreeRecruiterSeats+team.Workspace.AdditionalRecruiterSeats) Recruiter Seats Used</h2><a class="button secondary" href="/employer/subscriptions">Request Extra Seats</a></div><p class="muted">Employer Excluded · Pending Invitations Do Not Count · Deactivation Releases A Seat.</p></section>
<section class="panel table-wrap"><h2>Team Members</h2>@if(team.Members.Count==0){<p class="muted">No Recruiters Have Joined Your Team Yet.</p>}else{<table><thead><tr><th>Recruiter</th><th>Status</th><th>Create Clients</th><th>Create Positions</th><th></th></tr></thead><tbody>@foreach(var member in team.Members){<tr><td><b>@member.Name</b><small>@member.Email</small></td><td>@member.Status</td><td>@(member.CanCreateClients?"Allowed":"Not Allowed")</td><td>@(member.CanCreatePositions?"Allowed":"Not Allowed")</td><td><button class="secondary" @onclick="()=>Edit(member)">Manage Access</button></td></tr>}</tbody></table>}</section>
<section class="panel table-wrap"><h2>Invitations</h2>@if(team.Invitations.Count==0){<p class="muted">No Invitations Yet.</p>}else{<table><thead><tr><th>Invited Recruiter</th><th>Status</th><th>Delivery</th><th>Expires (UTC)</th><th></th></tr></thead><tbody>@foreach(var invitation in team.Invitations){<tr><td>@invitation.FullName<small>@invitation.Email</small></td><td>@(invitation.Status=="Pending"&&invitation.ExpiresUtc<DateTime.UtcNow?"Expired":invitation.Status)</td><td>@invitation.Delivery</td><td>@invitation.ExpiresUtc.ToString("dd MMM yyyy HH:mm")</td><td>@if(invitation.Status=="Pending"&&invitation.ExpiresUtc>DateTime.UtcNow){<button class="secondary" @onclick="()=>CopyInvitation(invitation.Id)">Copy Link</button><button class="secondary" disabled="@(Busy||!Teams.CanEmail)" @onclick="()=>EmailInvitation(invitation.Id)">Send Email</button><button class="secondary danger" @onclick="()=>Cancel(invitation.Id)">Cancel</button>}</td></tr>}</tbody></table>}</section>
@if(inviteLink.Length>0&&!inviteOpen){<section class="panel"><label>Private Invitation Link<input id="hiring-review-link" readonly value="@inviteLink" /></label><button class="secondary" @onclick="()=>Copy(inviteLink)">Copy Link</button></section>}
@if(!Teams.CanEmail){<p class="muted">Invitation Email Requires A Public HTTPS ATS Address And Working Email Settings. Copy Links For Local Testing.</p>}
@if(inviteOpen){<div class="overlay"><section class="drawer" role="dialog" aria-modal="true" aria-label="Invite Recruiter"><div class="drawer-head"><h2>Invite Recruiter</h2><button class="secondary" @onclick="()=>inviteOpen=false">Close</button></div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" /><label>Full Name<input maxlength="100" @bind="inviteName" /></label><label>Email Address<input type="email" maxlength="320" @bind="inviteEmail" /></label><p class="muted">The Recruiter Must Verify This Email And Accept The Invitation. Creation Permissions Start Disabled.</p><button disabled="@Busy" @onclick="Invite">Create Invitation</button>@if(inviteLink.Length>0){<label>Private Invitation Link<input id="hiring-review-link" readonly value="@inviteLink" /></label><button class="secondary" @onclick="()=>Copy(inviteLink)">Copy Link</button>}</section></div>}
@if(selected is not null){<div class="overlay"><section class="drawer" role="dialog" aria-modal="true" aria-label="Recruiter Access"><div class="drawer-head"><div><h2>Recruiter Access</h2><p>@selected.Name · @selected.Email</p></div><button class="secondary" @onclick="()=>selected=null">Close</button></div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" /><h3>Creation Permissions</h3><label class="check"><input type="checkbox" @bind="canClients" /> Create And Edit Clients</label><label class="check"><input type="checkbox" @bind="canPositions" /> Create Positions</label><h3>Reports &amp; Talent Pool</h3><label class="check"><input type="checkbox" @bind="canExport" /> Export Reports</label><label class="check"><input type="checkbox" @bind="canTalent" /> Use Team Talent Pool When Subscribed</label><p class="muted">Talent Pool Subscription: @(team.Workspace.TeamTalentPoolEnabled?"Enabled":"Not Enabled"). Permissions Cannot Override Subscription Capacity.</p><label>Account Status<select @bind="memberStatus"><option>Active</option><option>Inactive</option></select></label><p class="muted">Deactivation Ends Access And Frees A Seat. Existing Recruitment History Is Preserved. Reactivation Requires An Available Seat.</p><button disabled="@Busy" @onclick="SaveMember">Save Access</button></section></div>}
}
@code{
EmployerTeamOverview? team;TeamMember? selected;bool inviteOpen,canClients,canPositions,canExport,canTalent;string inviteName="",inviteEmail="",inviteLink="",memberStatus="Active";
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load()=>team=await Teams.Team();
void OpenInvite(){inviteName=inviteEmail=inviteLink="";Error=Notice="";inviteOpen=true;}
void Edit(TeamMember member){selected=member;memberStatus=member.Status;canClients=member.CanCreateClients;canPositions=member.CanCreatePositions;canExport=member.CanExportReports;canTalent=member.CanViewTalentPool;Error=Notice="";}
Task Invite()=>Run(async()=>{var result=await Teams.Invite(inviteName,inviteEmail);inviteLink=result.Link;await Load();Notice=result.Message;});
Task SaveMember()=>Run(async()=>{await Teams.Update(selected! with{Status=memberStatus,CanCreateClients=canClients,CanCreatePositions=canPositions,CanExportReports=canExport,CanViewTalentPool=canTalent});selected=null;await Load();Notice="Team Access Updated.";});
Task Cancel(Guid id)=>Run(async()=>{await Teams.Cancel(id);await Load();Notice="Invitation Cancelled.";});
Task EmailInvitation(Guid id)=>Run(async()=>{await Teams.EmailInvitation(id);await Load();Notice="Invitation Email Sent.";});
async Task Copy(string link){var copied=await JS.InvokeAsync<bool>("osynixCopyReviewLink",link);Notice=copied?"Invitation Link Copied.":"Select The Invitation Link And Press Ctrl+C.";}
Task CopyInvitation(Guid id)=>Run(async()=>{inviteLink=await Teams.InvitationLink(id);await Copy(inviteLink);});
}
