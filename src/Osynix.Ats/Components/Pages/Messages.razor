@page "/messages"
@attribute [Authorize(Roles="Recruiter,Employer,Candidate,Admin,SubAdmin")]
@inherits PageBase
@implements IDisposable
@inject MarketplaceMessages InboxService
@inject SupportInboxService SupportInbox
@inject RecruitmentUpdates Updates
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
<PageTitle>Messages · Osynix ATS</PageTitle>
<div class="messages-page">
<div class="page-heading"><div><div class="eyebrow">YOUR CONVERSATIONS</div><h1>Messages</h1><p class="muted">Project conversations and direct help from Osynix Support.</p></div><div class="messages-page-actions">@if(adminSide){<button disabled="@Busy" @onclick="OpenNewChat">New conversation</button>}else{<button disabled="@Busy" @onclick="StartSupport">Chat with Support</button>}<button class="secondary" disabled="@Busy" @onclick="()=>Run(Load)">Refresh</button></div></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<section class="messages-shell">
    <aside class="conversation-list"><div class="inbox-heading"><h2>Inbox</h2><span class="inbox-total">@entries.Sum(c=>c.Unread) Unread</span></div>
        <input class="conversation-search" aria-label="Search Conversations" placeholder="Search conversations…" @bind="search" @bind:event="oninput" />
        <div class="inbox-filters"><button class="secondary @(!unreadOnly?"selected":"")" @onclick="()=>unreadOnly=false">All</button><button class="secondary @(unreadOnly?"selected":"")" @onclick="()=>unreadOnly=true">Unread</button></div>
        @foreach(var c in Filtered){<button class="conversation-item secondary @(Selected(c)?"current":"") @(c.Unread>0?"unread":"")" @onclick="()=>Select(c)"><span class="conversation-avatar">@Initial(c.Name)</span><span class="conversation-copy"><span class="conversation-meta"><b>@c.Name</b><time>@c.UpdatedUtc.ToString("dd MMM")</time></span><span class="conversation-context">@c.Context</span><span class="conversation-preview">@c.Preview</span>@if(c.Status.Length>0){<span class="conversation-invite-status">@c.Status</span>}</span>@if(c.Unread>0){<span class="unread-badge">@c.Unread</span>}</button>}
        @if(!Filtered.Any()){<p class="empty small">@(unreadOnly?"You are all caught up.":adminSide?"No support conversations yet.":"No conversations yet. Use Chat with Support for help, or review project messages here.")</p>}
    </aside>
    <section class="message-thread">
    @if(supportDetail is not null){
        <header class="message-thread-heading"><span class="conversation-avatar">@Initial(supportDetail.UserName)</span><div><h2>@(adminSide?supportDetail.UserName:"Osynix Support")</h2><p>@supportDetail.Subject</p></div>@if(supportDetail.RequestId is Guid requestId){<span class="support-request-ref">Request · @requestId.ToString("N")[..8]</span>}</header>
        <div class="support-session-toolbar"><div><b>@supportDetail.IssueType</b><small>Started @supportDetail.StartedUtc.ToString("dd MMM yyyy · HH:mm") UTC · @supportDetail.Status @if(supportDetail.ClosedUtc is DateTime ended){<span> · Ended @ended.ToString("dd MMM yyyy · HH:mm") UTC</span>}</small></div><a class="button secondary" href="@($"/messages/support-transcript/{supportDetail.Id}")" download>Download transcript</a><button class="secondary delete-chat-button" disabled="@Busy" @onclick="()=>deleteChatOpen=true">Delete chat</button>@if(supportDetail.Status=="Open"){<button class="secondary" disabled="@Busy" @onclick="EndSession">End session</button>}</div>
        @if(!adminSide){<details class="support-session-history"><summary>@(adminSide?"Session history & archive":"Active support sessions") · @supportConversations.Count(c=>c.UserId==supportDetail.UserId)</summary><div class="support-session-list">@foreach(var session in supportConversations.Where(c=>c.UserId==supportDetail.UserId).OrderByDescending(c=>c.StartedUtc)){<button class="secondary @(session.Id==supportDetail.Id?"selected":"")" @onclick="()=>ViewSession(session.Id)"><b>@session.IssueType · @session.StartedUtc.ToString("dd MMM yyyy · HH:mm") UTC</b><span>@session.Context</span><small>@(session.Status=="Closed"?"Archived":"Active") @if(session.Unread>0){<span> · @session.Unread unread</span>}</small></button>}</div></details>}
        <div class="message-history" aria-live="polite">@if(supportDetail.Messages.Count==0){<p class="empty">Write a message to start this conversation with Osynix Support.</p>}@foreach(var message in supportDetail.Messages){<article class="message-row @(message.SenderName=="You"?"mine":"")"><div class="message-author">@message.SenderName <time>@message.SentUtc.ToString("dd MMM · HH:mm") UTC</time></div>@if(message.Body.Length>0){<div class="message-bubble preserve">@message.Body</div>}@if(message.AttachmentName.Length>0){<a class="message-file" href="@($"/messages/support-attachments/{message.Id}")" target="_blank" rel="noopener"><NavIcon Name="import" />@message.AttachmentName</a>}</article>}</div>
        @if(supportDetail.Status=="Open"){<div class="message-compose"><label class="sr-only" for="support-message-body">Message to Support</label><textarea id="support-message-body" maxlength="10000" rows="2" @bind="body" @bind:event="oninput" placeholder="Write to Osynix Support…"></textarea><div class="composer-actions"><label class="attach-file"><NavIcon Name="import" /><span>Attach</span><InputFile OnChange="Attach" accept=".pdf,.docx,.png,.jpg,.jpeg" disabled="@Busy" /></label><small class="muted">Screenshots or documents · Up to 5 MB</small><button disabled="@(Busy||(string.IsNullOrWhiteSpace(body)&&fileContent is null))" @onclick="SendSupport">Send Message</button></div>@if(fileContent is not null){<div class="pending-attachment">@fileName <button class="secondary" aria-label="Remove Attachment" @onclick="RemoveAttachment">×</button></div>}</div>}else{<div class="support-session-ended"><b>This session has ended.</b><p>You can download the transcript above. Admin retains the session for support records.</p><button class="secondary" @onclick="StartSupport">Start a new session</button></div>}
    }
    else if(detail is null){<div class="inbox-empty"><NavIcon Name="message" /><h2>Your Conversations</h2><p>Select a conversation or start a support chat.</p></div>}
    else{
        <header class="message-thread-heading"><span class="conversation-avatar">@Initial(detail.Name)</span><div><h2>@detail.Name</h2><p>@(detail.Employer?"Freelance Recruiter":detail.Agency?"Agency":"Employer") · @detail.Company</p></div><button class="secondary delete-chat-button" disabled="@Busy" @onclick="()=>deleteChatOpen=true">Delete chat</button>@if(detail.Employer){<a class="button secondary" href="@($"/employer/recruiters/{detail.FreelancerId}")">View Profile</a><button class="secondary" disabled="@Busy" @onclick="()=>inviteOpen=true">Invite To Project</button>}</header>
        <div class="message-history" aria-live="polite">
            @if(detail.Messages.Count==0){<p class="empty">Start the conversation with a message or project invitation.</p>}
            @foreach(var message in detail.Messages){
                <article class="message-row @(message.SenderName=="You"?"mine":"")"><div class="message-author">@message.SenderName <time>@message.SentUtc.ToString("dd MMM · HH:mm") UTC</time></div>
                    @if(message.Body.Length>0){<div class="message-bubble preserve">@message.Body</div>}
                    @if(message.AttachmentName.Length>0){<a class="message-file" href="@($"/messages/attachments/{message.Id}")" target="_blank" rel="noopener"><NavIcon Name="import" />@message.AttachmentName</a>}
                    @if(message.Invitation is ProjectInvitation invitation){
                    <section class="project-invitation"><div class="project-invite-title"><div><span class="eyebrow">PROJECT INVITATION</span><h3>@invitation.Title</h3></div><span class="invitation-status @invitation.Status.ToLowerInvariant()">@(invitation.Status=="Pending"?detail.Employer?"Awaiting Response":"Awaiting Your Response":invitation.Status)</span></div>
                        <p class="preserve">@invitation.Summary</p><dl><dt>Expected Start</dt><dd>@invitation.Start</dd><dt>Duration</dt><dd>@invitation.Duration</dd></dl>
                        @if(invitation.PositionId.HasValue){<p class="small muted">Acceptance adds this position to your Employer workspace assignments.</p>}else{<p class="small muted">Project discussion. Position access is managed separately by the Employer.</p>}
                        @if(invitation.Status=="Pending"){
                            <div class="invitation-actions">@if(!detail.Employer){<button disabled="@Busy" @onclick='()=>Respond(invitation,"Accepted")'>Accept Invitation</button><button class="secondary" disabled="@Busy" @onclick="()=>Question(invitation)">Ask A Question</button><button class="secondary" disabled="@Busy" @onclick='()=>Respond(invitation,"Declined")'>Decline</button>}else{<button class="secondary" disabled="@Busy" @onclick='()=>Respond(invitation,"Cancelled")'>Cancel Invitation</button>}</div>
                        }else if(invitation.Status=="Accepted"){
                            <p class="invitation-success">✓ Invitation accepted.</p>@if(!detail.Employer){<WorkOpenButton WorkspaceId="detail.WorkspaceId" Mode="@(detail.Agency?"Agency":"Employer")" Path="/workspace-dashboard" Text="Open Employer Workspace" />}else{<a href="/employer/team?view=external">Manage External Team Access</a>}
                        }
                        @if(detail.Employer){<small class="invitation-email">Email: @invitation.EmailDelivery</small>}
                    </section>}
                </article>
            }
        </div>
        <div class="message-compose"><label class="sr-only" for="message-body">Message</label><textarea id="message-body" maxlength="10000" rows="2" @bind="body" @bind:event="oninput" placeholder="Write a message…"></textarea><div class="composer-actions"><label class="attach-file"><NavIcon Name="import" /><span>Attach</span><InputFile OnChange="Attach" accept=".pdf,.docx,.png,.jpg,.jpeg" disabled="@Busy" /></label><small class="muted">PDF, DOCX or image · Up to 5 MB</small><button disabled="@(Busy||(string.IsNullOrWhiteSpace(body)&&fileContent is null))" @onclick="Send">Send Message</button></div>@if(fileContent is not null){<div class="pending-attachment">@fileName <button class="secondary" aria-label="Remove Attachment" @onclick="RemoveAttachment">×</button></div>}</div>
    }
    </section>
</section>
@if(inviteOpen&&detail?.Employer==true){<ProjectInviteDialog FreelancerId="detail.FreelancerId" FreelancerName="detail.Name" Close="()=>inviteOpen=false" Sent="Invited" />}
@if(question is not null){<div class="overlay"><section class="drawer" role="dialog" aria-modal="true" aria-label="Ask About Assignment"><div class="drawer-head"><h2>Ask A Question</h2><button class="secondary" @onclick="()=>question=null">Close</button></div><Feedback Error="@Error" Busy="Busy" /><p>@question.Title</p><label>Your Question<textarea rows="5" maxlength="10000" @bind="questionText"></textarea></label><button disabled="@(Busy||string.IsNullOrWhiteSpace(questionText))" @onclick="SendQuestion">Send Question</button></section></div>}
@if(newChatOpen){<div class="overlay" @onclick="()=>newChatOpen=false"><section class="drawer" role="dialog" aria-modal="true" aria-label="Start Support Conversation" @onclick:stopPropagation="true"><div class="drawer-head"><h2>Start a conversation</h2><button class="secondary" @onclick="()=>newChatOpen=false">Close</button></div><Feedback Error="@Error" Busy="Busy" />@if(adminSide){<label>User Account<select @bind="targetUser"><option value="">Choose a user</option>@foreach(var user in supportUsers){<option value="@user.Id">@user.Name · @user.AccountType · @user.Email</option>}</select></label>}<label>Type of issue<select @bind="issueType">@foreach(var issue in SupportInboxService.IssueTypes){<option>@issue</option>}</select></label><label>Subject<input maxlength="200" @bind="newSubject" /></label><button disabled="@(Busy||(adminSide&&string.IsNullOrWhiteSpace(targetUser))||string.IsNullOrWhiteSpace(newSubject))" @onclick="CreateSupportChat">Start conversation</button></section></div>}
</div>
@if(deleteChatOpen){<div class="overlay" @onclick="()=>deleteChatOpen=false"><section class="drawer" role="dialog" aria-modal="true" aria-labelledby="delete-chat-title" @onclick:stopPropagation="true"><div class="drawer-head"><h2 id="delete-chat-title">Delete chat?</h2><button class="secondary" disabled="@Busy" @onclick="()=>deleteChatOpen=false">Cancel</button></div><Feedback Error="@Error" Busy="Busy" /><p>This removes the chat and its sessions from your inbox. Support records stay available in the account's Chat History, and the other participant keeps their copy. A new message brings the chat back.</p><button class="delete-chat-button" disabled="@Busy" @onclick="DeleteChat">Delete from my inbox</button></section></div>}
@code{
    [SupplyParameterFromQuery(Name="conversation")] public Guid? ConversationId{get;set;}
    [SupplyParameterFromQuery(Name="support")] public Guid? SupportId{get;set;}
    [SupplyParameterFromQuery(Name="chat")] public string? Chat{get;set;}
    [SupplyParameterFromQuery(Name="request")] public Guid? RequestId{get;set;}
    record InboxRow(Guid Id,string Kind,string Name,string Context,string Preview,DateTime UpdatedUtc,int Unread,string Status,string GroupUserId="");
    List<ConversationSummary> conversations=[];List<SupportConversationSummary> supportConversations=[];List<InboxRow> entries=[];List<SupportUserOption> supportUsers=[];
    ConversationDetail? detail;SupportConversationDetail? supportDetail;ProjectInvitation? question;
    string search="",body="",fileName="",questionText="",targetUser="",newSubject="",issueType="General Support";byte[]? fileContent;bool unreadOnly,inviteOpen,disposed,adminSide,newChatOpen,deleteChatOpen;
    IEnumerable<InboxRow> Filtered=>entries.Where(c=>(!unreadOnly||c.Unread>0)&&$"{c.Name} {c.Context} {c.Preview} {c.Status}".Contains(search,StringComparison.OrdinalIgnoreCase));
    protected override void OnInitialized()=>Updates.Changed+=Changed;
    protected override Task OnParametersSetAsync()=>Run(InitializePage);
    async Task InitializePage(){detail=null;supportDetail=null;deleteChatOpen=false;body="";RemoveAttachment();if(Chat=="support"){Chat=null;var principal=(await Auth.GetAuthenticationStateAsync()).User;adminSide=principal.IsInRole("Admin")||principal.IsInRole("SubAdmin");if(adminSide){supportUsers=await SupportInbox.Users();newChatOpen=true;Navigation.NavigateTo("/messages",replace:true);}else{newSubject="";issueType="General Support";newChatOpen=true;Navigation.NavigateTo("/messages",replace:true);}return;}if(RequestId is Guid requestId){var id=await SupportInbox.FindRequestConversation(requestId);if(id is Guid conversationId){Navigation.NavigateTo($"/messages?support={conversationId}",replace:true);return;}}await Load();}
    async Task Load(){
        var principal=(await Auth.GetAuthenticationStateAsync()).User;adminSide=principal.IsInRole("Admin")||principal.IsInRole("SubAdmin");
        supportConversations=await SupportInbox.Inbox();
        conversations=(principal.IsInRole("Employer")||principal.IsInRole("Recruiter"))?await InboxService.Inbox():[];
        BuildEntries();
        if(SupportId is Guid supportId){supportDetail=await SupportInbox.Open(supportId);detail=null;}
        else{var id=ConversationId??(detail is not null?detail.Id:entries.FirstOrDefault(e=>e.Kind=="Project")?.Id);if(id is Guid selected){detail=await InboxService.Open(selected);supportDetail=null;}}
        supportConversations=await SupportInbox.Inbox();
        if(principal.IsInRole("Employer")||principal.IsInRole("Recruiter"))conversations=await InboxService.Inbox();
        BuildEntries();
    }
    bool Selected(InboxRow row)=>row.Kind=="Support"?supportDetail?.UserId==row.GroupUserId:detail?.Id==row.Id;
    void Select(InboxRow row)=>Navigation.NavigateTo(row.Kind=="Support"?$"/messages?support={row.Id}":$"/messages?conversation={row.Id}");
    void ViewSession(Guid id)=>Navigation.NavigateTo($"/messages?support={id}");
    Task Send()=>Run(async()=>{await InboxService.Send(detail!.Id,body,fileName,fileContent);body="";RemoveAttachment();await Load();});
    Task SendSupport()=>Run(async()=>{await SupportInbox.Send(supportDetail!.Id,body,fileName,fileContent);body="";RemoveAttachment();await Load();});
    Task StartSupport()=>adminSide?OpenNewChat():Run(()=>{newSubject="";issueType="General Support";newChatOpen=true;return Task.CompletedTask;});
    Task OpenNewChat()=>Run(async()=>{supportUsers=await SupportInbox.Users();targetUser="";newSubject="";newChatOpen=true;});
    Task CreateSupportChat()=>Run(async()=>{var id=adminSide?await SupportInbox.StartForUser(targetUser,newSubject,issueType):await SupportInbox.StartGeneral(issueType,newSubject);newChatOpen=false;Navigation.NavigateTo($"/messages?support={id}");});
    Task DeleteChat()=>Run(async()=>{
        if(supportDetail is not null)await SupportInbox.DeleteChat(supportDetail.Id);
        else if(detail is not null)await InboxService.DeleteChat(detail.Id);
        else return;
        deleteChatOpen=false;detail=null;supportDetail=null;body="";RemoveAttachment();
        SupportId=null;ConversationId=null;RequestId=null;
        await Load();Notice="Chat deleted from your inbox.";
        Navigation.NavigateTo("/messages",replace:true);
    });
    Task EndSession()=>Run(async()=>{if(supportDetail is null)return;await SupportInbox.EndSession(supportDetail.Id);await Load();Notice="Session ended. Download your transcript now if you would like a copy. The session remains in Admin records.";});
    void BuildEntries()=>entries=SupportInboxService.GroupInbox(supportConversations).Select(c=>new InboxRow(c.LatestSessionId,"Support",c.Name,$"{c.Sessions} support session(s)",c.Preview,c.UpdatedUtc,c.Unread,"",c.UserId)).Concat(conversations.Select(c=>new InboxRow(c.Id,"Project",c.Name,c.Context,c.Preview,c.UpdatedUtc,c.Unread,c.InvitationStatus.Length>0?"Invitation: "+c.InvitationStatus:""))).OrderByDescending(c=>c.UpdatedUtc).ToList();
    Task Attach(InputFileChangeEventArgs e)=>Run(async()=>{RemoveAttachment();var file=e.File;if(file.Size>5*1024*1024)throw new InvalidOperationException("Attachments must be 5 MB or smaller.");using var stream=new MemoryStream();await file.OpenReadStream(5*1024*1024).CopyToAsync(stream);fileContent=stream.ToArray();fileName=file.Name;});
    void RemoveAttachment(){fileContent=null;fileName="";}
    static string Initial(string name)=>string.IsNullOrWhiteSpace(name)?"?":name[..1].ToUpperInvariant();
    Task Respond(ProjectInvitation invitation,string response)=>Run(async()=>{await InboxService.Respond(invitation.Id,invitation.Revision,response);await Load();});
    void Question(ProjectInvitation invitation){question=invitation;questionText="";Error="";}
    Task SendQuestion()=>Run(async()=>{await InboxService.Respond(question!.Id,question.Revision,"Question",questionText);question=null;questionText="";await Load();});
    Task Invited(Guid id)=>Run(async()=>{inviteOpen=false;await Load();});
    void Changed(){if(!disposed)_=InvokeAsync(async()=>{if(!Busy&&!inviteOpen)await Run(Load);StateHasChanged();});}
    public void Dispose(){disposed=true;Updates.Changed-=Changed;}
}
