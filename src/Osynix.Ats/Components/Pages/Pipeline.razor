@page "/pipeline"
@attribute [Authorize(Roles="Admin,Recruiter")]
@inherits PageBase
@inject AtsService Ats
<PageTitle>Recruitment pipeline · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">CANDIDATE PROGRESS</div><h1>Recruitment pipeline</h1></div></div><Feedback Error="Error" Notice="Notice" Busy="Busy" />
<div class="toolbar"><input aria-label="Search pipeline" placeholder="Search candidate or position…" @bind="search" @bind:event="oninput" /><select aria-label="Recruitment stage" @bind="Stage"><option value="">All stages</option>@foreach(var s in Choices.Stages){<option>@s</option>}</select></div><section class="panel table-wrap"><table><thead><tr><th>Candidate / position</th><th>Decision</th><th>Stage</th><th>Interview</th><th>Client</th><th></th></tr></thead><tbody>@foreach(var a in records.Where(a=>(string.IsNullOrEmpty(Stage)||a.Stage==Stage)&&$"{a.CandidateName} {a.Position?.Title}".Contains(search,StringComparison.OrdinalIgnoreCase))){<tr><td><a href="@($"/assessment/{a.Id}")"><b>@a.CandidateName</b></a><small>@a.Position?.Title · #@a.Position?.Reference</small></td><td><DecisionBadge Value="a.Decision" /></td><td>@a.Stage</td><td>@a.InterviewStatus</td><td>@a.ClientStatus</td><td><button class="secondary" @onclick="()=>Open(a)">Update</button></td></tr>}</tbody></table></section>
@if(edit is not null){<div class="overlay"><section class="drawer" role="dialog" aria-modal="true" aria-label="Update recruitment lifecycle"><div class="drawer-head"><h2>@edit.CandidateName</h2><button class="secondary" @onclick="()=>edit=null">Close</button></div><Feedback Error="Error" Busy="Busy" /><label>Recruitment stage<select @bind="edit.Stage">@foreach(var s in Choices.Stages){<option>@s</option>}</select></label><label>Interview status<select @bind="edit.InterviewStatus">@foreach(var s in Choices.Interviews){<option>@s</option>}</select></label><label>Client status<select @bind="edit.ClientStatus">@foreach(var s in Choices.ClientStatuses){<option>@s</option>}</select></label><label>Current compensation (salary + benefits)<input @bind="edit.CurrentCompensation" /></label><label>Expected salary<input @bind="edit.ExpectedSalary" /></label><label>Interview availability<input @bind="edit.Availability" /></label><label>Notice period<input @bind="edit.NoticePeriod" /></label><label>Recruiter notes<textarea rows="6" @bind="edit.RecruiterNotes"></textarea></label><button disabled="Busy" @onclick="Save">Save progress</button></section></div>}
@code{
[SupplyParameterFromQuery(Name="stage")]public string? Stage{get;set;}List<Assessment> records=[];Assessment? edit;string search="";
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load()=>records=(await Ats.Assessments()).Where(x=>x.State=="Saved").ToList();
void Open(Assessment a){edit=JsonSerializer.Deserialize<Assessment>(JsonSerializer.Serialize(a));Error="";}
Task Save()=>Run(async()=>{await Ats.SaveLifecycle(edit!);edit=null;await Load();Notice="Recruitment progress saved.";});
}
