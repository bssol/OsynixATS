@page "/pipeline"
@attribute [Authorize(Roles="Admin,Recruiter")]
@inherits PageBase
@inject AtsService Ats
<PageTitle>Recruitment pipeline · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">APPLICATION PROGRESS</div><h1>Recruitment pipeline</h1></div></div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<div class="toolbar"><input aria-label="Search pipeline" placeholder="Search candidate or position…" @bind="search" @bind:event="oninput" /><select aria-label="Recruitment stage" @bind="Stage"><option value="">All stages</option>@foreach(var s in Choices.Stages){<option>@s</option>}</select><select aria-label="Lifecycle queue" @bind="Queue"><option value="">All lifecycle queues</option>@foreach(var q in new[]{"Shortlisted","On Hold","In Interview","Pending Decision","Hired","Rejected"}){<option>@q</option>}</select><label class="check"><input type="checkbox" @bind="ActiveOnly" /> Active positions only</label></div><section class="panel table-wrap"><table><thead><tr><th>Candidate / position</th><th>AI decision</th><th>Lifecycle queue</th><th>Stage</th><th>Interview</th><th>Client</th><th></th></tr></thead><tbody>
@foreach(var a in records.Where(a=>(!ActiveOnly||a.Position?.Status=="Active")&&(string.IsNullOrEmpty(Queue)||Lifecycle.Classify(a)==Queue)&&(string.IsNullOrEmpty(Stage)||a.Stage==Stage)&&$"{a.CandidateName} {a.Position?.Title}".Contains(search,StringComparison.OrdinalIgnoreCase))){<tr><td><a href="@($"/candidates?id={a.CandidateId}")"><b>@a.CandidateName</b></a><small>@a.Position?.Title · #@a.Position?.Reference</small></td><td><DecisionBadge Value="@a.Decision" /></td><td>@Lifecycle.Classify(a)</td><td>@a.Stage</td><td>@a.InterviewStatus</td><td>@a.ClientStatus</td><td><button class="secondary" @onclick="()=>edit=a">Update</button></td></tr>}
</tbody></table></section>
@if(edit is not null){<div class="overlay"><section class="drawer" role="dialog" aria-modal="true" aria-label="Recruitment progress"><div class="drawer-head"><h2>@edit.CandidateName</h2><button class="secondary" @onclick="()=>edit=null">Close</button></div><LifecycleEditor Application="edit" OnSaved="Saved" /></section></div>}
@code{
[SupplyParameterFromQuery(Name="active")]public bool ActiveOnly{get;set;}[SupplyParameterFromQuery(Name="queue")]public string? Queue{get;set;}[SupplyParameterFromQuery(Name="stage")]public string? Stage{get;set;}List<Assessment> records=[];Assessment? edit;string search="";
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load()=>records=(await Ats.Assessments()).Where(x=>x.State=="Saved").ToList();
async Task Saved(){await Load();edit=null;Notice="Recruitment progress saved.";}
}
