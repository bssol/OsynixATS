@page "/positions"
@attribute [Authorize(Roles="Admin,Recruiter")]
@inherits PageBase
@inject AtsService Ats
@inject AiService Ai
@inject WorkspaceService Workspace
@inject IDocumentStore Documents
<PageTitle>Manage positions · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">VACANCIES AND APPROVED CRITERIA</div><h1>Manage positions</h1></div><button @onclick="New">+ Create position</button></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<div class="kpis">@foreach(var s in Choices.PositionStatuses){<button class="kpi" @onclick="()=>status=s"><span>@s</span><strong>@positions.Count(x=>x.Status==s)</strong></button>}</div>
<div class="toolbar"><input aria-label="Search positions" placeholder="Search title, client or reference…" @bind="search" @bind:event="oninput" /><select aria-label="Position status" @bind="status"><option value="">All statuses</option>@foreach(var s in Choices.PositionStatuses){<option>@s</option>}</select><select aria-label="Client filter" @bind="clientFilter"><option value="">All clients</option>@foreach(var c in clients){<option>@c.Name</option>}</select><select aria-label="Priority filter" @bind="priority"><option value="">All priorities</option>@foreach(var p in Choices.Priorities){<option>@p</option>}</select><select aria-label="Sort positions" @bind="sort"><option value="ref">Reference</option><option value="priority">Priority</option><option value="newest">Newest</option></select><button class="secondary" @onclick="Clear">Clear</button></div>
<section class="panel"><div class="pager"><span>@Filtered.Count positions · Page @Page / @Pages</span><button class="secondary" disabled="@(Page<=1)" @onclick="()=>page=Page-1">Previous</button><button class="secondary" disabled="@(Page>=Pages)" @onclick="()=>page=Page+1">Next</button></div><div class="table-wrap"><table><thead><tr><th>Ref / position</th><th>Status / priority</th><th>Target</th><th>Screened</th><th>Shortlist</th><th>Interviews / offers</th><th>Hired</th><th>Avg match</th><th></th></tr></thead><tbody>
@foreach(var p in Filtered.Skip((Page-1)*25).Take(25)){var records=For(p.Id);<tr><td><b>#@p.Reference — @p.Title</b><small>@p.Client · @p.Location</small></td><td>@p.Status<small>@p.Priority</small></td><td>@p.HiringTarget</td><td>@records.Count</td><td>@records.Count(x=>x.Decision.Contains("Shortlist"))</td><td>@records.Count(x=>x.Stage=="Client Interview") / @records.Count(x=>x.Stage=="Offer Sent")</td><td>@records.Count(x=>x.Stage=="Hired")</td><td>@(records.Any(x=>x.MatchPercent.HasValue)?$"{records.Where(x=>x.MatchPercent.HasValue).Average(x=>x.MatchPercent):0.#}%":"—")</td><td><button class="secondary" @onclick="()=>Edit(p)">Open</button></td></tr>}
</tbody></table></div>@if(Filtered.Count==0){<p class="empty">No positions match these filters.</p>}</section>
@if(edit is not null){<div class="overlay"><section class="drawer wide" role="dialog" aria-modal="true" aria-label="Position editor"><div class="drawer-head"><div><h2>@(positions.Any(p=>p.Id==edit.Id)?edit.Title:"New position")</h2><p class="muted">@(edit.CriteriaLocked?"Approved criteria are locked":"Review and approve the criteria before assessment")</p></div><button class="secondary" @onclick="()=>edit=null">Close</button></div><Feedback Error="@Error" Busy="Busy" />
<div class="form-grid"><label>Reference<input @bind="edit.Reference" placeholder="Automatically assigned on create" readonly="@positions.Any(x=>x.Id==edit.Id)" /></label><label>Client<select @bind="edit.ClientId"><option value="">Choose client or enter a new name below</option>@foreach(var c in clients){<option value="@c.Id">@c.Name</option>}</select></label><label>New client name<input @bind="edit.Client" disabled="@(edit.ClientId is not null)" /></label><label>Position title<input @bind="edit.Title" /></label><label>Location<input @bind="edit.Location" /></label><label>Priority<select @bind="edit.Priority">@foreach(var p in Choices.Priorities){<option>@p</option>}</select></label><label>Hiring target<input type="number" min="1" @bind="edit.HiringTarget" /></label><label>Hiring manager / contact<input @bind="edit.HiringContact" /></label><label>Assigned recruiter<input @bind="edit.AssignedRecruiter" /></label><label>Salary range<input @bind="edit.SalaryRange" /></label><label>Employment type<input @bind="edit.EmploymentType" /></label></div>
<label>Original JD file<InputFile OnChange="ChooseJd" accept=".pdf,.docx,.txt" disabled="@edit.CriteriaLocked" />@if(jdName.Length>0){<small>@jdName</small>}</label>
@if(edit.JdDocumentId is not null){<p><a href="@($"/files/{edit.JdDocumentId}?view=true")" target="_blank">View original JD</a></p>}else if(Uri.TryCreate(edit.LegacyJdLink,UriKind.Absolute,out var jdLink)&&jdLink.Scheme=="https"){<p><a href="@jdLink" target="_blank" rel="noopener noreferrer">View original JD link</a></p>}
<label>Job description text<textarea rows="6" @bind="edit.JobDescription" disabled="@edit.CriteriaLocked"></textarea></label><label>Client-specific assessment requirements<textarea rows="3" @bind="edit.ClientNotes" disabled="@edit.CriteriaLocked"></textarea></label><label>Position summary<textarea rows="3" @bind="edit.PositionSummary" disabled="@edit.CriteriaLocked"></textarea></label><label>Internal position notes<textarea rows="3" @bind="edit.InternalNotes"></textarea></label>
<div class="section-heading"><h2>Assessment criteria <small>@edit.Criteria.Sum(c=>c.Weight)% / 100%</small></h2><div><button class="secondary" disabled="@(Busy||edit.CriteriaLocked)" @onclick="Analyze">Analyze JD</button> <button class="secondary" disabled="@edit.CriteriaLocked" @onclick="()=>edit.Criteria.Add(new Criterion())">+ Criterion</button></div></div>
@foreach(var c in edit.Criteria){<details class="criterion-editor" open @key="c.Id"><summary>@(c.Name.Length>0?c.Name:"New criterion") · @c.Weight%</summary><div class="form-grid"><label>Criterion<input @bind="c.Name" disabled="@edit.CriteriaLocked" /></label><label>Weight %<input type="number" min="1" max="100" @bind="c.Weight" disabled="@edit.CriteriaLocked" /></label></div><label class="check"><input type="checkbox" @bind="c.Knockout" disabled="@edit.CriteriaLocked" /> Must-have</label><label>Evidence expected<textarea @bind="c.EvidenceExpected" disabled="@edit.CriteriaLocked"></textarea></label><label>Scoring guidance<textarea @bind="c.ScoringGuidance" disabled="@edit.CriteriaLocked"></textarea></label><label>Interpretation notes<textarea @bind="c.Notes" disabled="@edit.CriteriaLocked"></textarea></label>@if(c.Rationale.Length>0){<p class="muted">AI draft rationale: @c.Rationale</p>}<button class="secondary danger" disabled="@edit.CriteriaLocked" @onclick="()=>edit.Criteria.Remove(c)">Remove</button></details>}
<label class="check"><input type="checkbox" @bind="lockOnSave" disabled="@edit.CriteriaLocked" /> I reviewed the criteria — lock on save</label>
<div class="form-grid"><label>Status<select @bind="edit.Status">@foreach(var s in Choices.PositionStatuses){<option>@s</option>}</select></label><label>Closure reason<input @bind="edit.ClosureReason" /></label></div>
@if(edit.Status=="Filled"){<div class="form-grid"><label>Filled source<select @bind="edit.FilledSource"><option value="">Select filled source</option>@foreach(var s in Choices.FilledSources){<option>@s</option>}</select></label><label>Hired candidate<select @bind="edit.HiredCandidateId"><option value="">No ATS candidate</option>@foreach(var a in For(edit.Id)){<option value="@a.CandidateId">@a.CandidateName</option>}</select></label></div>}
@if(edit.ClosedDate is not null){<p class="muted">First closed: @edit.ClosedDate?.ToString("yyyy-MM-dd") · @edit.ClosedBy · @edit.ClosureStatus</p>}
<h3>Applications</h3>@foreach(var a in For(edit.Id)){<p><a href="@($"/candidates?id={a.CandidateId}")">@a.CandidateName</a> · @a.Stage · @a.Decision</p>}
<button disabled="@Busy" @onclick="Save">Save position</button></section></div>}
@code{
[SupplyParameterFromQuery(Name="status")]public string? QueryStatus{get;set;}
[SupplyParameterFromQuery(Name="priority")]public string? QueryPriority{get;set;}
[SupplyParameterFromQuery(Name="unscreened")]public bool Unscreened{get;set;}
[SupplyParameterFromQuery(Name="ref")]public string? Reference{get;set;}
List<Position> positions=[];List<Client> clients=[];List<Assessment> assessments=[];Position? edit;string search="",status="",priority="",clientFilter="",sort="ref",jdName="",openedRef="";byte[]? jdBytes;bool lockOnSave;int page=1;
List<Assessment> For(Guid id)=>assessments.Where(x=>x.PositionId==id&&x.State=="Saved").ToList();
List<Position> Filtered {get{var q=positions.Where(p=>(status==""||p.Status==status)&&(!Unscreened||For(p.Id).Count==0)&&(priority==""||p.Priority==priority)&&(clientFilter==""||p.Client==clientFilter)&&$"{p.Title} {p.Client} {p.Reference}".Contains(search,StringComparison.OrdinalIgnoreCase));return (sort switch {"priority"=>q.OrderBy(p=>Array.IndexOf(Choices.Priorities,p.Priority)).ThenBy(p=>p.Reference),"newest"=>q.OrderByDescending(p=>p.OpenDate??p.CreatedUtc),_=>q.OrderBy(p=>p.Reference)}).ToList();}}
int Pages=>Math.Max(1,(int)Math.Ceiling(Filtered.Count/25d));int Page=>Math.Min(page,Pages);
protected override Task OnInitializedAsync()=>Run(Load);
protected override void OnParametersSet(){status=QueryStatus??status;priority=QueryPriority??priority;if(Reference is not null&&Reference!=openedRef&&positions.FirstOrDefault(x=>x.Reference==Reference) is Position p){Edit(p);openedRef=Reference;}}
async Task Load(){positions=await Ats.Positions();assessments=await Ats.Assessments();clients=await Workspace.Clients();if(Reference is not null&&openedRef!=Reference&&positions.FirstOrDefault(x=>x.Reference==Reference) is Position p){Edit(p);openedRef=Reference;}}
void Clear(){search=status=priority=clientFilter="";Unscreened=false;page=1;}
void New(){edit=new Position();lockOnSave=false;jdBytes=null;jdName="";Error="";}
void Edit(Position p){edit=JsonSerializer.Deserialize<Position>(JsonSerializer.Serialize(p));lockOnSave=p.CriteriaLocked;jdBytes=null;jdName="";Error="";}
Task ChooseJd(InputFileChangeEventArgs e)=>Run(async()=>{using var stream=new MemoryStream();await e.File.OpenReadStream(AiService.MaxFileSize).CopyToAsync(stream);jdBytes=stream.ToArray();jdName=e.File.Name;});
Task Analyze()=>Run(async()=>{var draft=await Ai.AnalyzeJdDraft(edit!.JobDescription,edit.ClientNotes,jdName,jdBytes);edit.Criteria=draft.Criteria;edit.PositionSummary=draft.Summary;if(edit.Title.Length==0)edit.Title=draft.Title;Notice="Draft analysis ready for your review. The position has not been created.";});
Task Save()=>Run(async()=>{edit!.CriteriaLocked=lockOnSave;if(edit.ClientId is not null)edit.Client=clients.Single(x=>x.Id==edit.ClientId).Name;if(jdBytes is not null){var doc=await Documents.Store(jdName,jdBytes);edit.JdDocumentId=doc.Id;edit.JdHash=doc.ContentHash;}await Ats.SavePosition(edit);edit=null;await Load();Notice="Position saved.";});
}
