@page "/settings"
@attribute [Authorize(Roles="Admin,SubAdmin,Employer,Recruiter,Candidate")]
@inherits PageBase
@inject AtsService Ats
@inject AdminService Admin
@inject Access Access
@inject AuthenticationStateProvider Auth
<SettingsNavigation Selected="@(platform?"administration":"profile")">
@if(loaded){
@if(!platform){<Profile Embedded="true" />}else{
<PageTitle>Settings · Osynix ATS</PageTitle>

<div class="page-heading">
    <div><div class="eyebrow">ADMINISTRATION</div><h1>Settings</h1><p class="muted">@(platform?"Manage Admin Panel users, delegated permissions, and assessment decision rules.":"Choose A Settings Section To Manage Your Account.")</p></div>
</div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />

<details class="panel admin-tray">
    <summary><span><b>Email Templates</b><small>Reusable Messages, Formatting Tools And Custom Templates</small></span><span class="tray-chevron">⌄</span></summary>
    <div class="admin-tray-content"><p class="muted">Manage Templates For Communicating With Candidates, Clients, Hiring Managers And Your Team.</p><a class="button" href="/settings/email-templates">Open Email Templates</a></div>
</details>

@if(canManageSubscriptions){<AdminPaymentSettings />}

@if(canViewSubAdmins || canManageSubAdmins){
<details class="panel admin-tray" open>
    <summary><span><b>Sub-Admins</b><small>Admin Panel users only · @subAdmins.Count accounts</small></span><span class="tray-chevron">⌄</span></summary>
    <div class="admin-tray-content">
        <p class="muted">This list contains only people who can sign in to the Admin Panel. It does not include Employers, Freelance Recruiters, Agency users, or Employer team members.</p>
        @if(canManageSubAdmins){
            <details class="admin-add-tray">
                <summary><b>Add a Sub-Admin</b><span class="muted">Set an initial password and choose the Admin responsibilities.</span></summary>
                <div class="form-grid">
                    <label>Full Name<input @bind="newFullName" maxlength="160" /></label>
                    <label>Email Address<input type="email" @bind="newEmail" maxlength="320" /></label>
                    <label>Initial Password<input type="password" autocomplete="new-password" @bind="newPassword" /><small class="muted">At least 6 characters with upper/lowercase, a number and a symbol.</small></label>
                    <label>Access Level<select @bind="newLevel" @bind:after="SetNewLevel"><option>Full Control</option><option>Partial Control</option><option>View Only</option></select></label>
                </div>
                <p class="muted small">Passwords are not emailed. Share the initial password through your secure channel. The Sub-Admin can change it from My Profile.</p>
                <AdminPermissionChecks Permissions="Admin.PermissionOptions" Selected="newPermissions" Level="newLevel" OnToggle="ToggleNewPermission" />
                <button disabled="@Busy" @onclick="CreateSubAdmin">Create Sub-Admin</button>
            </details>
        }
        @if(canManageSubAdmins&&!canViewSubAdmins){<p class="notice">To manage Sub-Admins, also assign View Sub-Admin Directory.</p>}
        @if(canViewSubAdmins&&subAdmins.Count==0){<p class="empty">No Sub-Admin accounts have been created.</p>}
        else if(canViewSubAdmins){
            <div class="table-wrap"><table><thead><tr><th>Sub-Admin</th><th>Status</th><th>Access Level</th><th>Responsibilities</th><th></th></tr></thead><tbody>
            @foreach(var person in subAdmins){
                <tr @key="person.Id"><td><b>@person.FullName</b><small>@person.Email</small></td><td><span class="badge @(person.Status=="Active"?"green":"gray")">@person.Status</span></td><td>@person.AccessLevel</td><td>@PermissionSummary(person.Permissions)</td><td>@if(canManageSubAdmins){<button class="secondary" @onclick="()=>Edit(person)">Manage</button>}</td></tr>
            }
            </tbody></table></div>
        }
        @if(selected is not null && canManageSubAdmins){
            <details class="admin-edit-tray" open>
                <summary><b>Edit @selected.FullName</b><span class="tray-chevron">⌄</span></summary>
                <div class="form-grid">
                    <label>Full Name<input @bind="editFullName" maxlength="160" /></label>
                    <label>Email Address<input readonly value="@selected.Email" /></label>
                    <label>Account Status<select @bind="editStatus"><option>Active</option><option>Inactive</option></select></label>
                    <label>Access Level<select @bind="editLevel" @bind:after="SetEditLevel"><option>Full Control</option><option>Partial Control</option><option>View Only</option></select></label>
                </div>
                <AdminPermissionChecks Permissions="Admin.PermissionOptions" Selected="editPermissions" Level="editLevel" OnToggle="ToggleEditPermission" />
                <div class="toolbar"><button disabled="@Busy" @onclick="SaveSubAdmin">Save Admin Access</button><button class="secondary" @onclick="()=>selected=null">Close</button></div>
            </details>
        }
    </div>
</details>
}

@if(canViewSubAdmins || canManageSubAdmins){
<details class="panel admin-tray">
    <summary><span><b>Admin Responsibilities &amp; Access</b><small>What each permission allows a Sub-Admin to do</small></span><span class="tray-chevron">⌄</span></summary>
    <div class="admin-tray-content">
        <div class="admin-responsibility-grid">
            @foreach(var item in Admin.PermissionOptions){<article><b>@PermissionTitle(item.Key)</b><p>@PermissionDescription(item.Key)</p></article>}
        </div>
        <p class="muted small">Workspace changes, request reviews, and subscription grants require the permissions listed above. Granting a request requires both Review Requests and Manage Entitlements. Invoice handling is not available yet.</p>
    </div>
</details>
}

@if(canViewRules){
<details class="panel admin-tray">
    <summary><span><b>Assessment Decision Rules</b><small>The existing platform rules that control AI recommendations</small></span><span class="tray-chevron">⌄</span></summary>
    <div class="admin-tray-content">
        <p class="muted">Must-have Fail always produces Reject. Insufficient Evidence stays separate. Otherwise, the highest matching threshold below determines the recommendation. Existing assessments keep the decision recorded when they were run.</p>
        <div class="table-wrap"><table><thead><tr><th>Must-have fit</th><th>Minimum match %</th><th>Decision</th>@if(canManageRules){<th></th>}</tr></thead><tbody>
        @foreach(var rule in rules){<tr><td><select @bind="rule.MustHaveFit" disabled="@(!canManageRules)"><option>Pass</option><option>Partial</option></select></td><td><input type="number" min="0" max="100" @bind="rule.MinimumMatch" disabled="@(!canManageRules)" /></td><td><select @bind="rule.Decision" disabled="@(!canManageRules)">@foreach(var choice in Choices.Decisions){<option>@choice</option>}</select></td>@if(canManageRules){<td><button class="secondary" @onclick="()=>rules.Remove(rule)">Remove</button></td>}</tr>}
        </tbody></table></div>
        @if(canManageRules){<div class="toolbar"><button class="secondary" @onclick="()=>rules.Add(new DecisionRule())">+ Add Rule</button><button disabled="@Busy" @onclick="SaveRules">Save Decision Rules</button></div>}
    </div>
</details>
}

@if(canViewAudit){
<details class="panel admin-tray">
    <summary><span><b>Audit Events</b><small>Changes made by Admin and Sub-Admin accounts · @audit.Count recent events</small></span><span class="tray-chevron">⌄</span></summary>
    <div class="admin-tray-content">
        @if(audit.Count==0){<p class="empty">No Admin Panel activity has been recorded yet.</p>}
        else{<div class="table-wrap"><table><thead><tr><th>Time (UTC)</th><th>Admin</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach(var item in audit){<tr><td>@item.CreatedUtc.ToString("dd MMM yyyy HH:mm")</td><td>@(item.ActorName.Length>0?item.ActorName:item.UserId)</td><td>@ReadableAction(item.Action)</td><td>@ReadableAuditDetail(item)</td></tr>}</tbody></table></div>}
    </div>
</details>
}

@if(platform && !canViewSubAdmins && !canManageSubAdmins && !canViewRules && !canViewAudit && !canWorkspaces){
    <section class="panel"><h2>No Admin access assigned</h2><p class="muted">Ask the root Admin to grant access to an Admin Panel section.</p></section>
}


}
}
</SettingsNavigation>
@code {
    List<DecisionRule> rules=[];
    List<SubAdminAccount> subAdmins=[];
    List<AuditEntry> audit=[];
    SubAdminAccount? selected;
    string newFullName="",newEmail="",newPassword="",newLevel="View Only";
    string editFullName="",editStatus="Active",editLevel="View Only";
    HashSet<string> newPermissions=new(StringComparer.Ordinal),editPermissions=new(StringComparer.Ordinal);
    bool loaded,platform,canViewSubAdmins,canManageSubAdmins,canViewRules,canManageRules,canViewAudit,canWorkspaces,canManageSubscriptions;

    protected override Task OnInitializedAsync()=>Run(Load);

    async Task Load(){
        var principal=(await Auth.GetAuthenticationStateAsync()).User;platform=principal.IsInRole("Admin")||principal.IsInRole("SubAdmin");if(!platform){loaded=true;return;}
        canViewSubAdmins=await Access.CanAdmin("admin.subadmins.view");
        canManageSubAdmins=await Access.CanAdmin("admin.subadmins.manage");
        canWorkspaces=await Access.CanAdmin("admin.workspaces.view");
        canManageSubscriptions=await Access.CanAdmin("admin.subscriptions.manage");
        canViewRules=await Access.CanAdmin("admin.rules.view");
        canManageRules=await Access.CanAdmin("admin.rules.manage");
        canViewAudit=await Access.CanAdmin("admin.audit.view");
        if(canViewSubAdmins)subAdmins=await Admin.SubAdmins();
        if(canViewRules)rules=await Ats.Rules();
        if(canViewAudit)audit=await Admin.AdminAudit();
        SetNewLevel();loaded=true;
    }

    void SetNewLevel()=>SetPreset(newLevel,newPermissions);
    void SetEditLevel()=>SetPreset(editLevel,editPermissions);
    static void SetPreset(string level,HashSet<string> selected){
        selected.Clear();
        if(level=="Full Control"){selected.UnionWith(Access.AdminPermissionKeys);return;}
        var views=new[]{"admin.subadmins.view","admin.workspaces.view","admin.rules.view","admin.audit.view"};
        selected.UnionWith(views);
    }
    void ToggleNewPermission(string key){Toggle(newPermissions,key,ref newLevel);}
    void ToggleEditPermission(string key){Toggle(editPermissions,key,ref editLevel);}
    static void Toggle(HashSet<string> set,string key,ref string level){if(!set.Add(key))set.Remove(key);if(level!="View Only"&&set.Count!=Access.AdminPermissionKeys.Length)level="Partial Control";if(set.Count==Access.AdminPermissionKeys.Length)level="Full Control";}
    void Edit(SubAdminAccount item){selected=item;editFullName=item.FullName;editStatus=item.Status;editLevel=item.AccessLevel;editPermissions=new(item.Permissions,StringComparer.Ordinal);}
    Task CreateSubAdmin()=>Run(async()=>{await Admin.CreateSubAdmin(newEmail,newFullName,newPassword,newLevel,newPermissions.ToList());newEmail=newFullName=newPassword="";await Load();Notice="Sub-Admin created with the selected Admin Panel access.";});
    Task SaveSubAdmin()=>Run(async()=>{await Admin.UpdateSubAdmin(selected! with{FullName=editFullName,Status=editStatus,AccessLevel=editLevel,Permissions=editPermissions.ToList()});selected=null;await Load();Notice="Sub-Admin access updated.";});
    Task SaveRules()=>Run(async()=>{await Ats.SaveRules(rules);await Load();Notice="Assessment decision rules saved.";});
    static string PermissionSummary(List<string> permissions)=>permissions.Count==0?"No sections assigned":string.Join(", ",permissions.Select(PermissionTitle));
    static string PermissionTitle(string key)=>key switch{
        "admin.workspaces.view"=>"Workspace Directory","admin.accounts.manage"=>"Manage Workspace Accounts","admin.requests.review"=>"Review Requests","admin.subscriptions.manage"=>"Manage Entitlements","admin.subadmins.view"=>"Sub-Admin Directory","admin.subadmins.manage"=>"Manage Sub-Admins","admin.rules.view"=>"Decision Rules","admin.rules.manage"=>"Change Decision Rules","admin.audit.view"=>"Audit Events",_=>key};
    static string PermissionDescription(string key)=>key switch{
        "admin.workspaces.view"=>"View Employer, Agency and Freelance Recruiter workspaces.","admin.accounts.manage"=>"Change workspace owner names, account status and ATS passwords. Roles and subscriptions are controlled separately.","admin.requests.review"=>"Review and respond to requests. Granting access also requires Manage Entitlements.","admin.subscriptions.manage"=>"Change seats, position slots and paid feature access. To grant a request, Review Requests is also required.","admin.subadmins.view"=>"View Sub-Admin accounts and their assigned responsibilities.","admin.subadmins.manage"=>"Create, edit, deactivate and assign access to Sub-Admin accounts.","admin.rules.view"=>"Review the current assessment decision thresholds.","admin.rules.manage"=>"Change the rules that determine AI recommendation outcomes.","admin.audit.view"=>"Review changes made by Admin and Sub-Admin accounts.",_=>""};
    static string ReadableAction(string action)=>action switch{"Sub-Admin created"=>"Sub-Admin Created","Sub-Admin access updated"=>"Sub-Admin Access Updated","Employer entitlement updated"=>"Workspace Entitlement Updated","Employer request responded"=>"Access Request Reviewed","Decision rules updated"=>"Decision Rules Updated",_=>action};
    static string ReadableAuditDetail(AuditEntry entry){
        if(entry.Action=="Sub-Admin created"){var parts=entry.Detail.Split(';',2,StringSplitOptions.TrimEntries);return parts.Length==2?$"Created with {parts[0]}: {ReadablePermissions(parts[1])}.":$"Created with {entry.Detail}.";}
        if(entry.Action=="Sub-Admin access updated"){var parts=entry.Detail.Split(';',2,StringSplitOptions.TrimEntries);return parts.Length==2?$"Access level and responsibilities updated: {ReadablePermissions(parts[1])}.":$"Access changed: {entry.Detail}.";}
        if(entry.Action=="Employer entitlement updated")return "Workspace subscription allowances or feature access changed.";
        if(entry.Action=="Employer request responded")return $"Request reviewed: {entry.Detail}.";
        if(entry.Action=="Decision rules updated")return "Assessment recommendation rules were changed.";
        return entry.Detail;
    }
    static string ReadablePermissions(string text)=>string.Join(", ",text.Split(',',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).Select(key=>key switch{"admin.workspaces.view"=>"View Workspaces","admin.accounts.manage"=>"Manage Workspace Accounts","admin.requests.review"=>"Review Requests","admin.subscriptions.manage"=>"Manage Entitlements","admin.subadmins.view"=>"View Sub-Admin Directory","admin.subadmins.manage"=>"Manage Sub-Admins","admin.rules.view"=>"View Decision Rules","admin.rules.manage"=>"Change Decision Rules","admin.audit.view"=>"View Audit Events",_=>key}));
}
