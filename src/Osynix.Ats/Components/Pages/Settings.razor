@page "/settings"
@attribute [Authorize(Roles="Admin")]
@inherits PageBase
@inject AtsService Ats
@inject AdminService Admin
<PageTitle>Settings · Osynix ATS</PageTitle>
<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>Rules, users &amp; audit</h1></div></div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<section class="panel"><div class="section-heading"><h2>Decision rules</h2><button class="secondary" @onclick="()=>rules.Add(new DecisionRule())">+ Rule</button></div><p class="muted">Must-have Fail always produces Reject. Insufficient Evidence remains Insufficient Evidence. Other decisions use the highest matching threshold. Existing assessments retain their original decision.</p><table><thead><tr><th>Must-have fit</th><th>Minimum match %</th><th>Decision</th><th></th></tr></thead><tbody>@foreach(var r in rules){<tr><td><select @bind="r.MustHaveFit"><option>Pass</option><option>Partial</option></select></td><td><input type="number" min="0" max="100" @bind="r.MinimumMatch" /></td><td><select @bind="r.Decision">@foreach(var s in Choices.Decisions){<option>@s</option>}</select></td><td><button class="secondary" @onclick="()=>rules.Remove(r)">Remove</button></td></tr>}</tbody></table><button disabled="@Busy" @onclick="SaveRules">Save rules</button></section>
<section class="panel"><h2>Add user</h2><div class="form-grid"><label>Email<input type="email" @bind="email" /></label><label>Initial password<input type="password" autocomplete="new-password" @bind="password" /></label><label>Role<select @bind="role"><option>Recruiter</option><option>Admin</option></select></label></div><p class="muted small">New passwords need 12 characters, upper/lowercase, a number and a symbol. No credentials are emailed.</p><button disabled="@Busy" @onclick="CreateUser">Create user</button></section>
<section class="panel table-wrap"><h2>Workspace users</h2><p class="muted">Imported accounts need an administrator to set a password. Recruiter grants control position creation, talent reuse and report export. Account changes apply to subsequent operations.</p><table><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Password</th><th></th></tr></thead><tbody>@foreach(var u in users){<tr><td>@u.Username<small>@u.FullName</small></td><td>@u.Role</td><td>@u.Status</td><td>@(u.HasPassword?"Configured":"Needs setup")</td><td><button class="secondary" @onclick="()=>Edit(u)">Manage</button></td></tr>}</tbody></table></section>
@if(selected is not null){<section class="panel"><h2>Manage @selected.Username</h2><div class="form-grid"><label>Full name<input @bind="fullName" /></label><label>Role<select @bind="editRole"><option>Admin</option><option>Recruiter</option></select></label><label>Account status<select @bind="status"><option>Active</option><option>Inactive</option><option>Pending</option></select></label></div><label class="check"><input type="checkbox" @bind="canCreate" /> Create positions</label><label class="check"><input type="checkbox" @bind="canTalent" /> View talent pool / assess stored profiles</label><label class="check"><input type="checkbox" @bind="canExport" /> Export reports</label><button disabled="@Busy" @onclick="Update">Save access</button><h3>Set / reset password</h3><label>New password<input type="password" autocomplete="new-password" @bind="newPassword" /></label><button disabled="@Busy" @onclick="Reset">Set password</button> <button class="secondary" @onclick="()=>selected=null">Close</button></section>}
<section class="panel table-wrap"><h2>Latest audit events</h2><table><thead><tr><th>UTC time</th><th>Action</th><th>User</th><th>Detail</th></tr></thead><tbody>@foreach(var a in audit){<tr><td>@a.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@a.Action</td><td>@(a.ActorName.Length>0?a.ActorName:a.UserId)</td><td>@a.Detail</td></tr>}</tbody></table></section>
@code{
List<DecisionRule> rules=[];List<WorkspaceUser> users=[];List<AuditEntry> audit=[];WorkspaceUser? selected;string email="",password="",role="Recruiter",fullName="",editRole="Recruiter",status="Active",newPassword="";bool canCreate,canTalent,canExport;
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load(){rules=await Ats.Rules();users=await Admin.Users();audit=await Admin.Audit();}
void Edit(WorkspaceUser u){selected=u;fullName=u.FullName;editRole=u.Role;status=u.Status;canCreate=u.CanCreatePositions;canTalent=u.CanViewTalentPool;canExport=u.CanExportReports;newPassword="";}
Task SaveRules()=>Run(async()=>{await Ats.SaveRules(rules);await Load();Notice="Decision rules saved.";});
Task CreateUser()=>Run(async()=>{await Admin.CreateUser(email,password,role);email=password="";await Load();Notice="User created.";});
Task Update()=>Run(async()=>{await Admin.UpdateUser(selected! with{FullName=fullName,Role=editRole,Status=status,CanCreatePositions=canCreate,CanViewTalentPool=canTalent,CanExportReports=canExport});await Load();selected=null;Notice="Account access updated.";});
Task Reset()=>Run(async()=>{await Admin.ResetPassword(selected!.Id,newPassword);newPassword="";await Load();Notice="Password set. Share it with the user through your usual secure channel.";});
}
