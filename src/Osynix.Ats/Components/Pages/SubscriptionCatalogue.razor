@page "/settings/subscription-plans"
@using System.Globalization
@attribute [Authorize(Roles="Admin,SubAdmin")]
@inherits PageBase
@inject SubscriptionService Subscriptions
@inject Access Access
@inject ExchangeRateService ExchangeRates
<PageTitle>Subscription Plans · Osynix ATS</PageTitle>
<div class="catalogue-page">
<a href="/settings/employers">← Workspaces &amp; Subscriptions</a>
<div class="page-heading"><div><div class="eyebrow">PLATFORM ADMINISTRATION</div><h1>Subscription Plans &amp; Pricing</h1><p class="muted">Maintain plan details, prices, discounts, feature access and limits for Freelancers, Employers and Agencies. Preview any draft before publishing.</p></div></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(loaded&&!canView){<p>Workspace viewing permission is required.</p>}else if(loaded){
<div class="catalogue-categories">@foreach(var category in new[]{"Freelancer","Employer","Agency"}){<button class="@(type==category?"active":"")" aria-pressed="@(type==category)" @onclick="()=>Choose(category)">@category plans</button>}</div>
<section class="panel"><p class="muted">Prices are provisional until “Display confirmed pricing” is enabled. Annual pricing uses a 17% discount from twelve monthly payments. USD values are converted from PKR at the saved reference rate below. Published cards update when saved. Choose whether updated benefits apply to current subscribers; pending requests retain their quoted terms.</p><div class="table-wrap"><table><thead><tr><th>Plan</th><th>Monthly / PKR</th><th>Annual / PKR</th><th>Monthly / USD</th><th>Annual / USD</th><th>Promotion</th><th>Visibility</th><th></th></tr></thead><tbody>@foreach(var plan in plans.Where(p=>p.AccountCategory==type).OrderBy(p=>Rank(p.Code))){<tr><td><b>@plan.Name</b><small>@(plan.PricingConfirmed?"Confirmed pricing":"Price on request")</small></td><td>@plan.MonthlyPkr.ToString("N2")</td><td>@plan.AnnualPkr.ToString("N2")</td><td>@plan.MonthlyUsd.ToString("N2")</td><td>@plan.AnnualUsd.ToString("N2")</td><td>@PromotionStatus(plan)</td><td>@(plan.Published?"Published":"Draft")</td><td><button class="secondary" @onclick="()=>Edit(plan)">@(canManage?"Edit":"View")</button></td></tr>}</tbody></table></div></section>
@if(draft is not null){
    <div class="catalogue-drawer-backdrop" @onclick="CloseEditor" role="presentation">
        <aside class="catalogue-drawer" role="dialog" aria-modal="true" aria-labelledby="catalogue-editor-title" @onclick:stopPropagation="true">
            <header class="catalogue-drawer-header"><div><div class="eyebrow">@draft.AccountCategory.ToUpperInvariant() PLAN</div><h2 id="catalogue-editor-title">@draft.Name</h2><p class="muted">Edit plan copy, pricing, campaign discounts, included features and usage limits.</p></div><button type="button" class="secondary" aria-label="Close editor" @onclick="CloseEditor">Close</button></header>
            <div class="catalogue-drawer-content">
                <Feedback Error="@Error" Busy="Busy" />
                <section class="catalogue-price-summary"><div><span>Monthly · PKR</span><b>@draft.MonthlyPkr.ToString("N2")</b></div><div><span>Annual · PKR</span><b>@draft.AnnualPkr.ToString("N2")</b><small>17% annual saving</small></div><div><span>Monthly · USD</span><b>@draft.MonthlyUsd.ToString("N2")</b></div><div><span>Annual · USD</span><b>@draft.AnnualUsd.ToString("N2")</b><small>17% annual saving</small></div></section>
                <p class="catalogue-fx-note">@if(pkrPerUsd is decimal liveRate){<span>Conversion reference: <b>1 USD = @liveRate.ToString("N4") PKR</b> · ExchangeRate.fun hourly feed · source updated @(rateSourceUtc?.AddHours(5).ToString("dd MMM yyyy HH:mm")??"—") PKT · checked @(rateFetchedUtc?.AddHours(5).ToString("dd MMM yyyy HH:mm")??"—") PKT.</span>}else{<span class="error-text">Live exchange rate unavailable. Existing USD values are retained until a rate is available.</span>} <button type="button" class="secondary" disabled="@Busy" @onclick="RefreshRate">Refresh rate</button></p>
                <fieldset disabled="@(!canManage||Busy)">
                    <div class="form-grid"><label>Plan name<input maxlength="80" @bind="draft.Name" /></label><label>Description<input maxlength="1000" @bind="draft.Description" /></label><label>Monthly · PKR<input type="number" min="0" step="0.01" @bind="draft.MonthlyPkr" @bind:event="oninput" @bind:after="RecalculatePricing" /></label><label>Annual · PKR <small>12 monthly payments less 17%</small><input type="number" value="@draft.AnnualPkr.ToString("0.00",CultureInfo.InvariantCulture)" readonly /></label><label>Monthly · USD <small>Converted at today’s reference rate</small><input type="number" value="@draft.MonthlyUsd.ToString("0.00",CultureInfo.InvariantCulture)" readonly /></label><label>Annual · USD <small>Converted after 17% annual saving</small><input type="number" value="@draft.AnnualUsd.ToString("0.00",CultureInfo.InvariantCulture)" readonly /></label></div>
                    <details open><summary>Promotion pricing</summary><p class="muted small">Set a temporary discount. Customers see the standard price crossed out beside the reduced price. Dates use Pakistan time; leave either date blank for an open-ended promotion.</p><div class="form-grid"><label>Discount percent<input type="number" min="0" max="99" step="1" @bind="draft.PromotionPercent" /></label><label>Campaign label<input maxlength="120" @bind="draft.PromotionLabel" placeholder="Launch offer" /></label><label>Starts on<input type="date" @bind="draft.PromotionStartsOn" /></label><label>Ends on<input type="date" @bind="draft.PromotionEndsOn" /></label></div></details>
                    <label class="check"><input type="checkbox" @bind="draft.PricingConfirmed" /> Display confirmed pricing (otherwise show “Price on request”)</label><label class="check"><input type="checkbox" @bind="draft.Published" /> Publish this plan for @draft.AccountCategory accounts</label>
                    <details open><summary>Plan benefits, limits &amp; Careers page</summary><p class="muted small">Edit what each tier includes. Published plan cards highlight improvements over the previous tier.</p><div class="form-grid"><label>Position slots<input type="number" min="0" max="1000000" @bind="terms.PositionSlots" /></label>@if(draft.AccountCategory!="Freelancer"){<label>Internal team seats<input type="number" min="0" @bind="terms.InternalSeats" /></label>}<label>Monthly AI assessments<input type="number" min="0" @bind="terms.MonthlyAssessments" /><small>Leave blank for no cap. 0 disables new assessments.</small></label><label>Monthly JD analyses<input type="number" min="0" @bind="terms.MonthlyJdAnalyses" /><small>Leave blank for no cap.</small></label><label>Careers applications per position<input type="number" min="0" @bind="terms.ApplicationsPerPosition" /><small>Careers page is included in all plans. Leave blank for no per-position cap; monthly AI allowance still applies.</small></label></div>@if(draft.AccountCategory=="Freelancer"){<label class="check"><input type="checkbox" @bind="terms.Marketplace" /> Marketplace visibility, availability and invitations</label>}@if(draft.AccountCategory!="Freelancer"){<label class="check"><input type="checkbox" @bind="terms.HiringManagerReviews" /> Hiring Manager review portal and shareable links</label><label class="check"><input type="checkbox" @bind="terms.FreelancerDirectory" /> Freelancer directory, profiles and new outreach</label><label>Unique freelancers approached per month<input type="number" min="0" max="1000000" @bind="terms.MonthlyFreelancerApproaches" /><small>Leave blank for unlimited. Repeat contact with the same freelancer counts once per calendar month.</small></label>}<label class="check"><input type="checkbox" @bind="terms.MasterPool" /> Master Talent Pool access</label><label class="check"><input type="checkbox" @bind="terms.Reports" /> Reports and exports</label><label class="check"><input type="checkbox" @bind="terms.EmailTemplates" /> Email Templates</label><label class="check"><input type="checkbox" @bind="terms.MeetingIntegrations" /> Online and on-site interview scheduling with candidate email notifications (provider account authorization may be required)</label>@if(terms.MeetingIntegrations){<label class="check"><input type="checkbox" @bind="terms.ZoomIntegration" /> Include Zoom alongside Google Meet and Microsoft Teams</label>}</details><section class="sc-info"><label class="check"><input type="checkbox" @bind="applyToSubscribers" /> Apply updated benefits and limits to current subscribers</label><small>Updates this plan’s active workspaces immediately. Preserves agreed prices, renewal dates, recorded usage and separate Admin grants. Existing records remain available when usage exceeds a reduced limit; new activity is restricted.</small></section>
                </fieldset>
            </div>
            <footer class="catalogue-drawer-footer">@if(canManage){<button type="button" class="secondary" disabled="@Busy" @onclick="()=>preview=true">Preview plan</button><button disabled="@Busy" @onclick="Save">Save plan &amp; pricing</button>}<button type="button" class="secondary" @onclick="CloseEditor">Cancel</button></footer>
        </aside>
    </div>
    @if(preview&&draft is not null){<div class="catalogue-preview-backdrop" role="presentation" @onclick="()=>preview=false"><section class="catalogue-preview-modal" role="dialog" aria-modal="true" aria-labelledby="plan-preview-title" @onclick:stopPropagation="true"><div class="catalogue-drawer-header"><div><div class="eyebrow">CUSTOMER VIEW</div><h2 id="plan-preview-title">Plan preview</h2></div><button type="button" class="secondary" @onclick="()=>preview=false">Close</button></div><article class="catalogue-preview-card"><div class="eyebrow">@draft.AccountCategory</div><h3>@draft.Name</h3><p>@draft.Description</p><div class="catalogue-preview-price">@if(draft.PricingConfirmed){@if(PreviewPromotionActive){<del>@draft.MonthlyPkr.ToString("N0") PKR / month</del>}<b>@PreviewPrice</b>}else{<b>Price on request</b>}</div>@if(PreviewPromotionActive){<span class="sc-promo-badge">@(string.IsNullOrWhiteSpace(draft.PromotionLabel)?$"{draft.PromotionPercent:N0}% off":draft.PromotionLabel)</span>}else if(draft.PromotionPercent>0){<p class="muted small">Promotion configured; it is not active today.</p>}<ul>@foreach(var item in PreviewBenefits()){<li class="@(item.Highlight?"sc-benefit-new":"")">@item.Text</li>}</ul></article><p class="muted small">Preview reflects the current draft. Save to publish any changes.</p></section></div>}
}
}
</div>
@code{
List<SubscriptionPlan> plans=[];SubscriptionPlan? draft;SubscriptionTerms terms=new();string type="Freelancer",rateError="";bool loaded,canManage,canView,preview,applyToSubscribers;decimal? pkrPerUsd;DateTime? rateSourceUtc,rateFetchedUtc;
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load(){canView=await Access.CanAdmin("admin.workspaces.view");canManage=await Access.CanAdmin("admin.subscriptions.manage");if(canView)plans=await Subscriptions.Catalogue();loaded=true;}
static int Rank(string code)=>code switch{"free"=>0,"starter"=>1,"growth"=>2,_=>3};
string PromotionStatus(SubscriptionPlan plan)=>plan.PromotionPercent<=0?"—":SubscriptionRules.PromotionActive(plan,SubscriptionRules.PakistanToday())?$"Active · {plan.PromotionPercent:N0}% off":plan.PromotionStartsOn is DateOnly start&&start>SubscriptionRules.PakistanToday()?"Scheduled":plan.PromotionEndsOn is DateOnly end&&end<SubscriptionRules.PakistanToday()?"Ended":"Ready";
void Choose(string category){type=category;draft=null;}
async Task Edit(SubscriptionPlan selected)=>await Run(async()=>{plans=await Subscriptions.Catalogue();var plan=plans.Single(p=>p.Id==selected.Id);draft=JsonSerializer.Deserialize<SubscriptionPlan>(JsonSerializer.Serialize(plan))!;terms=SubscriptionRules.Terms(plan);preview=false;applyToSubscribers=false;await FetchRate();RecalculateUsd();});
async Task FetchRate(){try{var quote=await ExchangeRates.GetUsdToPkr();pkrPerUsd=quote.PkrPerUsd;rateSourceUtc=quote.SourceTimestampUtc;rateFetchedUtc=quote.FetchedUtc;rateError="";}catch{rateError="Could not reach the hourly USD/PKR rate source. Retry before changing PKR pricing.";}}
Task RefreshRate()=>Run(async()=>{await FetchRate();if(pkrPerUsd is null)throw new InvalidOperationException(rateError);RecalculateUsd();Notice=$"Live USD/PKR rate refreshed: 1 USD = {pkrPerUsd.Value:N4} PKR.";});
void RecalculateUsd(){if(draft is null||pkrPerUsd is not decimal rate)return;draft.MonthlyUsd=Math.Round(draft.MonthlyPkr/rate,2,MidpointRounding.AwayFromZero);draft.AnnualUsd=Math.Round(draft.AnnualPkr/rate,2,MidpointRounding.AwayFromZero);}
void RecalculatePricing(){if(draft is null)return;draft.AnnualPkr=Math.Round(draft.MonthlyPkr*12m*.83m,2,MidpointRounding.AwayFromZero);RecalculateUsd();}
void CloseEditor(){draft=null;preview=false;}
bool PreviewPromotionActive=>draft is not null&&SubscriptionRules.PromotionActive(draft,SubscriptionRules.PakistanToday());
string PreviewPrice=>draft is null?"":$"{(PreviewPromotionActive?draft.MonthlyPkr*(100-draft.PromotionPercent)/100:draft.MonthlyPkr):N0} PKR / month";
IEnumerable<(string Text,bool Highlight)> PreviewBenefits()
{
    var oldPlan=draft is null?null:plans.Where(p=>p.AccountCategory==draft.AccountCategory&&Rank(p.Code)<Rank(draft.Code)).OrderByDescending(p=>Rank(p.Code)).FirstOrDefault();
    var old=oldPlan is null?null:SubscriptionRules.Terms(oldPlan);
    static bool Increased(int? value,int? oldValue)=>value is null?oldValue is not null:oldValue is int previous&&value>previous;
    (string Text,bool Highlight) Highlight(string label,int? value,int? oldValue)=>(label,old is not null&&Increased(value,oldValue));
    yield return Highlight($"{terms.PositionSlots} position slots",terms.PositionSlots,old?.PositionSlots);
    if(draft?.AccountCategory!="Freelancer"&&terms.InternalSeats>0)yield return Highlight($"{terms.InternalSeats} internal team seats",terms.InternalSeats,old?.InternalSeats);
    yield return Highlight($"{terms.MonthlyAssessments?.ToString()??"Unlimited"} AI assessments / month",terms.MonthlyAssessments,old?.MonthlyAssessments);
    yield return Highlight($"{terms.MonthlyJdAnalyses?.ToString()??"Unlimited"} JD analyses / month",terms.MonthlyJdAnalyses,old?.MonthlyJdAnalyses);
    var careers=terms.ApplicationsPerPosition is int cap?$"Careers page included · {cap} applications per position":"Careers page included · no per-position application cap";
    yield return Highlight(careers,terms.ApplicationsPerPosition,old?.ApplicationsPerPosition);
    if(terms.MeetingIntegrations)yield return ("Online interviews, on-site scheduling & candidate email notifications",old?.MeetingIntegrations==false);
    if(terms.Marketplace)yield return ("Marketplace profile, availability & invitations",old?.Marketplace==false);
    if(draft?.AccountCategory!="Freelancer"){
        if(terms.HiringManagerReviews||draft?.AccountCategory!="Employer")yield return (terms.HiringManagerReviews?"Hiring Manager portal & links":"Hiring Manager links not included",terms.HiringManagerReviews&&old?.HiringManagerReviews==false);
        if(terms.FreelancerDirectory||draft?.AccountCategory!="Employer")yield return (terms.FreelancerDirectory?(terms.MonthlyFreelancerApproaches is int limit?$"Approach {limit} unique freelancers / month":"Freelancer profiles & unlimited monthly outreach"):"Freelancer profiles not included",terms.FreelancerDirectory&&old?.FreelancerDirectory==false);
    }
    if(terms.MasterPool)yield return ("Master Talent Pool",old?.MasterPool==false);
    if(terms.Reports)yield return ("Reports and exports",old?.Reports==false);
    if(terms.EmailTemplates)yield return ("Email Templates",old?.EmailTemplates==false);
}
Task Save()=>Run(async()=>{if(draft is null)return;await Subscriptions.SavePlan(draft,terms,applyToSubscribers);CloseEditor();await Load();Notice=applyToSubscribers?"Plan saved. Current subscribers now use the updated limits and benefits; agreed billing and recorded usage are preserved.":"Plan saved. Updated benefits apply to future activations; existing subscriptions are preserved.";});
}
