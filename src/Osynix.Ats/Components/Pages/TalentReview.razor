@page "/settings/talent-review"
@attribute [Authorize(Roles="Admin")]
@inherits PageBase
@inject TalentAdministration Talent
<PageTitle>Master Talent Identity Review · Osynix ATS</PageTitle>
<div class="page-heading"><div><h1>Master Talent Identity Review</h1><p class="muted">Uncertain Identities Are Hidden From Subscribers Until Reviewed. Workspace Profiles And Recruitment History Stay Separate.</p></div><a class="button secondary" href="/master-talent">Master Talent Pool</a></div>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<section class="panel table-wrap"><table><thead><tr><th>Name</th><th>Email / Phone</th><th>Review</th><th></th></tr></thead><tbody>@foreach(var identity in identities){<tr><td>@identity.Name</td><td>@identity.Email<small>@identity.Phone</small></td><td>@(identity.NeedsReview?"Needs Review":"Available")</td><td><button class="secondary" @onclick="()=>Select(identity)">Review Identity</button></td></tr>}</tbody></table></section>
@if(selected is not null){<section class="panel"><h2>@selected.Name</h2><p>Confirm A Separate Person Or Select The Existing Identity For The Same Person. This Links Identity Records Only; Private Workspace Profiles And Assessments Are Preserved.</p><label>Same Person As<select @bind="target"><option value="">Keep As A Separate Person</option>@foreach(var identity in identities.Where(i=>i.Id!=selected.Id)){<option value="@identity.Id">@identity.Name · @identity.Email · @identity.Phone</option>}</select></label><label class="check"><input type="checkbox" @bind="confirmed" /> I Have Reviewed The Identity Evidence And Confirm This Decision.</label><button disabled="@(Busy||!confirmed)" @onclick="Save">Save Identity Decision</button> <button class="secondary" @onclick="()=>selected=null">Cancel</button></section>}
@code{List<TalentIdentityReview> identities=[];TalentIdentityReview? selected;Guid? target;bool confirmed;
protected override Task OnInitializedAsync()=>Run(Load);async Task Load()=>identities=await Talent.Review();void Select(TalentIdentityReview identity){selected=identity;target=null;confirmed=false;}Task Save()=>Run(async()=>{await Talent.Resolve(selected!.Id,selected.Revision,target);selected=null;await Load();Notice="Identity Review Saved.";});}
