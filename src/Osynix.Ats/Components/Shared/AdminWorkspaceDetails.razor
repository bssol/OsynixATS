@inherits PageBase
@inject EmployerService EmployerService
@inject AdminService Admin
@inject SupportInboxService SupportInbox
@inject RecruitmentUpdates Updates
@implements IDisposable
<div class="account-detail">
<button class="back-link" disabled="@Busy" @onclick="()=>OnBack.InvokeAsync()">← Back To Accounts</button>
<p class="breadcrumb">Workspaces &amp; Subscriptions <span>›</span> @AccountType Accounts</p>
<header class="account-heading"><div class="identity"><span class="company-avatar">@Initials(Item.Workspace.CompanyName)</span><div><h1>@Item.Workspace.CompanyName</h1><div class="subline"><span class="status @(Owner?.Status=="Active"?"green":"gray")">@(Owner?.Status??"Owner Unavailable")</span><span>@AccountType</span><span>Created @Item.Workspace.CreatedUtc.ToString("dd MMM yyyy")</span></div></div></div><div class="heading-actions"><button class="secondary" disabled="@Busy" @onclick="()=>Run(Refresh)">Refresh</button>@if(CanManageAccounts&&Owner is not null){<button disabled="@Busy" @onclick="EditAccount">Edit Account</button>}</div></header>
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(Pending.Count>0){<div class="request-notice"><span><b>@Pending.Count Requests Need Review</b> — Access And Capacity Requests Are Waiting For A Response.</span><button @onclick='()=>SelectTab("Requests")'>Review Requests →</button></div>}
<nav class="account-tabs" aria-label="Account Sections">
@foreach(var name in new[]{"Overview","Team","Requests","Chat History","Activity"}){<button class="@(tab==name?"selected":"")" aria-pressed="@(tab==name)" @onclick="()=>SelectTab(name)">@((name=="Team"&&Freelance)?"Employer Memberships":name) @if(name=="Requests"){<span>@Pending.Count</span>}@if(name=="Team"){<span>@team.Members.Count</span>}</button>}
</nav>
@if(tab=="Overview"){
<div class="overview-grid"><div class="detail-stack">
<section class="detail-card"><div class="card-heading"><h2>Account Owner</h2>@if(CanManageAccounts&&Owner is not null){<button class="text-button" @onclick="EditAccount">Manage Access →</button>}</div><div class="owner-identity"><span class="owner-avatar">@Initials(OwnerName)</span><div><b>@OwnerName</b><small>Workspace Owner · @AccountType</small></div></div><div class="owner-fields"><div><small>Email Address</small><b>@(Owner?.Email??"Unavailable")</b></div><div><small>Account Status</small><b>@Owner?.Status</b></div><div><small>ATS Password</small><b>@(Owner?.HasPassword==true?"Configured":"Not Configured")</b></div></div>
@if(editAccount){<div class="edit-area"><h3>Edit Account &amp; Access</h3><div class="form-grid"><label>Owner Name<input maxlength="160" @bind="ownerName" /></label><label>Account Status<select @bind="ownerStatus"><option>Active</option><option>Inactive</option><option>Pending</option></select></label></div><p class="muted small">Account Status Controls The Owner's Sign-In Across Workspaces.</p><div class="toolbar"><button disabled="@Busy" @onclick="SaveAccount">Save Account Access</button><button class="secondary" disabled="@Busy" @onclick="()=>editAccount=false">Cancel</button></div><details class="password-tray"><summary>Reset ATS Password</summary><label>New Password<input type="password" autocomplete="new-password" @bind="ownerPassword" /></label><p class="muted small">At Least 6 Characters With Uppercase, Lowercase, A Number And A Symbol. Existing Sessions Will Be Invalidated.</p><button disabled="@Busy" @onclick="ResetPassword">Reset Password</button></details></div>}
</section>
<AdminSubscriptionStatus Workspace="Item.Workspace" CanManage="CanManageEntitlements" OnChanged="Refresh" />
<section class="detail-card workspace-entitlements"><div class="card-heading"><h2>Subscription &amp; Capacity</h2>@if(CanManageEntitlements&&!editSubscription){<button class="text-button" disabled="@Busy" @onclick="EditSubscription">Manage Access →</button>}</div>
<div class="card-body"><div class="plan-heading"><div><h3>@(Item.Workspace.SubscriptionName+" plan")</h3><p class="muted small">Feature Access Remains Active Until Admin Revokes It.</p></div><span class="status blue">@AccountType</span></div>
<div class="capacity-line"><span>Position Slots Used</span><b>@Item.UsedPositionSlots / @Slots</b></div><progress value="@Item.UsedPositionSlots" max="@Math.Max(1,Slots)" aria-label="Position Slots Used"></progress><div class="capacity-note">@Math.Max(0,Slots-Item.UsedPositionSlots) Available · Active And On-Hold Positions Use Slots</div>
<div class="capacity-boxes">@if(!Freelance){<div><small>Internal Seats</small><b>@Item.ActiveInternalMembers / @Seats</b></div>}<div><small>@(Freelance?"Employer Memberships":"External Recruiters")</small><b>@(Freelance?team.Members.Count:Item.ActiveExternalRecruiters)</b></div><div><small>Pending Invitations</small><b>@Item.PendingInvitations</b></div></div>
<div class="access-section-heading"><h3>Workspace Capacity</h3><span class="muted small">Free Allowance + Additional Capacity</span></div>
<div class="capacity-access-row"><div class="access-description"><b>Position Slots</b><small>Active And On-Hold Positions Use Slots.</small></div><div class="capacity-controls">
@if(editSubscription){<label>Plan<input type="number" min="0" max="1000" disabled="@Busy" @bind="entitlement.FreePositionSlots" /></label><label>Additional<input type="number" min="0" max="1000" disabled="@Busy" @bind="entitlement.AdditionalPositionSlots" /></label>}else{<div><small>Plan</small><b>@Item.Workspace.FreePositionSlots</b></div><div><small>Additional</small><b>@Item.Workspace.AdditionalPositionSlots</b></div>}<div class="capacity-total"><small>Total</small><b>@Slots</b></div></div></div>
@if(!Freelance){<div class="capacity-access-row"><div class="access-description"><b>Internal Team Seats</b><small>External Freelance Recruiters Do Not Use Seats.</small></div><div class="capacity-controls">
@if(editSubscription){<label>Plan<input type="number" min="0" max="1000" disabled="@Busy" @bind="entitlement.FreeRecruiterSeats" /></label><label>Additional<input type="number" min="0" max="1000" disabled="@Busy" @bind="entitlement.AdditionalRecruiterSeats" /></label>}else{<div><small>Plan</small><b>@Item.Workspace.FreeRecruiterSeats</b></div><div><small>Additional</small><b>@Item.Workspace.AdditionalRecruiterSeats</b></div>}<div class="capacity-total"><small>Total</small><b>@Seats</b></div></div></div>}
<div class="access-section-heading"><h3>Feature Access</h3>@if(CanManageEntitlements){<span class="muted small">Select A Status To Change Access</span>}</div>
<div class="feature-line"><div class="access-description"><b>Subscription renewal date</b><small>Reminder is sent to the account owner 7 days before, by email and in-portal notification. All dates use Pakistan time.</small></div>@if(editSubscription){<label>Renewal date<input type="date" disabled="@Busy" @bind="entitlement.SubscriptionRenewalDate" /></label>}else{<b>@(Item.Workspace.SubscriptionRenewalDate?.ToString("dd MMM yyyy")??"No renewal scheduled")</b>}</div>
<div class="feature-line"><div class="access-description"><b>Email Templates</b><small>Create, Edit And Use Workspace Templates.</small></div><button type="button" class="secondary feature-toggle @((AccessWorkspace.EmailTemplatesEnabled||PlanTemplates)?"is-enabled":"is-disabled")" role="switch" aria-label="Email Templates" aria-checked="@((AccessWorkspace.EmailTemplatesEnabled||PlanTemplates).ToString().ToLowerInvariant())" disabled="@(Busy||!CanManageEntitlements||PlanTemplates)" @onclick='()=>ToggleFeature("Email Templates")'>@(PlanTemplates?"Included by plan":AccessWorkspace.EmailTemplatesEnabled?"Enabled":"Disabled")</button></div>
<div class="feature-line"><div class="access-description"><b>Osynix Master Talent Pool</b><small>Access To The Platform's Master Candidate Pool.</small></div><button type="button" class="secondary feature-toggle @((AccessWorkspace.MasterTalentPoolEnabled||PlanMaster)?"is-enabled":"is-disabled")" role="switch" aria-label="Osynix Master Talent Pool" aria-checked="@((AccessWorkspace.MasterTalentPoolEnabled||PlanMaster).ToString().ToLowerInvariant())" disabled="@(Busy||!CanManageEntitlements||PlanMaster)" @onclick='()=>ToggleFeature("Master Talent Pool")'>@(PlanMaster?"Included by plan":AccessWorkspace.MasterTalentPoolEnabled?"Enabled":"Disabled")</button></div>
@if(!Freelance){<div class="feature-line"><div class="access-description"><b>Agency / Client Module</b><small>Agency Mode And Client Management.</small></div><button type="button" class="secondary feature-toggle @(AccessWorkspace.AgencyEnabled?"is-enabled":"is-disabled")" role="switch" aria-label="Agency / Client Module" aria-checked="@(AccessWorkspace.AgencyEnabled.ToString().ToLowerInvariant())" disabled="@(Busy||!CanManageEntitlements)" @onclick='()=>ToggleFeature("Agency")'>@(AccessWorkspace.AgencyEnabled?"Enabled":"Disabled")</button></div>}
@if(Freelance){<p class="muted small">Employer-Assigned Positions Use The Employer's Capacity. Team Seats Require An Employer Account Upgrade.</p>}
@if(editSubscription){<div class="access-save-bar"><p class="muted small" role="status">Changes Are Not Applied Until You Save Workspace Access.</p><div class="toolbar"><button disabled="@Busy" @onclick="SaveAccess">Save Workspace Access</button><button class="secondary" disabled="@Busy" @onclick="()=>editSubscription=false">Cancel</button></div></div>}
</div></section>
<section class="detail-card"><div class="card-heading"><h2>Recent Activity</h2><button class="text-button" @onclick='()=>SelectTab("Activity")'>View Audit History →</button></div>@if(!CanViewAudit){<p class="empty">View Admin Audit Events Permission Is Required.</p>}else if(activity.Count==0){<p class="empty">No Account Activity Recorded.</p>}@foreach(var entry in activity.Take(3)){<div class="activity-row"><span class="activity-dot"></span><div><b>@entry.Action</b><p>@entry.Details</p><small>@entry.AccountInfo · @entry.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</small></div></div>}</section>
</div><div class="detail-stack">
<section class="detail-card"><div class="card-heading"><h2>@(Freelance?"Employer Memberships":"Team")</h2><button class="text-button" @onclick='()=>SelectTab("Team")'>View All →</button></div>@if(team.Members.Count==0){<p class="empty">@(Freelance?"No Employer Memberships.":"No Team Members Yet.")</p>}@foreach(var member in team.Members.Take(3)){<div class="member-row"><span class="owner-avatar">@Initials(member.Name)</span><div><b>@member.Name</b><small>@member.Kind</small></div><span class="status @(member.Status=="Active"?"green":"gray")">@member.Status</span></div>}<div class="card-foot">@team.Members.Count Total · @team.Invitations.Count Pending Invitations</div></section>
<section class="detail-card"><div class="card-heading"><h2>Open Requests</h2><button class="text-button" @onclick='()=>SelectTab("Requests")'>Review All →</button></div>@if(Pending.Count==0){<p class="empty">No Requests Awaiting Review.</p>}@foreach(var request in Pending.Take(3)){<button class="request-row" @onclick="()=>Review(request)"><span><b>@request.Feature</b><small>Quantity @request.Quantity · @request.CreatedUtc.ToString("dd MMM yyyy")</small></span><span class="status amber">@request.Status</span></button>}</section>
<section class="detail-card"><div class="card-heading"><h2>Workspace Access</h2></div><div class="card-body"><small>Workspace ID</small><p class="workspace-id">@Item.Workspace.Id</p><div class="feature-line"><span>Account Type</span><b>@AccountType</b></div><div class="feature-line"><span>Last Updated</span><b>@Item.Workspace.UpdatedUtc.ToString("dd MMM yyyy") UTC</b></div><p class="muted small">@(!CanManageAccounts?"Account Access Is Read-Only For Your Admin Role.":"Manage The Owner's Name, Status And Password From Account Owner.")</p></div></section>
</div></div>
}else if(tab=="Team"){
<section class="detail-card"><div class="card-heading"><h2>@(Freelance?"Employer Memberships":"Team Members")</h2><span class="muted small">@team.Members.Count Total</span></div><p class="table-note">@(Freelance?"Access Granted By Each Employer Workspace.":"Internal Members Use Seats. External Recruiters Have Separate Position Assignments. Team Permissions Are Managed By The Workspace Owner.")</p><div class="table-wrap"><table><thead><tr><th>@(Freelance?"Employer":"Member")</th><th>Type</th><th>Status</th><th>Permissions Granted</th></tr></thead><tbody>@foreach(var member in team.Members){<tr><td><b>@member.Name</b><small>@member.Email</small></td><td>@member.Kind</td><td>@member.Status</td><td>@Permissions(member)</td></tr>}</tbody></table></div>@if(team.Members.Count==0){<p class="empty">No Memberships Found.</p>}
@if(!Freelance&&team.Invitations.Count>0){<div class="card-heading"><h3>Pending Invitations</h3></div>@foreach(var invite in team.Invitations){<div class="member-row"><div><b>@invite.Name</b><small>@invite.Email</small></div><span class="status amber">@invite.Status</span></div>}}
</section>
}else if(tab=="Requests"){
<section class="detail-card"><div class="card-heading"><h2>Access &amp; Subscription Requests</h2><span class="status amber">@Pending.Count Pending</span></div>
@if(Item.Requests.Count==0){<p class="empty">No Requests For This Workspace.</p>}
<div class="table-wrap"><table><thead><tr><th>Request</th><th>Submitted</th><th>Quantity</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var request in Item.Requests){<tr><td><b>@request.Feature</b></td><td>@request.CreatedUtc.ToString("dd MMM yyyy")</td><td>@request.Quantity</td><td>@if(request.Status=="Needs Information"&&requestInformation.TryGetValue(request.Id,out var information)){<span class="status green">Information received</span><small>User replied @information.SubmittedUtc.ToString("dd MMM yyyy HH:mm") UTC</small>}else{<span class="status @(request.Status=="Granted"?"green":"gray")">@request.Status</span>}</td><td><button class="secondary" @onclick="()=>Review(request)">@(CanReviewRequests?"Review":"View")</button></td></tr>}</tbody></table></div>
@if(requestDraft is { } draft){<div class="request-editor"><h3>@draft.Feature · Quantity @draft.Quantity</h3><p class="preserve">@draft.Remarks</p>
@if(requestInformation.TryGetValue(draft.Id,out var submitted)){
<section class="request-submitted-information"><h4>User-submitted information</h4><p>Latest response: @submitted.SubmittedUtc.ToString("dd MMM yyyy HH:mm") UTC</p>
@foreach(var response in submitted.Messages){<article><small>@response.SenderName - @response.SentUtc.ToString("dd MMM yyyy HH:mm") UTC</small><p class="preserve">@response.Body</p>@if(response.AttachmentName.Length>0){<a href="@($"/messages/support-attachments/{response.Id}")" target="_blank" rel="noopener">View evidence: @response.AttachmentName</a>}</article>}
<button class="secondary" @onclick="()=>ViewChatSession(submitted.SessionId)">View full session in Chat History</button></section>}

@if(CanReviewRequests&&draft.Status!="Granted"&&draft.Status!="Withdrawn"){
@if(draft.SubscriptionPlanId is not null){<p><b>@draft.BillingPeriod / @(draft.QuotedPrice is decimal price?$"{draft.Currency} {price:N2}":"Price agreed outside ATS")</b></p><label class="check"><input type="checkbox" @bind="draft.PaymentConfirmed" /> I confirm payment has been received outside ATS</label><p class="muted small">Review the submitted payment evidence, then confirm receipt here. Granting activates this saved plan immediately.</p>}
<label>Message to account owner<textarea rows="3" maxlength="2000" @bind="draft.AdminResponse" placeholder="Add a note, or leave blank to use the standard message for your decision."></textarea></label><p class="muted small">Choose what happens next. Asking for information keeps this request open. Granting applies the requested access and removes it from pending requests.</p><div class="toolbar request-decision-actions"><button class="secondary" disabled="@Busy" @onclick='()=>Decide("Under Review")'>Keep Under Review</button><button class="secondary" disabled="@Busy" @onclick='()=>Decide("Needs Information")'>Request More Information</button><button class="secondary danger-outline" disabled="@Busy" @onclick='()=>Decide("Rejected")'>Reject Request</button>@if(CanGrant){<button disabled="@(Busy||draft.SubscriptionPlanId is not null&&!draft.PaymentConfirmed)" title="@(draft.SubscriptionPlanId is not null&&!draft.PaymentConfirmed?"Confirm payment received first":"Grant requested access")" @onclick='()=>Decide("Granted")'>@(draft.SubscriptionPlanId is not null?"Confirm Payment & Grant Plan":"Grant Access")</button>}</div><button class="secondary" disabled="@Busy" @onclick="()=>requestDraft=null">Close</button>
}else{<p><b>Admin Response</b></p><p class="preserve">@draft.AdminResponse</p><p class="muted small">@(draft.Status=="Granted"?"Granted Requests Remain In The Approval History. Use Manage Access To Revoke Features.":"Review Requests Permission Is Required To Respond.")</p><button class="secondary" @onclick="()=>requestDraft=null">Close</button>}
</div>}
</section>
}else if(tab=="Chat History"){
<AdminAccountChatHistory WorkspaceId="Item.Workspace.Id" InitialSessionId="historySessionId" />
}else{
<section class="detail-card"><div class="card-heading"><h2>Account Activity</h2><span class="muted small">Latest 100 Recorded Events · UTC</span></div>@if(!CanViewAudit){<p class="empty">View Admin Audit Events Permission Is Required.</p>}else if(activity.Count==0){<p class="empty">No Account Activity Recorded.</p>}else{<div class="table-wrap"><table><thead><tr><th>Activity</th><th>Performed By</th><th>Details</th><th>Date &amp; Time</th></tr></thead><tbody>@foreach(var entry in activity){<tr><td><b>@entry.Action</b></td><td>@entry.AccountInfo</td><td>@entry.Details</td><td>@entry.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</td></tr>}</tbody></table></div>}</section>
}
</div>
@code{
[Parameter,EditorRequired]public EmployerOverview Item{get;set;}=null!;
[Parameter]public WorkspaceUser? Owner{get;set;}
[Parameter]public bool CanManageAccounts{get;set;}
[Parameter]public bool CanManageEntitlements{get;set;}
[Parameter]public bool CanReviewRequests{get;set;}
[Parameter]public bool CanViewAudit{get;set;}
[Parameter]public EventCallback OnBack{get;set;}
[Parameter]public EventCallback OnChanged{get;set;}
AdminWorkspaceTeam team=new([],[]);
List<AdminActivitySummary> activity=[];
Dictionary<Guid,SupportRequestInformation> requestInformation=[];
EmployerWorkspace entitlement=new();
EmployerAccessRequest? requestDraft;
Guid? loadedId,historySessionId;
bool editAccount,editSubscription;
string tab="Overview",ownerName="",ownerStatus="Active",ownerPassword="";
bool Freelance=>Item.Workspace.Kind==AccountTypes.Freelance;
bool CanGrant=>CanReviewRequests&&CanManageEntitlements;
string AccountType=>Freelance?"Freelance Recruiter":Item.Workspace.AgencyEnabled?"Agency":"Employer";
string OwnerName=>string.IsNullOrWhiteSpace(Owner?.FullName)?Owner?.Username??"Owner Unavailable":Owner.FullName;
EmployerWorkspace AccessWorkspace=>editSubscription?entitlement:Item.Workspace;
int Slots=>AccessWorkspace.FreePositionSlots+AccessWorkspace.AdditionalPositionSlots;
int Seats=>AccessWorkspace.FreeRecruiterSeats+AccessWorkspace.AdditionalRecruiterSeats;
bool PlanMaster=>SubscriptionRules.Terms(Item.Workspace)?.MasterPool==true;
bool PlanTemplates=>SubscriptionRules.Terms(Item.Workspace)?.EmailTemplates==true;
bool HasGrantedAccess=>Item.Workspace.AdditionalPositionSlots>0||Item.Workspace.AdditionalRecruiterSeats>0||Item.Workspace.MasterTalentPoolEnabled||Item.Workspace.AgencyEnabled||Item.Workspace.EmailTemplatesEnabled;
List<EmployerAccessRequest> Pending=>Item.Requests.Where(r=>r.Status is "Submitted" or "Under Review" or "Needs Information").ToList();
static string Initials(string name)=>string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p=>char.ToUpperInvariant(p[0])));
static string Permissions(AdminWorkspaceMember m){var granted=new List<string>();if(m.CreateClients)granted.Add("Create Clients");if(m.CreatePositions)granted.Add("Create Positions");if(m.ExportReports)granted.Add("Export Reports");if(m.TalentPool)granted.Add("Talent Pool");return granted.Count>0?string.Join(" · ",granted):"Operational Access Only";}
protected override void OnInitialized()=>Updates.Changed+=SupportChanged;
protected override async Task OnParametersSetAsync(){if(loadedId!=Item.Workspace.Id){loadedId=Item.Workspace.Id;historySessionId=null;await Run(LoadDetails);}await LoadRequestInformation();}
async Task LoadRequestInformation(){requestInformation=CanReviewRequests?await SupportInbox.RequestInformation(Item.Workspace.Id):[];}
void SupportChanged()=>_=InvokeAsync(async()=>{await LoadRequestInformation();StateHasChanged();});
public void Dispose()=>Updates.Changed-=SupportChanged;
async Task LoadDetails(){team=await EmployerService.AdministrationTeam(Item.Workspace.Id);activity=CanViewAudit?await Admin.WorkspaceActivity(Item.Workspace.Id):[];}
async Task Refresh(){await OnChanged.InvokeAsync();await LoadDetails();await LoadRequestInformation();editAccount=editSubscription=false;requestDraft=null;}
void SelectTab(string value){tab=value;historySessionId=null;Error=Notice="";}
void ViewChatSession(Guid id){historySessionId=id;tab="Chat History";Error=Notice="";}
void EditAccount(){ownerName=Owner?.FullName??"";ownerStatus=Owner?.Status??"Active";ownerPassword="";editAccount=true;tab="Overview";}
void EditSubscription(){entitlement=JsonSerializer.Deserialize<EmployerWorkspace>(JsonSerializer.Serialize(Item.Workspace))!;editSubscription=true;}
void ToggleFeature(string feature){if(Busy||!CanManageEntitlements)return;if(!editSubscription)EditSubscription();switch(feature){case "Email Templates":entitlement.EmailTemplatesEnabled=!entitlement.EmailTemplatesEnabled;break;case "Master Talent Pool":entitlement.MasterTalentPoolEnabled=!entitlement.MasterTalentPoolEnabled;break;case "Agency" when !Freelance:entitlement.AgencyEnabled=!entitlement.AgencyEnabled;break;}}
void Review(EmployerAccessRequest request){requestDraft=JsonSerializer.Deserialize<EmployerAccessRequest>(JsonSerializer.Serialize(request))!;if(requestDraft.Status=="Submitted")requestDraft.Status="Under Review";tab="Requests";}
Task SaveAccount()=>Run(async()=>{await Admin.UpdateWorkspaceOwner(Item.Workspace.Id,ownerName,ownerStatus);await Refresh();Notice="Workspace Owner Account Updated.";});
Task ResetPassword()=>Run(async()=>{await Admin.ResetWorkspaceOwnerPassword(Item.Workspace.Id,ownerPassword);ownerPassword="";await Refresh();Notice="ATS Password Reset. Share It Through Your Secure Channel.";});
Task SaveAccess()=>Run(async()=>{await EmployerService.SetAccess(entitlement);await Refresh();Notice="Workspace Access Updated.";});
Task Decide(string status)=>Run(async()=>{if(requestDraft is null)return;var feature=requestDraft.SubscriptionPlanId is not null;requestDraft.Status=status;if(string.IsNullOrWhiteSpace(requestDraft.AdminResponse))requestDraft.AdminResponse=status switch{"Granted"=>feature?"Your payment has been confirmed and your requested subscription plan is now active.":"Your requested access has been granted.","Needs Information"=>"Please provide the requested information so we can continue reviewing your request.","Rejected"=>"Your request has been reviewed and could not be approved.",_=>"Your request is being reviewed."};await EmployerService.Respond(requestDraft);await Refresh();Notice=status switch{"Granted"=>feature?"Payment confirmed. The requested plan and its benefits are now active.":"Access granted successfully.","Needs Information"=>"More information requested. The request remains open.","Rejected"=>"Request declined.",_=>"Request saved as under review."};});
}
