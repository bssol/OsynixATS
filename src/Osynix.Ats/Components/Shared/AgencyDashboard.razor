@inherits PageBase
@inject AtsService Ats
@inject WorkspaceService Workspace
@inject HiringReviewService Review
@inject Access Access
@inject RecruitmentUpdates Updates
@implements IDisposable
<PageTitle>Agency Dashboard · Osynix ATS</PageTitle>
<div class="dashboard-page"><div class="page-heading"><div><div class="eyebrow">AGENCY PROFILE</div><h1>Agency Dashboard</h1><p class="muted">Client Recruitment Activity · Company Hiring Is Shown In Your Employer Profile.</p></div><a class="button secondary" href="/clients">Manage Clients</a></div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(allowed){<div class="kpis">
@foreach(var card in Cards){<a class="kpi" href="@card.Path"><span class="@($"kpi-icon {card.Tone}")"><NavIcon Name="@card.Icon" /></span><span>@card.Label</span><strong>@card.Count</strong></a>}
</div><section class="panel table-wrap"><div class="section-heading"><h2>Client Recruitment Overview</h2><a href="/pipeline">View Recruitment Pipeline</a></div><table><thead><tr><th>Client</th><th>Active Positions</th><th>Profiles Submitted</th><th>Awaiting Client Feedback</th><th>Pending Decisions</th><th>Upcoming Interviews</th><th>Hired</th><th></th></tr></thead><tbody>@foreach(var client in clients){var ids=positions.Where(p=>p.ClientId==client.Id).Select(p=>p.Id).ToHashSet();var rows=applications.Where(a=>ids.Contains(a.PositionId)).ToList();<tr><td><b>@client.Name</b><small>@client.Status</small></td><td>@positions.Count(p=>p.ClientId==client.Id&&p.Status=="Active")</td><td>@rows.Count(a=>submitted.Contains(a.Id))</td><td>@rows.Count(a=>a.Stage=="Awaiting Client Feedback")</td><td>@rows.Count(a=>Lifecycle.Classify(a)=="Pending Decision"&&a.Stage is not("Awaiting Client Feedback" or "Awaiting Employer Review"))</td><td>@rows.Count(a=>a.InterviewStatus=="Scheduled"&&Lifecycle.Classify(a) is not("Hired" or "Rejected"))</td><td>@rows.Count(a=>Lifecycle.Classify(a)=="Hired")</td><td><a class="button secondary" href="@($"/pipeline?client={Uri.EscapeDataString(client.Name)}")">Open Client Pipeline</a></td></tr>}</tbody></table>@if(clients.Count==0){<p class="empty">No Agency Clients Yet. Add A Client To Start Their Recruitment.</p>}</section>}
</div>
@code{
bool allowed;List<Client> clients=[];List<Position> positions=[];List<Assessment> applications=[];HashSet<Guid> submitted=[];
record Card(string Label,int Count,string Icon,string Tone,string Path);
IEnumerable<Card> Cards=>new Card[]{new("Active Clients",clients.Count(c=>c.Status=="Active"),"clients","icon-blue","/clients"),new("Active Client Positions",positions.Count(p=>p.Status=="Active"),"positions","icon-violet","/positions?status=Active"),new("Profiles Submitted To Clients",submitted.Count,"assessment","icon-blue","/pipeline"),new("Awaiting Client Feedback",applications.Count(a=>a.Stage=="Awaiting Client Feedback"),"clock","icon-amber","/pipeline?stage=Awaiting%20Client%20Feedback"),new("Pending Decision",applications.Count(a=>Lifecycle.Classify(a)=="Pending Decision"&&a.Stage is not("Awaiting Client Feedback" or "Awaiting Employer Review")),"clock","icon-violet","/pipeline?queue=Pending%20Decision&decisionOnly=true"),new("Upcoming Client Interviews",applications.Count(a=>a.InterviewStatus=="Scheduled"&&Lifecycle.Classify(a) is not("Hired" or "Rejected")),"clock","icon-teal","/pipeline?interview=Scheduled"),new("Rejected",applications.Count(a=>Lifecycle.Classify(a)=="Rejected"),"cancel","icon-amber","/pipeline?queue=Rejected"),new("Hold",applications.Count(a=>Lifecycle.Classify(a)=="On Hold"),"clock","icon-violet","/pipeline?queue=On%20Hold"),new("Hired For Clients",applications.Count(a=>Lifecycle.Classify(a)=="Hired"),"check","icon-teal","/pipeline?queue=Hired")};
protected override Task OnInitializedAsync(){Updates.Changed+=Changed;return Run(Load);}
async Task Load(){allowed=await Access.Can("Clients.View");if(!allowed){clients=[];positions=[];applications=[];submitted=[];Error="Agency Access Changed. Switch To Your Employer Profile.";return;}positions=await Ats.Positions();applications=(await Ats.Assessments()).Where(a=>a.State=="Saved").ToList();clients=await Workspace.Clients();var ids=applications.Select(a=>a.Id).ToHashSet();submitted=(await Review.Inbox()).Where(f=>ids.Contains(f.AssessmentId)).Select(f=>f.AssessmentId).ToHashSet();}
void Changed()=>_=InvokeAsync(async()=>{await Run(Load);StateHasChanged();});public void Dispose()=>Updates.Changed-=Changed;
}
