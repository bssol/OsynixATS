@if(Application.AutoAssessmentStatus=="Pending"){<div class="notice" role="status">Automatic Assessment In Progress. The ATS Rating And Profile Will Update When Processing Completes.</div>}
else if(Application.AutoAssessmentStatus=="Failed"){<div class="error" role="alert"><b>Automatic Assessment Needs Review</b><p>@Application.AutoAssessmentError</p></div>}
<div class="kpis assessment-metric-cards"><div class="kpi"><span>ATS Match</span><strong class="@(Application.MatchPercent is null?"small-value":"")">@Metric(Application.MatchPercent,"%")</strong></div><div class="kpi"><span>Must-Have Fit</span><strong class="small-value">@(Application.MustHaveFit.Length>0?Application.MustHaveFit:"Unavailable")</strong></div><div class="kpi"><span>Core Role Fit</span><strong class="@(Application.CoreRoleFit is null?"small-value":"")">@Metric(Application.CoreRoleFit,"/10")</strong></div><div class="kpi"><span>Evidence Strength</span><strong class="@(Application.EvidenceStrength is null?"small-value":"")">@Metric(Application.EvidenceStrength,"/10")</strong></div></div>
@code{[Parameter,EditorRequired]public Assessment Application{get;set;}=default!;static string Metric(double? value,string suffix)=>value is null?"Unavailable":$"{value:0.#}{suffix}";}
