<section class="panel candidate-cv-overview"><div class="candidate-cv-section"><h3><NavIcon Name="talent" />Professional Summary</h3><p class="preserve">@(Person.Summary.Length>0?Person.Summary:"No Professional Summary Was Provided In The Saved Profile.")</p></div>
@if(Person.CareerSummary.Length>0){<div class="candidate-cv-section"><h3>Career Summary</h3><p class="preserve">@Person.CareerSummary</p></div>}
<div class="candidate-cv-section"><h3><NavIcon Name="positions" />Professional Experience</h3>@if(Person.EmploymentHistory.Count>0){@foreach(var job in Person.EmploymentHistory.OrderBy(j=>j.SortOrder)){<article class="candidate-cv-job"><h4>@job.Designation</h4><div class="candidate-inline"><NavIcon Name="clients" /><span>@job.CompanyName</span></div><small>@Dates(job.StartDate,job.EndDate)@if(CandidateCity.FromLegacy(job.Location) is string city&&city.Length>0){<span> · @city</span>}</small></article>}}else if(Plain(Person.Employment)){<p class="preserve">@Person.Employment</p>}else{<p class="muted">No Employment History Provided.</p>}</div>
<div class="candidate-cv-section"><h3><NavIcon Name="education" />Education</h3>@if(Person.EducationHistory.Count>0){@foreach(var school in Person.EducationHistory.OrderBy(e=>e.SortOrder)){<article class="candidate-cv-job"><h4>@school.Qualification</h4><p>@school.Institution</p><small>@Dates(school.StartDate,school.EndDate)</small></article>}}else if(Plain(Person.Education)){<p class="preserve">@Person.Education</p>}else{<p class="muted">No Education Details Provided.</p>}</div>
@if(Person.Skills.Length>0){<div class="candidate-cv-section"><h3>Core Skills</h3><div class="skills">@foreach(var skill in Person.Skills.Split([',',';','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)){<span>@skill</span>}</div></div>}
<div class="candidate-cv-section candidate-specialties"><CandidateFact Icon="positions" Label="Primary Function" Value="@Person.Function" /><CandidateFact Icon="layers" Label="Specialization" Value="@Person.Specialization" /><CandidateFact Icon="clients" Label="Industry / Domains" Value="@Person.Industry" /><CandidateFact Icon="settings" Label="Systems / Tools" Value="@Person.Systems" /><CandidateFact Icon="pin" Label="Market Exposure" Value="@Person.Markets" /></div>
</section>
@code{[Parameter,EditorRequired]public Candidate Person{get;set;}=default!;static bool Plain(string value)=>!string.IsNullOrWhiteSpace(value)&&!value.TrimStart().StartsWith('[');static string Dates(string? start,string? end)=>string.IsNullOrWhiteSpace(start)&&string.IsNullOrWhiteSpace(end)?"Dates Not Provided":$"{(string.IsNullOrWhiteSpace(start)?"Not Provided":start)} – {(string.IsNullOrWhiteSpace(end)?"Not Provided":end)}";}
