@inherits PageBase
@inject WorkspaceService Workspace
<article class="candidate-position-note"><Feedback Error="@Error" Notice="@Notice" Busy="Busy" />@if(editing){<label>Edit Position Note<textarea rows="3" maxlength="10000" @bind="text" @bind:event="oninput"></textarea></label><div class="candidate-note-actions"><button disabled="@Busy" @onclick="Save">Save Note</button><button class="secondary" @onclick="()=>editing=false">Cancel</button></div>}else{<p class="preserve">@Note.Text</p>@if(CanEdit){<button class="secondary candidate-pencil" aria-label="Edit Position Note" title="Edit Position Note" @onclick="Begin"><NavIcon Name="pencil" /></button>}}<small>@Note.AuthorName · @Note.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</small></article>
@code{[Parameter,EditorRequired]public CandidateNote Note{get;set;}=default!;[Parameter]public bool CanEdit{get;set;}[Parameter]public EventCallback OnSaved{get;set;}bool editing;string text="";void Begin(){text=Note.Text;editing=true;}Task Save()=>Run(async()=>{await Workspace.EditNote(Note.Id,text);editing=false;await OnSaved.InvokeAsync();});}
