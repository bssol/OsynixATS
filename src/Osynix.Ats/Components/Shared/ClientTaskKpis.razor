@inherits PageBase
@inject RecruiterActionService Actions
@inject AtsService Ats
@inject RecruitmentUpdates Updates
@implements IDisposable
<div class="kpis client-task-kpis">@if(IncludeAwaiting){<a class="kpi" href="/pipeline?stage=Awaiting%20Client%20Feedback"><span class="kpi-icon icon-blue"><NavIcon Name="message" /></span><span>Awaiting Client Feedback</span><strong>@awaiting</strong></a>}<a class="kpi" href="@Link(null)"><span class="kpi-icon icon-amber"><NavIcon Name="flag" /></span><span>Action Required</span><strong>@Filtered.Count</strong><small>Open Tasks Assigned To You</small></a><a class="kpi" href="@Link("Arrange Interview")"><span class="kpi-icon icon-teal"><NavIcon Name="clock" /></span><span>Interviews To Arrange</span><strong>@Filtered.Count(t=>t.Action.Type=="Arrange Interview")</strong><small>Requested, Not Yet Confirmed</small></a></div>
@code{[Parameter]public bool AllWork{get;set;}[Parameter]public bool IncludeAwaiting{get;set;}[Parameter]public string ClientFilter{get;set;}="";List<RecruiterActionItem> items=[];int awaiting;List<RecruiterActionItem> Filtered=>items.Where(t=>ClientFilter.Length==0||t.Client==ClientFilter).ToList();string Link(string? type)=>"/attention?"+(AllWork?"allWork=true&":"")+(type is null?"":"type="+Uri.EscapeDataString(type)+"&")+(ClientFilter.Length==0?"":"client="+Uri.EscapeDataString(ClientFilter));protected override Task OnInitializedAsync(){Updates.Changed+=Changed;return Run(Load);}async Task Load(){items=await Actions.Inbox(false,AllWork);if(IncludeAwaiting)awaiting=(await Ats.Assessments()).Count(a=>a.State=="Saved"&&a.Stage=="Awaiting Client Feedback");}void Changed()=>_=InvokeAsync(async()=>{try{await Load();}catch(UnauthorizedAccessException){items=[];awaiting=0;}StateHasChanged();});public void Dispose()=>Updates.Changed-=Changed;}
