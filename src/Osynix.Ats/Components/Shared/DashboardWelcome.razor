@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Osynix.Ats.Data
@inject AuthenticationStateProvider Auth
@inject IDbContextFactory<AtsDbContext> Factory
@inject IJSRuntime JS
<div class="page-heading dashboard-welcome">
    <div><h1>@greeting@(!string.IsNullOrWhiteSpace(name) ? $", {name}!" : "!")</h1><p class="muted">Here’s what’s happening with your hiring today.</p></div>
    @if(clock is not null){<div class="dashboard-local-date"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" /></svg><span>@clock.Date</span></div>}
</div>
@code {
    string name = "", greeting = "Welcome Back";
    LocalClock? clock;
    protected override async Task OnInitializedAsync() {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        name = user.Identity?.Name ?? "";
        await using var db = await Factory.CreateDbContextAsync();
        var account = await db.Users.FindAsync(user.FindFirstValue(ClaimTypes.NameIdentifier));
        if(!string.IsNullOrWhiteSpace(account?.FullName)) name = account.FullName;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if(!firstRender) return;
        try {
            clock = await JS.InvokeAsync<LocalClock>("osynixLocalClock");
            greeting = clock.Hour switch { >=5 and <12 => "Good Morning", >=12 and <17 => "Good Afternoon", >=17 and <22 => "Good Evening", _ => "Good Night" };
            StateHasChanged();
        } catch(JSDisconnectedException) { }
    }
    public sealed class LocalClock { public int Hour {get;set;} public string Date {get;set;} = ""; }
}
