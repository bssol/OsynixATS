@inherits PageBase
@inject FreelancerDirectory Directory
@if(profile is not null){<section class="panel"><div class="eyebrow">GET DISCOVERED BY EMPLOYERS</div><h2>My Freelance Recruiter Profile</h2><p class="muted">Publish Your Profile To Appear In The Employer Recruiter Directory. Your Account Email, Client Data And Candidate Records Stay Private.</p><Feedback Error="@Error" Notice="@Notice" Busy="Busy" /><div class="form-grid"><label>Professional Headline<input maxlength="160" @bind="profile.Headline" placeholder="e.g. Technology Recruitment Specialist" /></label><label>Location<input maxlength="150" @bind="profile.Location" /></label><label>Recruitment Experience (Years)<input type="number" min="0" max="70" @bind="profile.YearsExperience" /></label><label>Availability<select @bind="profile.Availability"><option>Available</option><option>Limited Availability</option><option>Not Available</option></select></label></div><label>Specialisms / Industries / Skills<input maxlength="1000" @bind="profile.Skills" placeholder="e.g. Engineering, Executive Search, Healthcare" /></label><label>Professional Introduction<textarea rows="4" maxlength="3000" @bind="profile.Bio"></textarea></label><label class="check"><input type="checkbox" @bind="profile.Published" /> Make My Profile Discoverable To Employers</label><button disabled="@Busy" @onclick="Save">Save Recruiter Profile</button></section>}
@code{FreelancerProfile? profile;protected override Task OnInitializedAsync()=>Run(async()=>profile=await Directory.MyProfile());Task Save()=>Run(async()=>{await Directory.Save(profile!);profile=await Directory.MyProfile();Notice=profile!.Published?"Your Profile Is Published In The Employer Directory.":"Profile Saved. You Are Not Listed In The Directory.";});}
