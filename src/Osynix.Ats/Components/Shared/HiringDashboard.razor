



@inherits PageBase

@inject AtsService Ats

@inject WorkspaceService Workspace

@inject RecruitmentUpdates Updates

@implements IDisposable

<PageTitle>Dashboard · Osynix ATS</PageTitle>

<div class="dashboard-page">

<DashboardWelcome />


<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />

<div class="kpis"><a class="kpi" href="positions?status=Active"><span class="kpi-icon icon-violet"><NavIcon Name="positions" /></span><span>Active Positions</span><strong>@active.Count</strong></a><div class="kpi"><span class="kpi-icon icon-blue"><NavIcon Name="talent" /></span><span>Active-Position Applications</span><strong>@saved.Count</strong></div>@foreach(var q in new[]{"Shortlisted","In Interview","Pending Decision","Hired"}){<a class="kpi" href="@($"/pipeline?active=true&queue={Uri.EscapeDataString(q)}{(q=="Pending Decision"?"&decisionOnly=true":"")}")"><span class="@($"kpi-icon {KpiTone(q)}")"><NavIcon Name="@KpiIcon(q)" /></span><span>@q</span><strong>@saved.Count(x=>Lifecycle.Classify(x)==q&&(q!="Pending Decision"||x.Stage!="Awaiting Client Feedback"))</strong></a>}</div>

<div class="dashboard-charts">

    <section class="panel chart-panel">

        <div class="chart-heading"><div><div class="eyebrow">APPLICATION STAGES</div><h2>Hiring Funnel</h2></div><span class="chart-total">@saved.Count applications</span></div>

        <p class="chart-caption">Current stage distribution for active positions.</p>

        @if(saved.Count==0){<div class="chart-empty">Stage counts will appear once applications are screened.</div>}

        else {

            var stages = saved.GroupBy(x=>x.Stage).OrderBy(x=>Array.IndexOf(Choices.Stages,x.Key)).ToList();

            var maximum = stages.Max(x=>x.Count());

            <div class="vertical-chart" aria-label="Applications by hiring stage">

                @foreach(var group in stages){

                    <a class="chart-column" href="@($"/pipeline?active=true&stage={Uri.EscapeDataString(group.Key)}")" aria-label="@($"{group.Key}: {group.Count()} applications")">

                        <div class="column-track"><div class="column-bar" style="@($"--bar-height:{100d*group.Count()/maximum:0.##}%")"><b>@group.Count()</b></div></div>

                        <span>@group.Key</span>

                    </a>

                }

            </div>

        }

    </section>

    <section class="panel chart-panel">

        <div class="chart-heading"><div><div class="eyebrow">ASSESSMENT OUTCOMES</div><h2>AI Decision Mix</h2></div><span class="chart-total">@saved.Count assessed</span></div>

        <p class="chart-caption">Share of saved assessments by AI decision.</p>

        @if(saved.Count==0){<div class="chart-empty">Decision distribution will appear after assessments are saved.</div>}

        else {

            <div class="decision-pie-layout">

                <div class="decision-pie" style="@($"background:conic-gradient({PieGradient()})")" role="img" aria-label="@string.Join(", ", saved.GroupBy(x=>x.Decision).Select(g=>$"{g.Key}: {g.Count()}"))"><div class="pie-center"><strong>@saved.Count</strong><small>Total</small></div></div>

                <div class="decision-legend">

                    @foreach(var group in saved.GroupBy(x=>x.Decision).OrderByDescending(x=>x.Count())){

                        <div class="decision-legend-row"><span class="@($"legend-dot {DecisionColor(group.Key)}")"></span><span>@group.Key</span><strong>@group.Count()</strong><span class="decision-percent">@((100d*group.Count()/saved.Count).ToString("0.#"))%</span></div>

                    }

                </div>

            </div>

        }

    </section>

    <section class="panel recent-activity-panel">

        <div class="section-heading"><h2>Recent Activity</h2><a class="small" href="/activity">View All</a></div>

        @if(events.Count==0){<p class="empty">No Candidate Activity Recorded Yet.</p>}

        @foreach(var activity in events){var item = activity.Event;

            <div class="activity-item"><span class="@($"activity-icon {ActivityTone(item.Action)}")"><NavIcon Name="@ActivityIcon(item.Action)" /></span><div><b>@activity.CandidateName</b><small>@item.Action

@if(!string.IsNullOrWhiteSpace(activity.Role)){<span> · @activity.Role</span>}</small>@if(item.CandidateId is not null){<a class="small" href="@($"/candidates?id={item.CandidateId}")">View candidate</a>}</div><small class="activity-time">@Ago(item.CreatedUtc)</small></div>

        }

    </section>

</div>



<section class="panel table-wrap"><h2>Hiring Activity By Client</h2><table><thead><tr><th>Client</th><th>Active Positions</th><th>Applications</th><th>Shortlisted</th><th>Interviews</th><th>Offers</th><th>Hired</th></tr></thead><tbody>@foreach(var g in active.GroupBy(x=>x.Client)){var ids=g.Select(x=>x.Id).ToHashSet();var applications=saved.Where(x=>ids.Contains(x.PositionId)).ToList();<tr><td>@g.Key</td><td>@g.Count()</td><td>@applications.Count</td><td>@applications.Count(x=>Lifecycle.Classify(x)=="Shortlisted")</td><td>@applications.Count(x=>Lifecycle.Classify(x)=="In Interview")</td><td>@applications.Count(x=>x.Stage=="Offer Sent")</td><td>@applications.Count(x=>Lifecycle.Classify(x)=="Hired")</td></tr>}</tbody></table></section>

<div class="two-col"><section class="panel"><h2>Active Positions</h2>@foreach(var p in active.OrderBy(x=>Array.IndexOf(Choices.Priorities,x.Priority))){<a class="recent" href="@($"/positions?ref={p.Reference}")"><span><b>#@p.Reference — @p.Title</b><small>@p.Client · @p.Priority · Target @p.HiringTarget</small></span><b>@saved.Count(x=>x.PositionId==p.Id) screened</b></a>}</section><section class="panel upcoming-interviews">

    <div class="section-heading"><h2>Upcoming Interviews</h2><a class="small" href="/pipeline?active=true&amp;interview=Scheduled">View All</a></div>

    @if(!saved.Any(x=>x.InterviewStatus=="Scheduled")){<p class="empty">No interviews marked as scheduled.</p>}

    @foreach(var a in saved.Where(x=>x.InterviewStatus=="Scheduled").OrderByDescending(x=>x.UpdatedUtc).Take(4)){

        <div class="interview-row"><div class="interview-time"><b>@(a.InterviewDateTimeUtc is DateTime interviewDate?InterviewService.When(interviewDate,a.InterviewTimeZone):"Time not set")</b><small>@(string.IsNullOrWhiteSpace(a.InterviewTimeZone)?"Scheduled manually":a.InterviewTimeZone)</small></div><span class="candidate-initials">@Initials(a.CandidateName)</span><div class="interview-person"><b>@a.CandidateName</b><small>@a.Position?.Title · Awaiting candidate response outside ATS</small></div><span class="interview-stage">Scheduled</span><a class="button secondary interview-view" href="@($"/candidates?id={a.CandidateId}")">View</a></div>

    }

</section></div>

@if(active.Count==0){<p class="empty">Create or import positions to begin.</p>}

</div>

@code{

string KpiIcon(string queue)=>queue switch { "Shortlisted"=>"check", "In Interview"=>"clock", "Hired"=>"talent", _=>"assessment" };

string KpiTone(string queue)=>queue switch { "Shortlisted"=>"icon-teal", "In Interview"=>"icon-violet", "Hired"=>"icon-blue", _=>"icon-amber" };

string ActivityIcon(string action)=>action.Contains("Note",StringComparison.OrdinalIgnoreCase)?"message":action.Contains("Position",StringComparison.OrdinalIgnoreCase)?"positions":"assessment";

string ActivityTone(string action)=>action.Contains("Note",StringComparison.OrdinalIgnoreCase)?"icon-violet":action.Contains("Position",StringComparison.OrdinalIgnoreCase)?"icon-teal":"icon-blue";

string Initials(string name)=>string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0])));

string Ago(DateTime utc){var elapsed=DateTime.UtcNow-utc;return elapsed.TotalMinutes<1?"Just now":elapsed.TotalHours<1?$"{(int)elapsed.TotalMinutes}m ago":elapsed.TotalDays<1?$"{(int)elapsed.TotalHours}h ago":$"{(int)elapsed.TotalDays}d ago";}

string PieGradient(){

    var stops=new List<string>(); double current=0;

    foreach(var g in saved.GroupBy(x=>x.Decision).OrderByDescending(x=>x.Count())){

        var end=current+100d*g.Count()/saved.Count;

        var color=DecisionColor(g.Key) switch {"mix-blue"=>"#175aff","mix-teal"=>"#17a38d","mix-amber"=>"#eba52b","mix-rose"=>"#df658a","mix-violet"=>"#7763cc",_=>"#8b99b1"};

        stops.Add(FormattableString.Invariant($"{color} {current:0.####}% {end:0.####}%")); current=end;

    }

    return string.Join(", ",stops);

}



string DecisionColor(string decision)=>decision switch {

    "Priority Shortlist"=>"mix-blue", "Shortlist"=>"mix-teal", "Consider"=>"mix-amber", "Hold"=>"mix-violet", "Reject"=>"mix-rose", _=>"mix-slate"

};

List<CandidateActivity> events=[];

List<Position> active=[];List<Assessment> saved=[];

protected override Task OnInitializedAsync(){Updates.Changed+=OnChange;return Run(Load);}

void OnChange()=>_=InvokeAsync(async()=>{try{await Load();StateHasChanged();}catch{Error="Reload the dashboard to check your current access.";StateHasChanged();}});

public void Dispose()=>Updates.Changed-=OnChange;

async Task Load(){events=await Workspace.RecentActivity();active=(await Ats.Positions()).Where(x=>x.Status=="Active").ToList();var ids=active.Select(x=>x.Id).ToHashSet();saved=(await Ats.Assessments()).Where(x=>x.State=="Saved"&&ids.Contains(x.PositionId)).ToList();}

}
