@inject MarketplaceMessages MarketplaceInbox
@inject SupportInboxService SupportInbox
@inject HiringReviewService Review
@inject RecruitmentUpdates Updates
@inject AuthenticationStateProvider Auth
@implements IDisposable
<NavLink href="/messages" title="Messages"><NavIcon Name="message" /><span>Messages @if(unread>0){<span class="message-nav-badge" aria-label="@($"{unread} unread messages")" aria-live="polite">@unread</span>}</span></NavLink>
@code{
    int unread;
    protected override async Task OnInitializedAsync(){Updates.Changed+=Changed;await Load();}
    async Task Load(){var principal=(await Auth.GetAuthenticationStateAsync()).User;var total=0;try{total+=await SupportInbox.Unread();}catch(UnauthorizedAccessException){}if(principal.IsInRole("Employer")||principal.IsInRole("Recruiter")){try{total+=await MarketplaceInbox.Unread();}catch(UnauthorizedAccessException){}}if(principal.IsInRole("Employer")||principal.IsInRole("Recruiter")||principal.IsInRole("Admin")){try{total+=(await Review.PortalInbox()).Sum(m=>m.Unread);}catch(UnauthorizedAccessException){}}unread=total;}
    void Changed()=>_=InvokeAsync(async()=>{await Load();StateHasChanged();});
    public void Dispose()=>Updates.Changed-=Changed;
}
