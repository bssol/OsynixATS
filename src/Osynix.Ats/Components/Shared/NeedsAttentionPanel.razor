@inherits PageBase
@inject RecruiterActionService Actions
@inject HiringReviewService Review
@inject RecruitmentUpdates Updates
@inject Access Access
@implements IDisposable
<section class="panel recruiter-attention"><div class="section-heading"><div><h2>@(TeamView?"Outstanding Team Tasks":"Outstanding Tasks") (@Filtered.Count)</h2><p class="muted small">Review Candidate Responses, Respond To Information Requests Or Arrange Interviews. Other Feedback Appears In Notifications.</p></div>@if(!Expanded){<a href="@(AllWork?"/attention?allWork=true":"/attention")">View All</a>}</div><Feedback Error="@Error" Notice="@Notice" Busy="Busy" />@if(Expanded){<div class="toolbar"><input aria-label="Search Client Tasks" placeholder="Search client, candidate or position…" @bind="search" @bind:event="oninput" /><select aria-label="Task Type" @bind="type"><option value="">All Tasks</option><option>Respond To Client</option><option>Arrange Interview</option><option>Review Interview Response</option><option>Finalize Hiring</option><option>Send Offer</option></select>@if(TeamView){<label class="check"><input type="checkbox" @bind="mineOnly" @bind:after="Refresh" /> Only My Tasks</label>}</div>}
@foreach(var item in Filtered.Take(Expanded?int.MaxValue:5)){<article class="attention-task"><div><span class="badge @(item.Action.Type=="Arrange Interview"?"yellow":"green")">@item.Action.Type</span><h3>@item.Action.Title</h3><b>@item.Candidate</b><p class="muted">@item.Client · @item.Position · #@item.Reference</p><small>@item.Action.FeedbackUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") · Assigned To @(item.Mine?"You":item.AssignedTo)</small><p class="preserve">@item.Action.Remarks</p></div><div class="pipeline-submit-actions">@if(item.WorkspaceId is Guid wid&&!admin){<WorkOpenButton WorkspaceId="wid" Mode="@(item.Agency?"Agency":"Employer")" Path="@(AllWork?$"/attention?task={item.Action.Id}":$"/pipeline?ref={Uri.EscapeDataString(item.Reference)}&application={item.Action.AssessmentId}")" Text="@(AllWork?"Open Task":"Open Application")" />}else{<a class="button secondary" href="@($"/pipeline?ref={Uri.EscapeDataString(item.Reference)}&application={item.Action.AssessmentId}")">Open Application</a>}@if(!AllWork&&item.Action.Type=="Respond To Client"){<button class="secondary" @onclick="()=>selected=item">Respond To Client</button>}</div></article>}
@if(Filtered.Count==0){<p class="empty">No Outstanding Tasks In This View.</p>}
@if(selected is not null){<section class="client-response-editor"><h3>Response For @selected.Candidate</h3><p class="muted">Your Response Is Visible To The Client. Candidate Contact Details Are Removed Automatically.</p><label>Client Response<textarea rows="4" maxlength="5000" @bind="response"></textarea></label><button disabled="@Busy" @onclick="Send">Send Response For Review</button><button class="secondary" @onclick="()=>selected=null">Cancel</button></section>}
</section>
@code{[Parameter]public bool TeamView{get;set;}[Parameter]public bool Expanded{get;set;}[Parameter]public bool AllWork{get;set;}[Parameter]public string ClientFilter{get;set;}="";[Parameter]public string? InitialType{get;set;}[Parameter]public Guid? TaskId{get;set;}List<RecruiterActionItem> items=[];RecruiterActionItem? selected;bool mineOnly,admin;string search="",type="",response="";List<RecruiterActionItem> Filtered=>items.Where(t=>(ClientFilter.Length==0||t.Client==ClientFilter)&&(type.Length==0||t.Action.Type==type)&&$"{t.Client} {t.Candidate} {t.Position} {t.Action.Title}".Contains(search,StringComparison.OrdinalIgnoreCase)).ToList();protected override Task OnInitializedAsync(){type=InitialType??"";Updates.Changed+=Changed;return Run(Load);}async Task Load(){admin=(await Access.Require()).IsInRole("Admin");items=await Actions.Inbox(TeamView&&!mineOnly,AllWork);if(selected is not null&&!items.Any(t=>t.Action.Id==selected.Action.Id&&t.Action.Revision==selected.Action.Revision))selected=null;if(!AllWork&&TaskId.HasValue&&selected is null)selected=items.FirstOrDefault(t=>t.Action.Id==TaskId&&t.Action.Type=="Respond To Client");}Task Refresh()=>Run(Load);Task Acknowledge(RecruiterActionItem item)=>Run(async()=>{await Actions.Acknowledge(item.Action.Id,item.Action.Revision);await Load();Notice="Feedback Marked As Reviewed.";});Task Send()=>Run(async()=>{await Review.RespondToInformation(selected!.Action.Id,selected.Action.Revision,response);selected=null;response="";await Load();Notice="Response Sent. The Application Is Awaiting Client Feedback Again.";});void Changed()=>_=InvokeAsync(async()=>{try{await Load();}catch(UnauthorizedAccessException){items=[];selected=null;}StateHasChanged();});public void Dispose()=>Updates.Changed-=Changed;}
