@inherits PageBase
@inject InterviewService Interviews
@inject HiringReviewService Review
@inject RecruiterActionService Actions
@inject AtsService Ats
@inject IJSRuntime JS
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<p class="muted">@Application.Position?.Title · @Application.Position?.Client</p>
@if(booking is not null){<section class="panel interview-booking"><div class="section-heading"><h3>Interview · @booking.Status</h3><span class="badge">@booking.Mode</span></div><p>@InterviewService.When(booking.StartUtc,booking.TimeZone) · @booking.DurationMinutes Minutes</p>@if(booking.Mode=="Online"){<a href="@booking.MeetingLink" target="_blank" rel="noopener noreferrer">Open Meeting Link</a>}else{<p class="preserve">@booking.Location</p>}@if(booking.ProposedStartUtc is DateTime proposed){<p><b>Candidate Proposed:</b> @InterviewService.When(proposed,booking.ProposedTimeZone)</p><p class="muted">Waiting For Hiring Manager Approval Through The Review Link.</p>}@if(booking.ResponseSource.Length>0){<p>@booking.ResponseSource · @booking.ResponseNotes</p>}<p class="muted small">@delivery</p>@if(delivery!="Email Sent"){<button class="secondary" disabled="@Busy" @onclick="Retry">Retry Unsent Emails</button>}@if(!Terminal&&booking.Status is not("Completed" or "Cancelled")){<div class="pipeline-submit-actions"><button class="secondary" disabled="@Busy" @onclick="CopyResponseLink">Copy Candidate Response Link</button>@if(booking.Status is "Awaiting Confirmation" or "Confirmed"){<button class="secondary" @onclick="()=>recording=!recording">Record External Response</button>}</div>}</section>}
@if(!Terminal){
<div class="pipeline-submit-actions workflow-actions">@if(Application.Stage is not("Information Requested" or "Offer Requested" or "Offer Sent")){<button disabled="@Busy" @onclick="OpenInvite">@(booking?.Status=="Completed"?"Invite To Next Round":booking is null||booking.Status is "Cancelled" or "Declined"?"Invite To Interview":"Edit / Resend Invitation")</button>}<button class="secondary" @onclick="OpenOutcome">@(Application.Stage=="Offer Sent"?"Record Final Decision":Application.Stage=="Offer Requested"?"Record Offer Progress":"Update Outcome")</button></div>
@if(Application.Stage=="Information Requested"&&informationTask is not null){<section class="panel"><h3>Information Requested</h3><p>@informationTask.Action.Remarks</p><label>Response To Hiring Manager<textarea rows="4" maxlength="5000" @bind="clientResponse" @bind:event="oninput"></textarea></label><button disabled="@Busy" @onclick="RespondToClient">Send Response</button></section>}
@if(inviting){<section class="panel"><h3>Review Interview Invitation</h3><p class="muted small">Paste A Meeting Link From Your Own Google Meet, Teams, Zoom Or Other Account. Provider Connections Will Be Added Separately.</p><div class="form-grid"><label>Candidate Email<input type="email" maxlength="320" @bind="candidateEmail" @bind:event="oninput" /></label><label>Hiring Manager Email (Optional)<input type="email" maxlength="320" @bind="managerEmail" @bind:event="oninput" /></label><label>Interview Format<select @bind="mode"><option>Online</option><option>On-Site</option></select></label><label>Duration (Minutes)<input type="number" min="15" max="240" @bind="duration" @bind:event="oninput" /></label><label>Date And Time<input type="datetime-local" value="@localStart" @oninput="e=>localStart=e.Value?.ToString()??string.Empty" /></label><label>Time Zone<input list="interview-zones" @bind="zone" @bind:event="oninput" maxlength="100" /><datalist id="interview-zones"><option>Asia/Karachi</option><option>UTC</option><option>Europe/London</option><option>Asia/Dubai</option><option>America/New_York</option></datalist></label></div>@if(mode=="Online"){<label>Meeting Provider<select @bind="provider"><option>Manual Link</option><option>Google Meet</option><option>Microsoft Teams</option><option>Zoom</option></select></label><label>Meeting Link<input type="url" maxlength="2000" @bind="meetingLink" @bind:event="oninput" placeholder="https://…" /></label>}else{<label>On-Site Address / Map Link / Arrival Instructions<textarea maxlength="1000" @bind="location" rows="3"></textarea></label>}<label>Invitation Message<textarea rows="6" maxlength="5000" @bind="message" @bind:event="oninput"></textarea></label><p class="muted small">The Confirm / Decline / Propose New Time Link Is Added Automatically. Times And Joining Details Appear Separately In The Email.</p>@if(!Interviews.CanEmail){<p class="muted">Email Requires A Public HTTPS Address And Working Email Settings. You Can Save The Invitation And Copy Its Response Link For Local Testing.</p>}<button disabled="@Busy" @onclick="SendInvite">@(Interviews.CanEmail?"Send Interview Invitation":"Save Invitation For Testing")</button><button class="secondary" @onclick="()=>inviting=false">Cancel</button></section>}
@if(recording&&booking is not null){<section class="panel"><h3>Record A Response Received Outside ATS</h3><label>Received Through<select @bind="channel"><option>Phone</option><option>WhatsApp</option><option>Email</option><option>Other</option></select></label><label>Candidate Response<select @bind="response"><option value="Accepted">Accepted</option><option>Declined</option><option>New Time Proposed</option></select></label>@if(response=="New Time Proposed"){<label>Proposed Date And Time<input type="datetime-local" value="@proposedStart" @oninput="e=>proposedStart=e.Value?.ToString()??string.Empty" /></label><label>Time Zone<input @bind="proposedZone" @bind:event="oninput" /></label>}<label>Notes<textarea maxlength="2000" rows="3" @bind="responseNotes" @bind:event="oninput"></textarea></label><button disabled="@Busy" @onclick="Record">Record Response</button></section>}
@if(showOutcome){<section class="panel"><h3>@(Application.Stage=="Offer Sent"?"Record Final Decision":"Update Outcome")</h3>@if(Application.Stage=="Offer Sent"){<p class="muted">The Offer Is Sent. This Candidate Remains In The Pipeline Until Hired Or Rejected.</p>}<label>Next Step<select @bind="outcome"><option value="">Choose Outcome</option>@if(Application.Stage!="Offer Sent"){<option value="Interview Completed">Interview Completed — Request Feedback</option><option value="Next Round">Arrange Another Interview Round</option><option>Hold</option><option>Offer Sent</option>}<option value="Reject">Rejected — Close Application</option><option>Hired</option></select></label><label>Internal Notes<textarea rows="3" maxlength="5000" @bind="notes" @bind:event="oninput"></textarea></label><p class="muted small">@(Application.Stage=="Offer Sent"?"Record Hired Or Rejected Only When The Final Decision Is Confirmed. Until Then, Leave The Application In Offer Sent.":"Reject Closes This Application And Removes It From The Active Client Review. Hold Keeps It Visible.")</p><button disabled="@(Busy||outcome.Length==0)" @onclick="SaveOutcome">Save Outcome</button></section>}
}else{<p class="muted">This Application Or Its Position Is Closed For Further Actions.</p>@if(Application.Stage=="Rejected"&&Application.Position?.Status is "Active" or "On Hold"){<button class="secondary" disabled="@Busy" @onclick="Reopen">Reopen For Deliberate Resubmission</button>}}
@code{
[Parameter,EditorRequired]public Assessment Application{get;set;}=default!;
[Parameter]public EventCallback OnSaved{get;set;}
InterviewBooking? booking;RecruiterActionItem? informationTask;bool inviting,recording,showOutcome;string delivery="",candidateEmail="",managerEmail="",localStart="",zone="UTC",mode="Online",provider="Manual Link",meetingLink="",location="",message="",response="Accepted",channel="Phone",proposedStart="",proposedZone="UTC",responseNotes="",outcome="",notes="",clientResponse="";int duration=30;
bool Terminal=>Application.Stage is "Rejected" or "Hired"||Application.ClientStatus=="Hired"||Application.Position?.Status is not("Active" or "On Hold");
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load(){booking=await Interviews.Details(Application.Id);delivery=booking is null?"":await Interviews.DeliveryStatus(booking.Id);informationTask=(await Actions.Inbox(true)).FirstOrDefault(t=>t.Action.AssessmentId==Application.Id&&t.Action.Type=="Respond To Client");notes=Application.RecruiterNotes;}
Task OpenInvite()=>Run(async()=>{await Load();var candidate=Application.CandidateId is Guid cid?(await Ats.Candidates()).FirstOrDefault(c=>c.Id==cid):null;candidateEmail=booking?.CandidateEmail??candidate?.Email??"";managerEmail=booking?.ManagerEmail??await Interviews.DefaultManagerEmail(Application.Id);var feedback=(await Review.Inbox()).FirstOrDefault(f=>f.AssessmentId==Application.Id);var start=booking?.Status=="Completed"?null:booking?.StartUtc??feedback?.AvailabilityStartUtc;zone=booking?.TimeZone??feedback?.TimeZone??"UTC";if(zone.Length==0)zone="UTC";localStart=start.HasValue?TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(start.Value,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById(zone)).ToString("yyyy-MM-ddTHH:mm"):"";duration=booking?.DurationMinutes??feedback?.DurationMinutes??30;mode=booking?.Mode??feedback?.Mode??"Online";if(mode.Length==0)mode="Online";provider=booking?.Provider is "Google Meet" or "Microsoft Teams" or "Zoom"?booking.Provider:"Manual Link";meetingLink=booking?.MeetingLink??"";location=booking?.Location??feedback?.Location??"";message=$"Hello {Application.CandidateName},\n\nYou Are Invited To Interview For {Application.Position?.Title} With {Application.Position?.Client}.\nPlease Review The Schedule And Joining Details Below, Then Confirm Your Availability, Decline Or Propose Another Time Using The Response Link.\n\nWe Look Forward To Speaking With You.";inviting=true;recording=showOutcome=false;});
Task SendInvite()=>Run(async()=>{var r=await Interviews.Invite(new(Application.Id,Application.Revision,booking?.Id,booking?.Revision,candidateEmail,managerEmail,localStart,zone,duration,mode,provider,meetingLink,location,message));Notice=r.Message;inviting=false;await OnSaved.InvokeAsync();});
Task Record()=>Run(async()=>{await Interviews.RecordResponse(new(booking!.Id,booking.Revision,response,responseNotes,proposedStart,proposedZone),channel);recording=false;await OnSaved.InvokeAsync();});
void OpenOutcome(){showOutcome=!showOutcome;if(Application.Stage=="Offer Requested")outcome="Offer Sent";}
Task SaveOutcome()=>Run(async()=>{await Interviews.Progress(Application.Id,Application.Revision,outcome,notes);await OnSaved.InvokeAsync();});
Task RespondToClient()=>Run(async()=>{await Review.RespondToInformation(informationTask!.Action.Id,informationTask.Action.Revision,clientResponse);await OnSaved.InvokeAsync();});
Task Retry()=>Run(async()=>{Notice=await Interviews.RetryDelivery(booking!.Id);await Load();});
Task CopyResponseLink()=>Run(async()=>{var link=await Interviews.ResponseLink(booking!.Id);var copied=await JS.InvokeAsync<bool>("osynixCopyReviewLink",link);Notice=copied?"Candidate Response Link Copied.":link;});
Task Reopen()=>Run(async()=>{await Interviews.Reopen(Application.Id,Application.Revision);await OnSaved.InvokeAsync();});
}
