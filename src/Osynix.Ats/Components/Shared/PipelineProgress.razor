@inherits PageBase
@inject InterviewService Interviews
@inject HiringReviewService Review
@inject RecruiterActionService Actions
@inject AtsService Ats
@inject IJSRuntime JS
<div class="progress-pane">
<div class="progress-context"><div><b>@Application.Position?.Title</b><span>@Application.Position?.Client · @Application.Stage</span></div><span class="pp-badge">@(permission.Invitations?"Online interviews included":"Manual updates only")</span></div>
<div class="progress-body">
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<nav class="progress-steps" aria-label="Recruitment action steps"><button class="@(view=="summary"?"selected":"")" @onclick='()=>SetView("summary")'>1 · Overview</button>@if(inviting){<button class="@(view=="interview"?"selected":"")" @onclick='()=>SetView("interview")'>2 · @(permission.Invitations?"Interview":"Recruitment update")</button>@if(permission.Invitations){<button class="@(view=="review"?"selected":"")" disabled="@(view!="review")">3 · Review &amp; send</button>}}else if(view!="summary"){<span>@ViewTitle</span>}</nav>
@if(view=="summary"){
@if(feedback.Count>0){var latest=feedback[0];<section class="request-summary"><div><b>@latest.Feedback</b><span class="muted small">@latest.ContactName</span></div><p class="preserve">@(string.IsNullOrWhiteSpace(latest.Remarks)?"Review the requested next step and update this application.":latest.Remarks)</p>@if(latest.AvailabilityStartUtc is DateTime proposed){<small>Suggested: @InterviewService.When(proposed,latest.TimeZone) · @latest.DurationMinutes minutes · @latest.Mode</small>}</section><details><summary>Request history &amp; sharing</summary>@foreach(var item in feedback){<div class="history-entry"><b>@item.ContactName · @item.Feedback</b><p>@item.Remarks</p><button class="pp-button" disabled="@Busy" @onclick="()=>RevokeShare(item.Id)">Revoke profile sharing</button></div>}</details>}
@if(booking is not null){<section class="booking-summary"><div class="pp-row"><h3>Interview</h3><span class="pp-badge">@booking.Status</span></div><p>@InterviewService.When(booking.StartUtc,booking.TimeZone) · @booking.DurationMinutes minutes</p>@if(booking.Mode=="Online"){<a href="@booking.MeetingLink" target="_blank" rel="noopener noreferrer">Open meeting link</a>}else{<p>@booking.Location</p>}@if(booking.ProposedStartUtc is DateTime proposed){<p><b>Proposed time:</b> @InterviewService.When(proposed,booking.ProposedTimeZone)</p><small>Awaiting hiring manager approval through the review link.</small>}<p>@booking.ResponseNotes</p><small>@delivery</small><div class="pp-row">@if(permission.Invitations&&delivery!="Email Sent"){<button class="pp-button" disabled="@Busy" @onclick="Retry">Retry email</button>}@if(permission.Invitations&&!Terminal){<button class="pp-button" disabled="@Busy" @onclick="CopyResponseLink">Copy response link</button>}@if(!Terminal&&booking.Status is "Awaiting Confirmation" or "Confirmed"){<button class="pp-button" @onclick='()=>SetView("response")'>Record external response</button>}</div></section>}else if(Application.InterviewStatus.Length>0&&Application.InterviewStatus!="Not Scheduled"){<section class="booking-summary"><div class="pp-row"><h3>Interview update</h3><span class="pp-badge">@Application.InterviewStatus</span></div>@if(Application.InterviewDateTimeUtc is DateTime manualDate&&!string.IsNullOrWhiteSpace(Application.InterviewTimeZone)){<p>@InterviewService.When(manualDate,Application.InterviewTimeZone)</p>}</section>}
@if(!Terminal){<div class="pp-row"><button class="pp-button" @onclick="OpenOutcome">@(Application.Stage=="Offer Sent"?"Record final decision":"Update outcome")</button>@if(Application.Stage=="Information Requested"&&informationTask is not null){<button class="pp-button" @onclick='()=>SetView("information")'>Respond to request</button>}</div>}
else{<section class="request-summary"><b>Outcome: @Application.Stage</b><p class="preserve">@Application.RecruiterNotes</p><small>Interview status: @Application.InterviewStatus</small></section><p class="muted">This application or its position is closed for further actions.</p>@if(Application.Stage=="Rejected"&&Application.Position?.Status is "Active" or "On Hold"){<button class="pp-button" disabled="@Busy" @onclick="Reopen">Reopen for deliberate resubmission</button>}}
}else if(view=="interview"){
@if(permission.Invitations){
<h3>Interview details</h3><div class="pp-grid"><label>Date and time<input type="datetime-local" value="@localStart" @onchange="e=>localStart=e.Value?.ToString()??string.Empty" /></label><label>Duration<select @bind="duration"><option value="15">15 minutes</option><option value="30">30 minutes</option><option value="45">45 minutes</option><option value="60">60 minutes</option><option value="90">90 minutes</option><option value="120">120 minutes</option><option value="180">180 minutes</option><option value="240">240 minutes</option></select></label><label>Time zone<select @bind="zone">@foreach(var tz in Zones){<option value="@tz.Id">@InterviewService.ZoneLabel(tz,localStart)</option>}</select></label><label>Candidate email<input type="email" maxlength="320" @bind="candidateEmail" /></label></div>
<label>Interview format</label><div class="pp-row pp-format"><button class="pp-button @(mode=="Online"?"selected":"")" aria-pressed="@(mode=="Online")" @onclick='()=>mode="Online"'><NavIcon Name="video" />Online</button><button class="pp-button @(mode=="On-Site"?"selected":"")" aria-pressed='@(mode=="On-Site")' @onclick='()=>mode="On-Site"'><NavIcon Name="pin" />On-site</button></div>
@if(mode=="Online"){@if(permission.Integrations){<label>Meeting provider · your account</label><div class="provider-grid">@foreach(var name in new[]{"Google Meet","Zoom","Microsoft Teams","Manual Link"}){<button class="provider-tile @(provider==name?"selected":"")" aria-pressed="@(provider==name)" @onclick="()=>SelectProvider(name)"><span class="provider-brand @(name=="Zoom"?"zoom":name=="Microsoft Teams"?"teams":name=="Google Meet"?"google":"")">@(name=="Zoom"?"zoom":name=="Microsoft Teams"?"T":name=="Google Meet"?"Meet":"↗")</span><span>@name</span></button>}</div><label>Meeting link<input type="url" maxlength="2000" @bind="meetingLink" placeholder="https://…" /></label>}else{<div class="pp-notice"><b>Online meetings need integration access</b><p>Upgrade the workspace plan to use online meeting providers or add a manual meeting link.</p><a href="/employer/subscriptions">Upgrade for online meetings</a></div>}}else{<label>Office address, map link and arrival instructions<textarea rows="3" maxlength="1000" @bind="location"></textarea></label>}
<label>Hiring manager contact<select @bind="selectedContact" @bind:after="SelectContact"><option value="">Choose another contact or enter an email</option>@foreach(var contact in contacts){<option value="@contact.Id">@contact.Name · @contact.Email</option>}</select></label><label>Hiring manager email (optional)<input type="email" maxlength="320" @bind="managerEmail" /></label><small class="muted">Auto-filled from the profile’s shared hiring contact or the client’s saved contacts. Without email, updates remain available through the review link.</small>
}else{
<h3>Update recruitment manually</h3><p class="muted small">Record interview progress without sending an invitation or candidate notification.</p><div class="pp-grid"><label>Recruitment stage<select @bind="manualStage">@foreach(var stage in Choices.Stages){<option>@stage</option>}</select></label><label>Interview status<select @bind="manualStatus">@foreach(var status in Choices.Interviews){<option>@status</option>}</select></label><label>@(manualStatus=="New Time Proposed"?"Proposed date and time":manualStatus=="Cancelled"?"Previous interview date and time":"Interview date and time")<input type="datetime-local" value="@localStart" @onchange="e=>localStart=e.Value?.ToString()??string.Empty" /></label><label>Time zone<select @bind="zone">@foreach(var tz in Zones){<option value="@tz.Id">@InterviewService.ZoneLabel(tz,localStart)</option>}</select></label></div><label>Internal notes<textarea rows="3" maxlength="5000" @bind="notes"></textarea></label><div class="pp-notice"><b>Manual update only</b><p>This plan does not include candidate invitations or email notifications. Record the interview date and status here; no invitation will be sent.</p></div>
}
}else if(view=="review"&&permission.Invitations){<h3>Review invitation</h3><div class="pp-facts"><div><small>Candidate</small><b>@candidateEmail</b></div><div><small>When</small><b>@localStart.Replace("T"," · ")</b></div><div><small>Time zone</small><b>@ZoneText</b></div><div><small>Format</small><b>@mode · @duration minutes</b></div></div>@if(mode=="Online"){<p><a href="@meetingLink" target="_blank" rel="noopener noreferrer">@meetingLink</a></p>}else{<p>@location</p>}<label>Invitation message<textarea rows="6" maxlength="5000" @bind="message"></textarea></label><div class="pp-notice"><b>Recipients</b><p>Candidate: @candidateEmail<br />Hiring manager: @(managerEmail.Length>0?managerEmail:"Shared review link only")</p><small>Accept, decline and propose-new-time buttons are added automatically. Both sides see the updated status.</small></div>@if(!Interviews.CanEmail){<p class="muted small">Email delivery needs configured email and public HTTPS. You can save the invitation and copy its response link for local testing.</p>}
}else if(view=="response"&&booking is not null){<h3>Record a response received outside ATS</h3><div class="pp-grid"><label>Received through<select @bind="channel"><option>Phone</option><option>WhatsApp</option><option>Email</option><option>Other</option></select></label><label>Candidate response<select @bind="response"><option>Accepted</option><option>Declined</option><option>New Time Proposed</option></select></label></div>@if(response=="New Time Proposed"){<label>Proposed date and time<input type="datetime-local" value="@proposedStart" @onchange="e=>proposedStart=e.Value?.ToString()??string.Empty" /></label><label>Time zone<select @bind="proposedZone">@foreach(var tz in Zones){<option value="@tz.Id">@InterviewService.ZoneLabel(tz,proposedStart)</option>}</select></label>}<label>Notes<textarea rows="3" maxlength="2000" @bind="responseNotes"></textarea></label>
}else if(view=="outcome"){<h3>@(Application.Stage=="Offer Sent"?"Record final decision":"Update outcome")</h3><label>Next step<select @bind="outcome"><option value="">Choose outcome</option>@if(Application.Stage!="Offer Sent"){@if(booking?.Status=="Confirmed"&&booking.StartUtc<=DateTime.UtcNow){<option value="Interview Completed">Interview completed — request feedback</option>}@if(booking?.Status=="Completed"){<option value="Next Round">Arrange another interview round</option>}<option>Hold</option><option>Offer Sent</option>}<option value="Reject">Rejected — close application</option><option>Hired</option></select></label><label>Internal notes<textarea rows="4" maxlength="5000" @bind="notes"></textarea></label><div class="pp-notice">Rejected closes the application. Hold keeps it available for review. Offers remain in the pipeline until hired or rejected.</div>
}else if(view=="information"&&informationTask is not null){<h3>Information requested</h3><section class="request-summary"><p>@informationTask.Action.Remarks</p></section><label>Response to hiring manager<textarea rows="5" maxlength="5000" @bind="clientResponse"></textarea></label>}
</div>
<footer class="progress-footer">@if(view=="interview"){<button class="pp-button" disabled="@Busy" @onclick='()=>SetView("summary")'>← Back</button>@if(!permission.Invitations){<button class="pp-button primary" disabled="@Busy" @onclick="SaveManual">Save recruitment update</button>}}else if(view!="summary"){<button class="pp-button" disabled="@Busy" @onclick='()=>SetView(view=="review"?"interview":"summary")'>← Back</button>}@if(view=="summary"&&!Terminal&&Application.Stage is not("Information Requested" or "Offer Requested" or "Offer Sent")){<button class="pp-button primary" disabled="@Busy" @onclick="OpenInvite">@(permission.Invitations?(booking?.Status=="Completed"?"Invite to next round":"Invite to interview →"):"Update Recruitment Manually →")</button>}else if(view=="interview"&&permission.Invitations){<button class="pp-button primary" disabled="@(Busy||mode=="Online"&&!permission.Integrations)" @onclick="PreviewInvite">Review invitation →</button>}else if(view=="review"){<button class="pp-button primary" disabled="@Busy" @onclick="SendInvite">@(Interviews.CanEmail?"Send invitation":"Save for local testing")</button>}else if(view=="outcome"){<button class="pp-button primary" disabled="@(Busy||outcome.Length==0)" @onclick="SaveOutcome">Save outcome</button>}else if(view=="response"){<button class="pp-button primary" disabled="@Busy" @onclick="Record">Record response</button>}else if(view=="information"){<button class="pp-button primary" disabled="@Busy" @onclick="RespondToClient">Send response</button>}</footer>
@if(connecting.Length>0){<div class="provider-overlay"><section role="dialog" aria-modal="true" aria-label="Connect meeting provider"><h3>Connect @connecting</h3><p>Your own account will be used to create interview meetings. The hiring manager does not need to connect an account.</p><div class="pp-notice">Provider authorization is not configured yet. For now, create a meeting in your provider account and paste its link using Manual Link.</div><button class="pp-button primary" @onclick="UseManual">Use manual link</button><button class="pp-button" @onclick='()=>connecting=""'>Close</button></section></div>}
</div>
@code{
[Parameter,EditorRequired]public Assessment Application{get;set;}=default!;
[Parameter]public EventCallback OnSaved{get;set;}
InterviewBooking? booking;RecruiterActionItem? informationTask;bool inviting,invitationPrepared;string delivery="",candidateEmail="",managerEmail="",localStart="",zone="UTC",mode="Online",provider="Manual Link",meetingLink="",location="",message="",response="Accepted",channel="Phone",proposedStart="",proposedZone="UTC",responseNotes="",outcome="",notes="",clientResponse="";int duration=30;
InterviewAccess permission=new(false,false);List<RecruiterFeedback> feedback=[];List<ClientContact> contacts=[];string view="summary",connecting="",manualStage="",manualStatus="";Guid? selectedContact;
static readonly IReadOnlyList<TimeZoneInfo> Zones=TimeZoneInfo.GetSystemTimeZones().Select(t=>TimeZoneInfo.TryConvertWindowsIdToIanaId(t.Id,out var iana)?TimeZoneInfo.FindSystemTimeZoneById(iana):t).Append(TimeZoneInfo.Utc).DistinctBy(t=>t.Id).OrderBy(t=>t.BaseUtcOffset).ThenBy(t=>t.Id).ToList();
string ZoneText=>InterviewService.ZoneLabel(TimeZoneInfo.FindSystemTimeZoneById(zone),localStart);
string ViewTitle=>view switch{"outcome"=>"Outcome","response"=>"External response","information"=>"Respond to request",_=>"Interview"};
void SetView(string value){view=value;inviting=value is "interview" or "review";}
void SelectProvider(string name){provider=name;if(name!="Manual Link")connecting=name;}
void UseManual(){provider="Manual Link";connecting="";}
void SelectContact(){managerEmail=contacts.FirstOrDefault(c=>c.Id==selectedContact)?.Email??"";}
Task PreviewInvite()=>Run(()=>{InterviewService.ParseTime(localStart,zone);if(string.IsNullOrWhiteSpace(candidateEmail))throw new InvalidOperationException("Enter the candidate email.");if(mode=="Online"&&(!Uri.TryCreate(meetingLink,UriKind.Absolute,out var url)||url.Scheme!="https"))throw new InvalidOperationException("Add a valid HTTPS meeting link.");if(mode=="On-Site"&&string.IsNullOrWhiteSpace(location))throw new InvalidOperationException("Enter the interview location.");SetView("review");return Task.CompletedTask;});
Task SaveManual()=>Run(async()=>{var draft=JsonSerializer.Deserialize<Assessment>(JsonSerializer.Serialize(Application))!;draft.Stage=manualStage;draft.InterviewStatus=manualStatus;draft.RecruiterNotes=notes;if(!permission.Invitations&&(manualStatus is "Scheduled" or "New Time Proposed")){draft.InterviewDateTimeUtc=InterviewService.ParseTime(localStart,zone);draft.InterviewTimeZone=zone;}await Ats.SaveLifecycle(draft);Notice="Recruitment stage, interview status and internal notes have been saved.";SetView("summary");await OnSaved.InvokeAsync();});
Task RevokeShare(Guid id)=>Run(async()=>{await Review.Revoke(id);await Load();await OnSaved.InvokeAsync();});
bool Terminal=>Application.Stage is "Rejected" or "Hired"||Application.ClientStatus=="Hired"||Application.Position?.Status is not("Active" or "On Hold");
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load(){booking=await Interviews.Details(Application.Id);delivery=booking is null?"":await Interviews.DeliveryStatus(booking.Id);informationTask=(await Actions.Inbox(true)).FirstOrDefault(t=>t.Action.AssessmentId==Application.Id&&t.Action.Type=="Respond To Client");notes=Application.RecruiterNotes;manualStage=Application.Stage;manualStatus=string.IsNullOrEmpty(Application.InterviewStatus)?"Not Scheduled":Application.InterviewStatus;permission=await Interviews.CommunicationAccess(Application.Id);feedback=(await Review.Inbox()).Where(f=>f.AssessmentId==Application.Id).ToList();contacts=await Interviews.ManagerContacts(Application.Id);}
Task OpenInvite()=>Run(async()=>{if(invitationPrepared){SetView("interview");return;}await Load();var candidate=permission.Invitations&&Application.CandidateId is Guid cid?(await Ats.Candidates()).FirstOrDefault(c=>c.Id==cid):null;candidateEmail=booking?.CandidateEmail??candidate?.Email??"";managerEmail=!string.IsNullOrWhiteSpace(booking?.ManagerEmail)?booking.ManagerEmail:await Interviews.DefaultManagerEmail(Application.Id);var feedback=(await Review.Inbox()).FirstOrDefault(f=>f.AssessmentId==Application.Id);var start=permission.Invitations?(booking?.Status=="Completed"?null:booking?.StartUtc??feedback?.AvailabilityStartUtc):Application.InterviewDateTimeUtc;zone=permission.Invitations?booking?.TimeZone??feedback?.TimeZone??"UTC":Application.InterviewTimeZone.Length>0?Application.InterviewTimeZone:"UTC";if(zone.Length==0)zone="UTC";if(TimeZoneInfo.TryConvertWindowsIdToIanaId(zone,out var iana))zone=iana;localStart=start.HasValue?TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(start.Value,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById(zone)).ToString("yyyy-MM-ddTHH:mm"):"";duration=booking?.DurationMinutes??feedback?.DurationMinutes??30;mode=booking?.Mode??feedback?.Mode??"Online";if(mode.Length==0)mode="Online";if(!permission.Integrations&&mode=="Online")mode="On-Site";provider=booking?.Provider is "Google Meet" or "Microsoft Teams" or "Zoom"?booking.Provider:"Manual Link";meetingLink=booking?.MeetingLink??"";location=booking?.Location??feedback?.Location??"";message=$"Hello {Application.CandidateName},\n\nYou Are Invited To Interview For {Application.Position?.Title} With {Application.Position?.Client}.\nPlease Review The Schedule And Joining Details Below, Then Confirm Your Availability, Decline Or Propose Another Time Using The Response Link.\n\nWe Look Forward To Speaking With You.";selectedContact=contacts.FirstOrDefault(c=>c.Email.Equals(managerEmail,StringComparison.OrdinalIgnoreCase))?.Id;invitationPrepared=true;SetView("interview");});
Task SendInvite()=>Run(async()=>{var r=await Interviews.Invite(new(Application.Id,Application.Revision,booking?.Id,booking?.Revision,candidateEmail,managerEmail,localStart,zone,duration,mode,provider,meetingLink,location,message));Notice=r.Message;SetView("summary");await OnSaved.InvokeAsync();});
Task Record()=>Run(async()=>{await Interviews.RecordResponse(new(booking!.Id,booking.Revision,response,responseNotes,proposedStart,proposedZone),channel);SetView("summary");await OnSaved.InvokeAsync();});
void OpenOutcome(){SetView("outcome");if(Application.Stage=="Offer Requested")outcome="Offer Sent";}
Task SaveOutcome()=>Run(async()=>{await Interviews.Progress(Application.Id,Application.Revision,outcome,notes);await OnSaved.InvokeAsync();});
Task RespondToClient()=>Run(async()=>{await Review.RespondToInformation(informationTask!.Action.Id,informationTask.Action.Revision,clientResponse);await OnSaved.InvokeAsync();});
Task Retry()=>Run(async()=>{Notice=await Interviews.RetryDelivery(booking!.Id);await Load();});
Task CopyResponseLink()=>Run(async()=>{var link=await Interviews.ResponseLink(booking!.Id);var copied=await JS.InvokeAsync<bool>("osynixCopyReviewLink",link);Notice=copied?"Candidate Response Link Copied.":link;});
Task Reopen()=>Run(async()=>{await Interviews.Reopen(Application.Id,Application.Revision);await OnSaved.InvokeAsync();});
}
