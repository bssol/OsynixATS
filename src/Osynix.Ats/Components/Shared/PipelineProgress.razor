@inherits PageBase
@inject InterviewService Interviews
@inject HiringReviewService Review
@inject RecruiterActionService Actions
@inject AtsService Ats
@inject IntegrationSettingsService IntegrationHub
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS
<div class="progress-pane">
<div class="progress-context"><div><b>@Application.Position?.Title</b><span>@Application.Position?.Client · @Application.Stage</span></div><span class="pp-badge">@(permission.Invitations?"Online interviews included":"Manual updates only")</span></div>
<div class="progress-body">
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
<nav class="progress-steps" aria-label="Recruitment action steps"><button class="@(view=="summary"?"selected":"")" @onclick='()=>SetView("summary")'>1 · Overview</button>@if(inviting){<button class="@(view=="interview"?"selected":"")" @onclick='()=>SetView("interview")'>2 · @(permission.Invitations?"Interview":"Recruitment update")</button>@if(permission.Invitations){<button class="@(view=="review"?"selected":"")" disabled="@(view!="review")">3 · Review &amp; send</button>}}else if(view!="summary"){<span>@ViewTitle</span>}</nav>
@if(view=="summary"){
<section class="workflow-current" aria-live="polite"><b>@WorkflowHeading</b><p>@WorkflowMessage</p></section>
@if(ShowLatestFeedback){var latest=feedback[0];<section class="request-summary"><div><b>@FeedbackHeading(latest.Feedback)</b><span class="muted small">From @latest.ContactName</span></div><p class="preserve">@(FeedbackSummary(latest))</p>@if(latest.AvailabilityStartUtc is DateTime proposed){<small>Suggested time · @InterviewService.When(proposed,latest.TimeZone) · @latest.DurationMinutes minutes · @latest.Mode</small>}@if(false&&feedbackTask is not null&&FeedbackActionLabel(latest.Feedback) is string actionLabel){<div class="feedback-actions"><button class="pp-button primary" disabled="@Busy" @onclick="()=>ActOnFeedback(latest.Feedback)">@actionLabel</button></div>}</section>}
@if(feedback.Count>0){<details><summary>Request history &amp; sharing</summary>@foreach(var item in feedback){<div class="history-entry"><b>@item.ContactName · @item.Feedback</b><p>@item.Remarks</p><button class="pp-button" disabled="@Busy" @onclick="()=>RevokeShare(item.Id)">Revoke profile sharing</button></div>}</details>}
@if(booking is not null&&booking.Status!="Cancelled"){
<section class="recruitment-progress" aria-label="Recruitment progress"><h3>Recruitment progress</h3><ol class="recruitment-timeline">
<li class="done"><b>Profile shared</b><small>Submitted to @Application.Position?.Client for review</small></li>
<li class="done"><b>@(feedback.Any(f=>f.Feedback=="Request Interview")?"Interview requested":"Client review")</b><small>@(feedback.FirstOrDefault(f=>f.Feedback=="Request Interview") is RecruiterFeedback request? $"Requested by {request.ContactName}":"Client feedback is recorded in request history")</small></li>
<li class="done"><b>Invitation sent</b><small>@booking.Provider · @(booking.Mode=="Online"?"online":"on-site")</small></li>
<li class="@(booking.Status is "Confirmed" or "Completed"?"active":booking.Status is "New Time Proposed" or "Response Requires Review" or "Awaiting Confirmation"?"active":"")"><b>@InterviewProgressLabel</b><small>@(booking.Status is "Confirmed" or "Completed"?InterviewService.When(booking.StartUtc,booking.TimeZone)+$" · {booking.DurationMinutes} minutes":InterviewProgressDetail)</small></li>
<li class="@(booking.Status=="Completed"?"active":"")"><b>Record interview outcome</b><small>@(booking.Status=="Completed"?"Choose the next step for this candidate":"Available after the interview")</small></li>
</ol></section>}
@if(booking is not null){
@if(ProposalPending){<section class="booking-summary proposal-pending"><div class="pp-row"><h3>Interview</h3><span class="pp-badge proposal-badge">New time proposed</span></div><div class="proposal-card"><b>Candidate proposed a new time</b><span class="proposal-date">@ProposalWhen(booking.ProposedStartUtc!.Value,booking.ProposedTimeZone,booking.DurationMinutes)</span><small class="proposal-help">Accepting updates Google Calendar and sends the revised invitation.</small></div></section>}
else{<section class="booking-summary"><div class="pp-row"><h3>Interview</h3><span class="pp-badge">@booking.Status</span></div><p>@InterviewService.When(booking.StartUtc,booking.TimeZone) · @booking.DurationMinutes minutes</p>@if(booking.Mode=="Online"){if(booking.MeetingLink.Length>0){<a href="@booking.MeetingLink" target="_blank" rel="noopener noreferrer">Open meeting link</a>}else if(booking.Status is not("Cancelled" or "Completed")){<p>Meeting link pending. Check integration status and retry.</p>}}else if(booking.Location.Length>0){<p>@booking.Location</p>}
@if(false&&CanCancelInterview){<button class="pp-button cancel interview-cancel-action" disabled="@Busy" @onclick='()=>SetView("cancel")'>Cancel interview</button>}
@if(booking.Status=="Response Requires Review"){<div class="pp-notice"><b>Candidate selected Maybe</b><p>ATS is checking the connected Google account for the proposed time. When Google sends the proposal notice, the exact time will appear here. Google Calendar’s Event responses email notification must be enabled.</p></div>}
else if(booking.ResponseNotes.Length>0&&!ImportedProposalNote){<p>@booking.ResponseNotes</p>}
@if(booking.ResponseSource.Length>0&&booking.Status is not("Confirmed" or "New Time Proposed")){<small>@booking.ResponseSource</small>}
@if(booking.Provider=="Google Meet"&&!Terminal&&(booking.Status is "Awaiting Confirmation" or "Response Requires Review")){<button class="pp-button calendar-refresh" disabled="@Busy" @onclick="RefreshCalendar">Check Google responses</button>}
@if(ShowMoreInterviewActions){<details class="booking-actions"><summary>More interview actions</summary><small class="delivery-status">@delivery</small><div class="pp-row">@if(CanRetryDelivery){<button class="pp-button" disabled="@Busy" @onclick="Retry">@(delivery.StartsWith("Google Meet:")?"Retry Google Meet":"Retry email")</button>}@if(permission.Invitations&&!Terminal&&(booking.Status is "Awaiting Confirmation" or "Response Requires Review")){<button class="pp-button" disabled="@Busy" @onclick="CopyResponseLink">Copy response link</button>}@if(!Terminal&&(booking.Status is "Awaiting Confirmation" or "Response Requires Review")){<button class="pp-button" @onclick='()=>SetView("response")'>Record external response</button>}</div></details>}</section>}}
else if(Application.InterviewStatus.Length>0&&Application.InterviewStatus!="Not Scheduled"){<section class="booking-summary"><div class="pp-row"><h3>Interview update</h3><span class="pp-badge">@Application.InterviewStatus</span></div>@if(Application.InterviewDateTimeUtc is DateTime manualDate&&!string.IsNullOrWhiteSpace(Application.InterviewTimeZone)){<p>@InterviewService.When(manualDate,Application.InterviewTimeZone)</p>}</section>}
@if(!Terminal&&Application.Stage=="Information Requested"&&informationTask is not null&&feedback.Count==0&&!ProposalPending){<div class="pp-row"><button class="pp-button primary" @onclick='()=>SetView("information")'>Respond to request</button></div>}
else if(Terminal){<section class="request-summary"><b>Outcome: @Application.Stage</b><p class="preserve">@Application.RecruiterNotes</p><small>Interview status: @Application.InterviewStatus</small></section><p class="muted">This application or its position is closed for further actions.</p>@if(Application.Stage=="Rejected"&&Application.Position?.Status is "Active" or "On Hold"){<button class="pp-button" disabled="@Busy" @onclick="Reopen">Reopen for deliberate resubmission</button>}}

}else if(view=="interview"){
@if(permission.Invitations){
<h3>Interview details</h3><div class="pp-grid"><label>Date and time<input type="datetime-local" value="@localStart" @onchange="e=>localStart=e.Value?.ToString()??string.Empty" /></label><label>Duration<select @bind="duration"><option value="15">15 minutes</option><option value="30">30 minutes</option><option value="45">45 minutes</option><option value="60">60 minutes</option><option value="90">90 minutes</option><option value="120">120 minutes</option><option value="180">180 minutes</option><option value="240">240 minutes</option></select></label><label>Time zone<select @bind="zone">@foreach(var tz in Zones){<option value="@tz.Id">@InterviewService.ZoneLabel(tz,localStart)</option>}</select></label><label>Candidate email<input type="email" maxlength="320" @bind="candidateEmail" /></label></div>
<label>Interview format</label><div class="pp-row pp-format"><button class="pp-button @(mode=="Online"?"selected":"")" aria-pressed="@(mode=="Online")" @onclick='()=>mode="Online"'><NavIcon Name="video" />Online</button><button class="pp-button @(mode=="On-Site"?"selected":"")" aria-pressed='@(mode=="On-Site")' @onclick='()=>mode="On-Site"'><NavIcon Name="pin" />On-site</button></div>
@if(mode=="Online"){@if(permission.Integrations){<label>Meeting provider</label><div class="provider-grid">@foreach(var name in AvailableProviders){<button class="provider-tile @(provider==name?"selected":"")" aria-pressed="@(provider==name)" @onclick="()=>SelectProvider(name)"><span class="provider-brand @(name=="Zoom"?"zoom":name=="Microsoft Teams"?"teams":name=="Google Meet"?"google":"")">@(name=="Zoom"?"zoom":name=="Microsoft Teams"?"T":name=="Google Meet"?"Meet":"↗")</span><span>@name</span></button>}</div>@if(provider=="Google Meet"){<p>A Google Meet link and calendar invitation will be created when you send this invitation.</p>}else{<label>Meeting link<input type="url" maxlength="2000" @bind="meetingLink" placeholder="https://…" /></label>}}else{<div class="pp-notice"><b>Online meetings need integration access</b><p>Upgrade the workspace plan to use online meeting providers or add a manual meeting link.</p><a href="/employer/subscriptions">Upgrade for online meetings</a></div>}}else{<label>Office address, map link and arrival instructions<textarea rows="3" maxlength="1000" @bind="location"></textarea></label>}
<label>Hiring manager contact<select @bind="selectedContact" @bind:after="SelectContact"><option value="">Choose another contact or enter an email</option>@foreach(var contact in contacts){<option value="@contact.Id">@contact.Name · @contact.Email</option>}</select></label><label>Hiring manager email (optional)<input type="email" maxlength="320" @bind="managerEmail" /></label><small class="muted">Auto-filled from the profile’s shared hiring contact or the client’s saved contacts. Without email, updates remain available through the review link.</small>
}else{
<h3>Update recruitment manually</h3><p class="muted small">Record interview progress without sending an invitation or candidate notification.</p><div class="pp-grid"><label>Recruitment stage<select @bind="manualStage">@foreach(var stage in Choices.Stages){<option>@stage</option>}</select></label><label>Interview status<select @bind="manualStatus">@foreach(var status in Choices.Interviews){<option>@status</option>}</select></label><label>@(manualStatus=="New Time Proposed"?"Proposed date and time":manualStatus=="Cancelled"?"Previous interview date and time":"Interview date and time")<input type="datetime-local" value="@localStart" @onchange="e=>localStart=e.Value?.ToString()??string.Empty" /></label><label>Time zone<select @bind="zone">@foreach(var tz in Zones){<option value="@tz.Id">@InterviewService.ZoneLabel(tz,localStart)</option>}</select></label></div><label>Internal notes<textarea rows="3" maxlength="5000" @bind="notes"></textarea></label><div class="pp-notice"><b>Manual update only</b><p>This plan does not include candidate invitations or email notifications. Record the interview date and status here; no invitation will be sent.</p></div>
}
}else if(view=="review"&&permission.Invitations){<h3>Review invitation</h3><div class="pp-facts"><div><small>Candidate</small><b>@candidateEmail</b></div><div><small>When</small><b>@localStart.Replace("T"," · ")</b></div><div><small>Time zone</small><b>@ZoneText</b></div><div><small>Format</small><b>@mode · @duration minutes</b></div></div>@if(mode=="Online"&&provider=="Google Meet"&&meetingLink.Length==0){<p>Google Meet link will be generated on send. Google Calendar will email invitations to the listed recipients.</p>}else if(mode=="Online"){<p><a href="@meetingLink" target="_blank" rel="noopener noreferrer">@meetingLink</a></p>}else{<p>@location</p>}<label>Invitation message<textarea rows="6" maxlength="5000" @bind="message"></textarea></label><div class="pp-notice"><b>Recipients</b><p>Candidate: @candidateEmail<br />Hiring manager: @(managerEmail.Length>0?managerEmail:"Shared review link only")</p><small>Accept, decline and propose-new-time buttons are added automatically. Both sides see the updated status.</small></div>@if(!Interviews.CanEmail){<p class="muted small">Email delivery needs configured email and public HTTPS. You can save the invitation and copy its response link for local testing.</p>}
}else if(view=="response"&&booking is not null){<h3>Record a response received outside ATS</h3><div class="pp-grid"><label>Received through<select @bind="channel"><option>Phone</option><option>WhatsApp</option><option>Email</option><option>Google Calendar</option><option>Other</option></select></label><label>Candidate response<select @bind="response"><option>Accepted</option><option>Declined</option><option>New Time Proposed</option></select></label></div>@if(response=="New Time Proposed"){<label>Proposed date and time<input type="datetime-local" value="@proposedStart" @onchange="e=>proposedStart=e.Value?.ToString()??string.Empty" /></label><label>Time zone<select @bind="proposedZone">@foreach(var tz in Zones){<option value="@tz.Id">@InterviewService.ZoneLabel(tz,proposedStart)</option>}</select></label>}<label>Notes<textarea rows="3" maxlength="2000" @bind="responseNotes"></textarea></label>
}else if(view=="cancel"&&booking is not null){<h3>Cancel this interview?</h3><p>@InterviewService.When(booking.StartUtc,booking.TimeZone) · @booking.DurationMinutes minutes</p><div class="pp-notice cancel-notice"><b>Candidate and hiring manager will be notified.</b><p>@(booking.Provider=="Google Meet"?"ATS will cancel the connected Google Calendar event and send cancellation emails.":"ATS will mark this interview cancelled and send cancellation emails.") The candidate’s recruitment stage and outcome will stay unchanged.</p></div>
}else if(view=="outcome"){<h3>@(Application.Stage=="Offer Sent"?"Record offer response":Application.Stage=="Offer Requested"?"Prepare offer":"Record interview outcome")</h3><label>Next step<select @bind="outcome"><option value="">Choose outcome</option>@if(Application.Stage!="Offer Sent"){@if(booking?.Status=="Confirmed"&&booking.StartUtc<=DateTime.UtcNow){<option value="Interview Completed">Interview completed — request feedback</option>}@if(booking?.Status=="Completed"){<option value="Next Round">Arrange another interview round</option>}<option>Hold</option><option>Offer Sent</option>}<option value="Reject">Rejected — close application</option><option>Hired</option></select></label><label>Internal notes<textarea rows="4" maxlength="5000" @bind="notes"></textarea></label><div class="pp-notice">@(Application.Stage=="Offer Requested"?"Review the client’s proposed terms above. Prepare and send the offer outside ATS before recording Offer Sent; this action does not send an offer email.":Application.Stage=="Shortlisted"?"The client recommended this candidate for hiring. Choose a final outcome only after your review.":"Rejected closes the application. Hold keeps it available for review. Offers remain in the pipeline until hired or rejected.")</div>
}else if(view=="followup"){<h3>Send follow-up</h3><label>Client or hiring manager email<input type="email" @bind="followUpEmail" /></label><label>Message<textarea rows="5" @bind="followUpMessage"></textarea></label>
}else if(view=="information"&&informationTask is not null){<h3>Information requested</h3><section class="request-summary"><p>@informationTask.Action.Remarks</p></section><label>Response to hiring manager<textarea rows="5" maxlength="5000" @bind="clientResponse"></textarea></label>}
</div>
<footer class="progress-footer">@if(view=="interview"){<button class="pp-button" disabled="@Busy" @onclick='()=>SetView("summary")'>← Back</button>@if(!permission.Invitations){<button class="pp-button primary" disabled="@Busy" @onclick="SaveManual">Save recruitment update</button>}}else if(view!="summary"){<button class="pp-button" disabled="@Busy" @onclick='()=>SetView(view=="review"?"interview":"summary")'>← Back</button>}@if(view=="summary"&&!Terminal){@foreach(var action in WorkflowActions){<button class="pp-button @(action==WorkflowActions.First()?"primary":"")" disabled="@Busy" @onclick="()=>WorkflowAction(action)">@action</button>}}else if(view=="interview"&&permission.Invitations){<button class="pp-button primary" disabled="@(Busy||mode=="Online"&&!permission.Integrations)" @onclick="PreviewInvite">Review invitation →</button>}else if(view=="review"){<button class="pp-button primary" disabled="@Busy" @onclick="SendInvite">@(mode=="Online"&&provider=="Google Meet"?"Create Google Meet invitation":Interviews.CanEmail?"Send invitation":"Save for local testing")</button>}else if(view=="outcome"){<button class="pp-button primary" disabled="@(Busy||outcome.Length==0)" @onclick="SaveOutcome">Save outcome</button>}else if(view=="response"){<button class="pp-button primary" disabled="@Busy" @onclick="Record">Record response</button>}else if(view=="information"){<button class="pp-button primary" disabled="@Busy" @onclick="RespondToClient">Send response</button>}else if(view=="followup"){<button class="pp-button primary" disabled="@Busy" @onclick="SendFollowUp">Send follow-up</button>}else if(view=="cancel"){<button class="pp-button cancel primary" disabled="@Busy" @onclick="CancelInterviewNow">Confirm cancellation</button>}</footer>
@if(connecting.Length>0){<div class="provider-overlay"><section role="dialog" aria-modal="true" aria-label="Connect meeting provider"><h3>Connect @connecting</h3><p>Your own account will be used to create interview meetings. The hiring manager does not need to connect an account.</p><div class="pp-notice">Provider authorization is not configured yet. For now, create a meeting in your provider account and paste its link using Manual Link.</div><button class="pp-button primary" @onclick="UseManual">Use manual link</button><button class="pp-button" @onclick='()=>connecting=""'>Close</button></section></div>}
</div>
@code{
[Parameter,EditorRequired]public Assessment Application{get;set;}=default!;
[Parameter]public EventCallback OnSaved{get;set;}
InterviewBooking? booking;RecruiterActionItem? informationTask,feedbackTask;bool inviting,invitationPrepared;string delivery="",candidateEmail="",managerEmail="",localStart="",zone="UTC",mode="Online",provider="Manual Link",meetingLink="",location="",message="",response="Accepted",channel="Phone",proposedStart="",proposedZone="UTC",responseNotes="",outcome="",notes="",clientResponse="";int duration=30;
InterviewAccess permission=new(false,false);IntegrationOverview? integrationOverview;List<RecruiterFeedback> feedback=[];List<ClientContact> contacts=[];string view="summary",connecting="",manualStage="",manualStatus="";Guid? selectedContact;
bool InterviewElapsed=>booking is not null&&booking.StartUtc.AddMinutes(booking.DurationMinutes)<=DateTime.UtcNow;
string CurrentDecision=>feedback.FirstOrDefault()?.Feedback is string decision&&decision is "Request Interview" or "More Information Required" or "Send Offer" or "Recommend Hire" or "Hold" or "Reject" or "Shortlist"?decision:"";
bool NewRoundRequested=>CurrentDecision=="Request Interview"&&(booking is null||booking.Status=="Completed"&&Application.Stage=="Interview Requested");
string WorkflowHeading=>Terminal?$"Application closed: {Application.Stage.ToLowerInvariant()}":Application.Stage=="Offer Sent"?"Offer sent":NewRoundRequested?"Interview requested":booking?.Status=="Completed"?"Waiting for client decision":booking?.Status??(CurrentDecision.Length>0?FeedbackHeading(CurrentDecision):"Waiting for client review");
string WorkflowMessage=>Terminal?$"Application closed: {Application.Stage.ToLowerInvariant()}.":Application.Stage=="Offer Sent"?"Offer sent. Waiting for the candidate’s response.":NewRoundRequested?"The client requested an interview. Choose a time and send the invitation.":booking?.Status switch{
"New Time Proposed" when booking.ProposedStartUtc.HasValue=>$"Candidate proposed {InterviewService.When(booking.ProposedStartUtc.Value,booking.ProposedTimeZone)}. Choose whether to accept it or suggest another time.",
"Declined"=>"Candidate declined the invitation. Choose the next step.","Cancelled"=>"Interview cancelled. The application remains active.","Completed"=>CurrentDecision is "Send Offer" or "Recommend Hire" or "Hold" or "Reject" or "More Information Required"?FeedbackSummary(feedback[0]):"Interview completed. Waiting for the client’s decision.",
"Confirmed" or "Awaiting Confirmation" when InterviewElapsed=>"The scheduled time has passed. Confirm whether the interview took place.",
"Confirmed"=>$"Candidate confirmed. The interview is scheduled for {InterviewService.When(booking.StartUtc,booking.TimeZone)}.","Awaiting Confirmation"=>"Invitation sent. Waiting for the candidate to respond.","Response Requires Review"=>"The candidate’s response needs review.",_=>CurrentDecision.Length>0?FeedbackSummary(feedback[0]):"Waiting for the client to review this profile."};
string[] WorkflowActions=>Terminal?[]:Application.Stage=="Offer Sent"?["Record offer response"]:NewRoundRequested?[booking is null?"Schedule interview":"Schedule next interview"]:booking?.Status switch{
"New Time Proposed" when ProposalPending=>["Accept proposed time","Suggest another time","Cancel interview"],"Declined"=>["Reschedule interview","Update outcome"],"Cancelled"=>["Schedule replacement interview","Update outcome"],"Completed"=>CurrentDecision is "Send Offer" or "Recommend Hire" or "Hold" or "Reject" or "More Information Required"?[FeedbackActionLabel(CurrentDecision)??"Update outcome"]:["Send follow-up","Update outcome"],"Confirmed" or "Awaiting Confirmation" when InterviewElapsed=>["Record interview outcome","Reschedule interview"],"Confirmed" or "Awaiting Confirmation"=>["Reschedule interview","Cancel interview"],_=>CurrentDecision.Length>0?[FeedbackActionLabel(CurrentDecision)??"Update outcome"]:["Send follow-up"]};
async Task WorkflowAction(string action){if(action=="Accept proposed time"){await AcceptProposal();return;}if(action=="Cancel interview"){SetView("cancel");return;}if(action=="Send follow-up"){await OpenFollowUp();return;}if(action is "Record interview outcome" or "Update outcome" or "Record offer response"){OpenOutcome();return;}if(action is "Schedule interview" or "Schedule next interview" or "Schedule replacement interview" or "Reschedule interview" or "Suggest another time"){invitationPrepared=false;await OpenInvite();return;}await ActOnFeedback(CurrentDecision);}
string followUpEmail="",followUpMessage="";
Task OpenFollowUp()=>Run(async()=>{followUpEmail=await Interviews.DefaultManagerEmail(Application.Id);followUpMessage=$"Hello, please share your feedback on {Application.CandidateName} for {Application.Position?.Title}. Thank you.";SetView("followup");});
Task SendFollowUp()=>Run(async()=>{await Review.SendFollowUp(Application.Id,followUpEmail,followUpMessage);Notice="Follow-up email sent.";SetView("summary");});
bool ProposalPending=>booking?.Status=="New Time Proposed"&&booking.ProposedStartUtc.HasValue;
bool ActiveBooking=>booking is not null&&booking.Status is not("Cancelled" or "Completed");
bool ShowLatestFeedback=>feedback.Count>0&&!ProposalPending&&!(feedback[0].Feedback=="Request Interview"&&ActiveBooking);
bool ShowOutcomeAction=>!ActiveBooking||Application.Stage is "Offer Requested" or "Offer Sent";
string InterviewProgressLabel=>booking?.Status switch{"New Time Proposed"=>"Review proposed time","Response Requires Review"=>"Review candidate response","Awaiting Confirmation"=>"Waiting for candidate","Confirmed"=>"Interview scheduled","Completed"=>"Interview completed",_=>"Interview status"};
string InterviewProgressDetail=>booking?.Status switch{"New Time Proposed"=>"The candidate proposed a different time. Review the proposal above.","Response Requires Review"=>"Check the candidate’s response before continuing.","Awaiting Confirmation"=>"The invitation is sent and awaits the candidate’s response.",_=>booking?.Status??string.Empty};
bool CanCancelInterview=>booking is not null&&booking.Status is not("Cancelled" or "Completed")&&!Terminal;
bool HasFeedbackAction=>feedback.Count>0&&FeedbackActionLabel(feedback[0].Feedback) is not null&&feedbackTask is not null;
bool ImportedProposalNote=>booking?.ResponseNotes.StartsWith("Candidate proposed",StringComparison.Ordinal)==true;
bool CanRetryDelivery=>delivery.StartsWith("Google Meet:",StringComparison.Ordinal)||Interviews.CanEmail&&(delivery.Contains("Retry Available",StringComparison.OrdinalIgnoreCase)||delivery.Contains("Queued",StringComparison.OrdinalIgnoreCase));
bool ShowMoreInterviewActions=>booking is not null&&(CanRetryDelivery||!Terminal&&(booking.Status is "Awaiting Confirmation" or "Response Requires Review"));
IReadOnlyList<string> AvailableProviders=>(integrationOverview?.Providers.Where(p=>p.Included&&p.Provider.Implemented&&p.Account is not null&&(p.Status is "Connected" or "Needs attention")).Select(p=>p.Provider.Name).Append("Manual Link").ToArray())??["Manual Link"];
string ProposalWhen(DateTime startUtc,string timeZone,int minutes){try{var zoneInfo=TimeZoneInfo.FindSystemTimeZoneById(timeZone);var start=TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(startUtc,DateTimeKind.Utc),zoneInfo);var end=TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(startUtc.AddMinutes(minutes),DateTimeKind.Utc),zoneInfo);var startTime=start.ToString(start.ToString("tt")==end.ToString("tt")?"h:mm":"h:mm tt");var endTime=end.ToString(start.Date==end.Date?"h:mm tt":"ddd, dd MMM h:mm tt");return $"{start:dddd, dd MMM yyyy} · {startTime}–{endTime} · {timeZone}";}catch{return InterviewService.When(startUtc,timeZone)+$" · {minutes} minutes";}}
static readonly IReadOnlyList<TimeZoneInfo> Zones=TimeZoneInfo.GetSystemTimeZones().Select(t=>TimeZoneInfo.TryConvertWindowsIdToIanaId(t.Id,out var iana)?TimeZoneInfo.FindSystemTimeZoneById(iana):t).Append(TimeZoneInfo.Utc).DistinctBy(t=>t.Id).OrderBy(t=>t.BaseUtcOffset).ThenBy(t=>t.Id).ToList();
string ZoneText=>InterviewService.ZoneLabel(TimeZoneInfo.FindSystemTimeZoneById(zone),localStart);
string ViewTitle=>view switch{"outcome"=>"Outcome","response"=>"External response","information"=>"Respond to request","cancel"=>"Cancel interview",_=>"Interview"};
static string FeedbackHeading(string feedback)=>feedback switch{"Shortlist"=>"Client shortlisted this candidate","Request Interview"=>"Interview requested","More Information Required"=>"Information requested","Recommend Hire"=>"Hiring recommended","Send Offer"=>"Offer requested","Reject"=>"Client rejected this candidate","Hold"=>"Client paused the decision",_=>feedback};
string FeedbackSummary(RecruiterFeedback item){var next=item.Feedback switch{"Shortlist"=>"The candidate remains active while the client compares profiles.","Request Interview"=>"Review the suggested time, then schedule the invitation.","More Information Required"=>"Reply to the client’s question and coordinate the follow-up.","Recommend Hire"=>"This is a recommendation. Confirm the final outcome before closing the application.","Send Offer"=>"Review the proposed terms and prepare the offer for the candidate.","Reject"=>"The application is closed for this position.","Hold"=>"The application remains open while the client pauses its decision.",_=>"Review the client’s feedback and choose the next step."};return string.IsNullOrWhiteSpace(item.Remarks)?next:$"{next}\n\n{item.Remarks}";}
static string? FeedbackActionLabel(string feedback)=>feedback switch{"Shortlist"=>"Review shortlist","Request Interview"=>"Schedule requested interview","More Information Required"=>"Respond to request","Send Offer"=>"Prepare offer", "Recommend Hire"=>"Review hiring recommendation","Reject"=>"Review rejection","Hold"=>"Review hold",_=>null};
Task ActOnFeedback(string feedback)=>feedback switch{"Shortlist" or "Hold" or "Reject" when feedbackTask is not null=>AcknowledgeFeedback(),"Request Interview"=>OpenInvite(),"More Information Required" when informationTask is not null=>SetFeedbackView("information"),"Send Offer"=>OpenFeedbackDecision("offer"),"Recommend Hire"=>OpenFeedbackDecision("hire"),_=>Task.CompletedTask};
Task AcknowledgeFeedback()=>Run(async()=>{if(feedbackTask is null)return;await Actions.Acknowledge(feedbackTask.Action.Id,feedbackTask.Action.Revision,true);await Load();Notice="Client feedback marked as reviewed.";await OnSaved.InvokeAsync();});
Task OpenFeedbackDecision(string kind){outcome="";Notice=kind=="offer"?"Review the client’s proposed terms, prepare the offer, then record it as sent. ATS will not email an offer automatically.":"The client recommends hiring. Review the candidate, then choose the final outcome.";SetView("outcome");return Task.CompletedTask;}
Task SetFeedbackView(string next){SetView(next);return Task.CompletedTask;}
Task OpenFeedbackOutcome(string next){outcome=next;OpenOutcome();return Task.CompletedTask;}
void SetView(string value){view=value;inviting=value is "interview" or "review";}
void SelectProvider(string name){provider=name;if(name=="Google Meet"){meetingLink="";connecting="";}else if(name!="Manual Link")connecting=name;}
void UseManual(){provider="Manual Link";connecting="";}
void SelectContact(){managerEmail=contacts.FirstOrDefault(c=>c.Id==selectedContact)?.Email??"";}
Task PreviewInvite()=>Run(()=>{InterviewService.ParseTime(localStart,zone);if(string.IsNullOrWhiteSpace(candidateEmail))throw new InvalidOperationException("Enter the candidate email.");if(mode=="Online"&&provider!="Google Meet"&&(!Uri.TryCreate(meetingLink,UriKind.Absolute,out var url)||url.Scheme!="https"))throw new InvalidOperationException("Add a valid HTTPS meeting link.");if(mode=="On-Site"&&string.IsNullOrWhiteSpace(location))throw new InvalidOperationException("Enter the interview location.");SetView("review");return Task.CompletedTask;});
Task SaveManual()=>Run(async()=>{var draft=JsonSerializer.Deserialize<Assessment>(JsonSerializer.Serialize(Application))!;draft.Stage=manualStage;draft.InterviewStatus=manualStatus;draft.RecruiterNotes=notes;if(!permission.Invitations&&(manualStatus is "Scheduled" or "New Time Proposed")){draft.InterviewDateTimeUtc=InterviewService.ParseTime(localStart,zone);draft.InterviewTimeZone=zone;}await Ats.SaveLifecycle(draft);Notice="Recruitment stage, interview status and internal notes have been saved.";SetView("summary");await OnSaved.InvokeAsync();});
Task RevokeShare(Guid id)=>Run(async()=>{await Review.Revoke(id);await Load();await OnSaved.InvokeAsync();});
bool Terminal=>Application.Stage is "Rejected" or "Hired"||Application.ClientStatus=="Hired"||Application.Position?.Status is not("Active" or "On Hold");
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load(){booking=await Interviews.Details(Application.Id);delivery=booking is null?"":await Interviews.DeliveryStatus(booking.Id);var actions=await Actions.Notifications();informationTask=actions.FirstOrDefault(t=>t.Action.AssessmentId==Application.Id&&t.Action.Type=="Respond To Client");feedbackTask=actions.FirstOrDefault(t=>t.Action.AssessmentId==Application.Id);notes=Application.RecruiterNotes;manualStage=Application.Stage;manualStatus=string.IsNullOrEmpty(Application.InterviewStatus)?"Not Scheduled":Application.InterviewStatus;permission=await Interviews.CommunicationAccess(Application.Id);integrationOverview=await IntegrationHub.Load((await Auth.GetAuthenticationStateAsync()).User);feedback=(await Review.Inbox()).Where(f=>f.AssessmentId==Application.Id).ToList();contacts=await Interviews.ManagerContacts(Application.Id);}
Task OpenInvite()=>Run(async()=>{if(invitationPrepared){SetView("interview");return;}await Load();var candidate=permission.Invitations&&Application.CandidateId is Guid cid?(await Ats.Candidates()).FirstOrDefault(c=>c.Id==cid):null;candidateEmail=booking?.CandidateEmail??candidate?.Email??"";managerEmail=!string.IsNullOrWhiteSpace(booking?.ManagerEmail)?booking.ManagerEmail:await Interviews.DefaultManagerEmail(Application.Id);var feedback=(await Review.Inbox()).FirstOrDefault(f=>f.AssessmentId==Application.Id);var start=permission.Invitations?(booking?.Status=="New Time Proposed"?booking.ProposedStartUtc:(booking?.Status is "Completed" or "Cancelled")?null:booking?.StartUtc??feedback?.AvailabilityStartUtc):Application.InterviewDateTimeUtc;zone=permission.Invitations?booking?.TimeZone??feedback?.TimeZone??"UTC":Application.InterviewTimeZone.Length>0?Application.InterviewTimeZone:"UTC";if(zone.Length==0)zone="UTC";if(TimeZoneInfo.TryConvertWindowsIdToIanaId(zone,out var iana))zone=iana;localStart=start.HasValue?TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(start.Value,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById(zone)).ToString("yyyy-MM-ddTHH:mm"):"";duration=booking?.DurationMinutes??feedback?.DurationMinutes??30;mode=booking?.Mode??feedback?.Mode??"Online";if(mode.Length==0)mode="Online";if(!permission.Integrations&&mode=="Online")mode="On-Site";provider=booking?.Provider is string bookedProvider&&AvailableProviders.Contains(bookedProvider)?bookedProvider:"Manual Link";meetingLink=booking?.Status=="Cancelled"&&booking?.Provider=="Google Meet"?"":booking?.MeetingLink??"";location=booking?.Location??feedback?.Location??"";message=$"Hello {Application.CandidateName},\n\nYou Are Invited To Interview For {Application.Position?.Title} With {Application.Position?.Client}.\nPlease Review The Schedule And Joining Details Below, Then Confirm Your Availability, Decline Or Propose Another Time Using The Response Link.\n\nWe Look Forward To Speaking With You.";selectedContact=contacts.FirstOrDefault(c=>c.Email.Equals(managerEmail,StringComparison.OrdinalIgnoreCase))?.Id;invitationPrepared=true;SetView("interview");});
Task SendInvite()=>Run(async()=>{var r=await Interviews.Invite(new(Application.Id,Application.Revision,booking?.Id,booking?.Revision,candidateEmail,managerEmail,localStart,zone,duration,mode,provider,meetingLink,location,message));Notice=r.Message;SetView("summary");await OnSaved.InvokeAsync();});
Task RefreshCalendar()=>Run(async()=>{Notice=await Interviews.RefreshGoogleResponse(booking!.Id);await Load();await OnSaved.InvokeAsync();});
Task AcceptProposal()=>Run(async()=>{await Interviews.ReviewProposalAsRecruiter(Application.Id,booking!.Id,booking.Revision,true,null,booking.TimeZone);await Load();await OnSaved.InvokeAsync();});
Task SuggestAnotherTime(){invitationPrepared=false;return OpenInvite();}
Task Record()=>Run(async()=>{await Interviews.RecordResponse(new(booking!.Id,booking.Revision,response,responseNotes,proposedStart,proposedZone),channel);SetView("summary");await OnSaved.InvokeAsync();});
Task CancelInterviewNow()=>Run(async()=>{Notice=await Interviews.CancelInterview(booking!.Id,booking.Revision);SetView("summary");await Load();await OnSaved.InvokeAsync();});
void OpenOutcome(){SetView("outcome");if(Application.Stage=="Offer Requested")outcome="Offer Sent";}
Task SaveOutcome()=>Run(async()=>{await Interviews.Progress(Application.Id,Application.Revision,outcome,notes);SetView("summary");await Load();await OnSaved.InvokeAsync();});
Task RespondToClient()=>Run(async()=>{await Review.RespondToInformation(informationTask!.Action.Id,informationTask.Action.Revision,clientResponse);await OnSaved.InvokeAsync();});
Task Retry()=>Run(async()=>{Notice=await Interviews.RetryDelivery(booking!.Id);await Load();});
Task CopyResponseLink()=>Run(async()=>{var link=await Interviews.ResponseLink(booking!.Id);var copied=await JS.InvokeAsync<bool>("osynixCopyReviewLink",link);Notice=copied?"Candidate Response Link Copied.":link;});
Task Reopen()=>Run(async()=>{await Interviews.Reopen(Application.Id,Application.Revision);await OnSaved.InvokeAsync();});
}
