@inherits PageBase
@inject RecruiterWorkService Work
@inject RecruiterActionService Actions
@inject RecruitmentUpdates Updates
@implements IDisposable
<PageTitle>My Recruitment Work · Osynix ATS</PageTitle>
<div class="dashboard-page recruiter-dashboard"><DashboardWelcome /><p class="work-scope-note">Your Independent Client Work And Employer Assignments — Clearly Separated Across Your Workspaces.</p><Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(data is not null){
<nav class="recruiter-work-tabs" aria-label="Recruiter Work Views"><button class="@(tab=="clients"?"active":"secondary")" aria-pressed="@(tab=="clients")" @onclick='()=>Choose("clients")'>My Client Work</button><button class="@(tab=="employers"?"active":"secondary")" aria-pressed="@(tab=="employers")" @onclick='()=>Choose("employers")'>Employer Work (@data.Teams.Count)</button><button class="@(tab=="invitations"?"active":"secondary")" aria-pressed="@(tab=="invitations")" @onclick='()=>Choose("invitations")'>Invitations (@data.Invitations.Count)</button><button class="@(tab=="submissions"?"active":"secondary")" aria-pressed="@(tab=="submissions")" @onclick='()=>Choose("submissions")'>Submission Tracker</button><button class="secondary" disabled="@Busy" @onclick="()=>Run(Load)">Refresh</button></nav>
<div class="kpis recruiter-work-kpis">
@if(tab=="clients"){
<div class="kpi"><span class="kpi-icon icon-blue"><NavIcon Name="clients" /></span><span>Active Clients</span><strong>@data.ActiveClients</strong><small>Your Independent Business</small></div>
<div class="kpi"><span class="kpi-icon icon-violet"><NavIcon Name="positions" /></span><span>Active Positions</span><strong>@PersonalPositions.Count(p=>p.Status is "Active" or "On Hold")</strong><small>Across your client work</small></div>
<div class="kpi"><span class="kpi-icon icon-teal"><NavIcon Name="assessment" /></span><span>Profiles Submitted</span><strong>@data.Submissions.Count(s=>s.Audience=="Client")</strong><small>For client review</small></div>
<div class="kpi"><span class="kpi-icon icon-amber"><NavIcon Name="clock" /></span><span>Awaiting Feedback</span><strong>@data.Submissions.Count(s=>s.Audience=="Client"&&s.Pending)</strong><small>Client decisions pending</small></div>
}else if(tab=="employers"){
<div class="kpi"><span class="kpi-icon icon-blue"><NavIcon Name="clients" /></span><span>Employer Workspaces</span><strong>@data.Teams.Count</strong><small>Active team memberships</small></div>
<div class="kpi"><span class="kpi-icon icon-violet"><NavIcon Name="positions" /></span><span>Assigned Positions</span><strong>@EmployerPositions.Count(p=>p.Status is "Active" or "On Hold")</strong><small>Uses employer position slots</small></div>
<div class="kpi"><span class="kpi-icon icon-teal"><NavIcon Name="assessment" /></span><span>Profiles Submitted</span><strong>@data.Submissions.Count(s=>s.Audience=="Employer")</strong><small>For employer review</small></div>
<div class="kpi"><span class="kpi-icon icon-amber"><NavIcon Name="flag" /></span><span>Action Needed</span><strong>@EmployerActions.Count</strong><small>Across employer workspaces</small></div>
}else if(tab=="invitations"){
<div class="kpi"><span class="kpi-icon icon-amber"><NavIcon Name="message" /></span><span>Pending Invitations</span><strong>@data.Invitations.Count</strong><small>Employer team requests</small></div>
<div class="kpi"><span class="kpi-icon icon-blue"><NavIcon Name="clients" /></span><span>Employer Workspaces</span><strong>@data.Teams.Count</strong><small>Accepted memberships</small></div>
<div class="kpi"><span class="kpi-icon icon-violet"><NavIcon Name="positions" /></span><span>Assigned Positions</span><strong>@EmployerPositions.Count(p=>p.Status is "Active" or "On Hold")</strong><small>Current employer assignments</small></div>
<div class="kpi"><span class="kpi-icon icon-teal"><NavIcon Name="flag" /></span><span>Action Needed</span><strong>@EmployerActions.Count</strong><small>From accepted assignments</small></div>
}else{
<div class="kpi"><span class="kpi-icon icon-blue"><NavIcon Name="assessment" /></span><span>Profiles Submitted</span><strong>@data.Submissions.Count</strong><small>Clients and employers</small></div>
<div class="kpi"><span class="kpi-icon icon-amber"><NavIcon Name="clock" /></span><span>Awaiting Client Feedback</span><strong>@data.Submissions.Count(s=>s.Audience=="Client"&&s.Pending)</strong><small>Independent client work</small></div>
<div class="kpi"><span class="kpi-icon icon-violet"><NavIcon Name="clock" /></span><span>Awaiting Employer Review</span><strong>@data.Submissions.Count(s=>s.Audience=="Employer"&&s.Pending)</strong><small>Employer workspace work</small></div>
<div class="kpi"><span class="kpi-icon icon-teal"><NavIcon Name="flag" /></span><span>Action Needed</span><strong>@actionItems.Count</strong><small>Across all work</small></div>
}
</div>
@if(tab=="clients"){
<section class="recruiter-work-section"><div class="section-heading"><div><h2>My Clients</h2><p class="muted">Your independent client assignments and their current activity.</p></div>@if(data.PersonalWorkspace is Guid own){<WorkOpenButton WorkspaceId="own" Path="/clients" Text="Manage Clients" />}</div>
@if(data.PersonalSlotsUsed>data.PersonalSlotsLimit){<p class="notice">You Have @data.PersonalSlotsUsed Existing Active/On-Hold Positions Against @data.PersonalSlotsLimit Personal Slot(s). Existing Work Was Preserved During The Upgrade. Close Or Fill Positions, Or Request More Slots, Before Activating Another.</p>}
<div class="recruiter-client-grid">@foreach(var client in data.Clients){var positions=PersonalPositions.Where(p=>p.Client==client.Name).ToList();var sent=data.Submissions.Where(s=>s.Audience=="Client"&&s.Client==client.Name).ToList();var tasks=PersonalActions.Count(a=>a.Client==client.Name);<article class="recruiter-client-card"><div class="recruiter-client-head"><span class="recruiter-client-logo">@ClientInitials(client.Name)</span><div class="recruiter-client-name"><h3>@client.Name</h3><small>@(string.IsNullOrWhiteSpace(client.Industry)?"Independent Client":client.Industry)</small></div>@if(tasks>0){<span class="recruiter-work-badge">@tasks action@(tasks==1?"":"s")</span>}</div><div class="recruiter-client-stats"><div><strong>@positions.Count(p=>p.Status is "Active" or "On Hold")</strong><small>Active Positions</small></div><div><strong>@sent.Count</strong><small>Profiles Submitted</small></div><div><strong>@sent.Count(s=>s.Pending)</strong><small>Awaiting Feedback</small></div></div>@if(data.PersonalWorkspace is Guid personalWorkspaceId){<WorkOpenButton WorkspaceId="personalWorkspaceId" Path="@($"/pipeline?client={Uri.EscapeDataString(client.Name)}")" Text="Open Client Work" CssClass="recruiter-client-open" />}</article>}</div>
@if(data.Clients.Count==0){<p class="empty">No Active Clients Yet. Add A Client To Start Organizing Your Independent Recruitment Work.</p>}
<div class="recruiter-client-activity"><div class="section-heading"><div><h2>Client Activity</h2><p class="muted">Recent submissions and items that need your attention.</p></div><button class="secondary" @onclick='()=>Track("Client",false)'>View Submission Tracker</button></div>
@if(PersonalActions.Count>0){<div class="recruiter-action-list">@foreach(var action in PersonalActions.Take(4)){<div class="recruiter-action-row"><span class="recruiter-action-dot"></span><div><strong>@action.Action.Title</strong><small>@action.Client · @action.Candidate · @action.Position</small></div><WorkOpenButton WorkspaceId="action.WorkspaceId??data.PersonalWorkspace??Guid.Empty" Path="@($"/pipeline?ref={Uri.EscapeDataString(action.Reference)}")" Text="Review" /></div>}</div>}
@if(data.Submissions.Any(s=>s.Audience=="Client")){<div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Client</th><th>Position</th><th>Status</th><th>Submitted</th><th></th></tr></thead><tbody>@foreach(var submission in data.Submissions.Where(s=>s.Audience=="Client").Take(5)){<tr><td>@submission.Candidate</td><td>@submission.Client</td><td>@submission.Position</td><td>@submission.Status</td><td>@submission.SubmittedUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><WorkOpenButton WorkspaceId="submission.WorkspaceId" Path="@($"/pipeline?ref={Uri.EscapeDataString(submission.Reference)}")" Text="Open" /></td></tr>}</tbody></table></div>}else{<p class="empty">No Client Profile Submissions Yet.</p>}</div></section>
}else if(tab=="employers"){
<section class="recruiter-work-section"><div class="section-heading"><div><h2>Employer Workspaces</h2><p class="muted">Each card opens that employer’s assigned positions and dashboard in this session.</p></div></div><div class="recruiter-employer-grid">@foreach(var team in data.Teams){var assigned=EmployerPositions.Where(p=>p.WorkspaceId==team.Id).ToList();var actions=EmployerActions.Count(a=>a.WorkspaceId==team.Id);var submitted=data.Submissions.Count(s=>s.Audience=="Employer"&&s.WorkspaceId==team.Id);<article class="recruiter-employer-card"><div class="recruiter-client-head"><span class="recruiter-client-logo">@ClientInitials(team.Name)</span><div class="recruiter-client-name"><h3>@team.Name</h3><small>Employer Workspace</small></div>@if(actions>0){<span class="recruiter-work-badge">@actions action@(actions==1?"":"s")</span>}else{<span class="recruiter-work-clear">Up To Date</span>}</div><div class="recruiter-client-stats"><div><strong>@assigned.Count(p=>p.Status is "Active" or "On Hold")</strong><small>Assigned Positions</small></div><div><strong>@submitted</strong><small>Profiles Submitted</small></div><div><strong>@actions</strong><small>Action Needed</small></div></div><WorkOpenButton WorkspaceId="team.Id" Path="/workspace-dashboard" Text="Open Employer Workspace" CssClass="recruiter-client-open" /></article>}</div>
@if(data.Teams.Count==0){<p class="empty">You Have Not Joined An Employer Team Yet. New Invitations Appear In Your Inbox.</p>}
@if(EmployerActions.Count>0){<div class="recruiter-client-activity"><div class="section-heading"><div><h2>Employer Tasks</h2><p class="muted">Only tasks assigned to you are counted here.</p></div></div><div class="recruiter-action-list">@foreach(var action in EmployerActions.Take(6)){<div class="recruiter-action-row"><span class="recruiter-action-dot"></span><div><strong>@action.Action.Title</strong><small>@EmployerName(action.WorkspaceId) · @action.Candidate · @action.Position</small></div><WorkOpenButton WorkspaceId="action.WorkspaceId??Guid.Empty" Path="@($"/pipeline?ref={Uri.EscapeDataString(action.Reference)}")" Text="Review" /></div>}</div></div>}
<div class="table-wrap"><table><thead><tr><th>Employer</th><th>Assigned Position</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var position in EmployerPositions){<tr><td>@position.Employer</td><td>@position.Title<small>#@position.Reference</small></td><td>@position.Status</td><td><WorkOpenButton WorkspaceId="position.WorkspaceId" Path="@($"/positions?ref={Uri.EscapeDataString(position.Reference)}")" Text="View Assignment" /></td></tr>}</tbody></table></div></section>
}else if(tab=="invitations"){
<section class="panel"><h2>Employer Invitation Inbox</h2><p class="muted">An Invitation Joins An Employer’s Team. The Employer Assigns Positions Separately After You Accept; Assigned Jobs Appear Under Employer Work.</p>@foreach(var invitation in data.Invitations){<article class="work-invitation"><div><h3>@invitation.Employer</h3><p>Team Invitation · Awaiting Your Acceptance</p><small>Expires @invitation.ExpiresUtc.ToString("dd MMM yyyy HH:mm") UTC</small></div><a class="button" href="@invitation.Link" data-enhance-nav="false">Review Invitation</a></article>}@if(data.Invitations.Count==0){<p class="empty">No Pending Employer Invitations.</p>}</section>
}else{
<section class="panel"><div class="section-heading"><div><h2>Submission Tracker</h2><p class="muted">See Which Client Or Employer Received Each Profile And Which Decision Is Outstanding.</p></div></div><div class="toolbar"><input aria-label="Search Submitted Profiles" placeholder="Search client, Employer, position or candidate…" @bind="search" @bind:event="oninput" /><select aria-label="Submission Recipient" @bind="audience"><option value="">All Recipients</option><option>Client</option><option>Employer</option></select><label class="check"><input type="checkbox" @bind="pendingOnly" /> Pending Feedback Only</label></div><div class="table-wrap"><table><thead><tr><th>Work Context / Client</th><th>Position</th><th>Candidate</th><th>Submitted To</th><th>Decision / Remarks</th><th>Submitted (UTC)</th><th></th></tr></thead><tbody>@foreach(var submission in FilteredSubmissions.Skip((Page-1)*10).Take(10)){<tr><td>@submission.Employer<small>@submission.Client</small></td><td>@submission.Position<small>#@submission.Reference</small></td><td>@submission.Candidate</td><td>@submission.Audience</td><td><b>@submission.Status</b><small>@submission.Remarks</small></td><td>@submission.SubmittedUtc.ToString("dd MMM yyyy HH:mm")</td><td><WorkOpenButton WorkspaceId="submission.WorkspaceId" Path="@($"/pipeline?ref={Uri.EscapeDataString(submission.Reference)}")" Text="Open Pipeline" /></td></tr>}</tbody></table></div>@if(FilteredSubmissions.Count==0){<p class="empty">No Submitted Profiles Match These Filters.</p>}<div class="pager"><span>Page @Page Of @Pages · @FilteredSubmissions.Count Profiles</span><button class="secondary" disabled="@(Page<=1)" @onclick="()=>page=Page-1">Previous</button><button class="secondary" disabled="@(Page>=Pages)" @onclick="()=>page=Page+1">Next</button></div></section>
}
}
</div>
@code{
[SupplyParameterFromQuery(Name="tab")]public string? InitialTab{get;set;}
RecruiterWorkOverview? data;List<RecruiterActionItem> actionItems=[];string tab="clients",audience="",search="";bool pendingOnly;int page=1;
IEnumerable<WorkPosition> PersonalPositions=>data?.Positions.Where(p=>p.Personal)??[];IEnumerable<WorkPosition> EmployerPositions=>data?.Positions.Where(p=>!p.Personal)??[];
List<RecruiterActionItem> PersonalActions=>actionItems.Where(a=>a.WorkspaceId==data?.PersonalWorkspace).ToList();List<RecruiterActionItem> EmployerActions=>actionItems.Where(a=>data?.Teams.Any(t=>t.Id==a.WorkspaceId)==true).ToList();
List<WorkSubmission> FilteredSubmissions=>data?.Submissions.Where(s=>(audience.Length==0||s.Audience==audience)&&(!pendingOnly||s.Pending)&&$"{s.Employer} {s.Client} {s.Position} {s.Candidate}".Contains(search,StringComparison.OrdinalIgnoreCase)).ToList()??[];
int Pages=>Math.Max(1,(FilteredSubmissions.Count+9)/10);int Page=>Math.Clamp(page,1,Pages);
protected override Task OnInitializedAsync(){Updates.Changed+=OnChanged;if(InitialTab is "clients" or "employers" or "invitations" or "submissions")tab=InitialTab;return Run(Load);}async Task Load(){data=await Work.Overview();actionItems=await Actions.Notifications(allWork:true);}void Choose(string next){tab=next;page=1;}void Track(string recipient,bool pending){tab="submissions";audience=recipient;pendingOnly=pending;page=1;}string ClientInitials(string name){var parts=name.Split(' ',StringSplitOptions.RemoveEmptyEntries);return parts.Length>1?$"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}":name.Length>0?name[..Math.Min(2,name.Length)].ToUpperInvariant():"CL";}string EmployerName(Guid? id)=>data?.Teams.FirstOrDefault(t=>t.Id==id)?.Name??"Employer Workspace";void OnChanged()=>_=InvokeAsync(async()=>{try{await Load();StateHasChanged();}catch(UnauthorizedAccessException){data=null;actionItems=[];Error="Your Access Changed. Reload To Choose An Active Workspace.";StateHasChanged();}});public void Dispose()=>Updates.Changed-=OnChanged;
}
