@inject RecruiterWorkService Work
@inject RecruiterActionService Actions
@inject RecruitmentUpdates Updates
@implements IDisposable
<details class="header-menu notification-menu"><summary aria-label="Notifications" title="Invitations And Work Updates"><svg width="23" height="23" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>@if((data.Invitations.Count+data.EmployerReviews+actions.Count)>0){<span class="work-notification-count">@(data.Invitations.Count+data.EmployerReviews+actions.Count)</span>}</summary><div class="header-popover work-notifications"><h2>Invitations &amp; Work Updates</h2>@foreach(var action in actions.Take(5)){<div class="work-notification-item"><b>@(action.Action.Type=="Review Feedback"?action.Action.Feedback+" Feedback Received":action.Action.Title)</b><small>@action.Candidate · @action.Client · @action.Position</small>@if(action.WorkspaceId is Guid wid){<WorkOpenButton WorkspaceId="wid" Mode="@(action.Agency?"Agency":"Employer")" Path="@(action.Action.Type=="Review Feedback"?$"/pipeline?application={action.Action.AssessmentId}":$"/attention?task={action.Action.Id}")" Text="@(action.Action.Type=="Review Feedback"?"View Feedback":"Open Task")" />}else{<a href="@(action.Action.Type=="Review Feedback"?$"/pipeline?application={action.Action.AssessmentId}":$"/attention?task={action.Action.Id}")">@(action.Action.Type=="Review Feedback"?"View Feedback":"Open Task")</a>}@if(action.Action.Type=="Review Feedback"){<button class="secondary" @onclick="()=>Read(action)">Mark As Read</button>}</div>}@foreach(var invitation in data.Invitations.Take(5)){<a class="work-notification-item" href="@invitation.Link" data-enhance-nav="false"><b>Employer Invitation</b><small>@invitation.Employer · Review And Accept</small></a>}@if(data.EmployerReviews>0){<div class="work-notification-item"><b>@data.EmployerReviews Profiles Awaiting Your Review</b><small>Submitted By Your Team</small>@if(data.OwnerWorkspaceId is Guid own){<WorkOpenButton WorkspaceId="own" Path="/employer/submissions" Text="Review Team Profiles" />}</div>}@foreach(var assignment in data.Assignments){<div class="work-notification-item"><b>@assignment.Title</b><small>Assigned By @assignment.Employer</small><WorkOpenButton WorkspaceId="assignment.WorkspaceId" Path="@($"/positions?ref={Uri.EscapeDataString(assignment.Reference)}")" Text="View Assignment" /></div>}@if(data.Invitations.Count==0&&data.Assignments.Count==0&&data.EmployerReviews==0&&actions.Count==0){<p class="muted">No Pending Invitations Or Assigned Work Updates.</p>}<a href="/attention">Open Tasks</a></div></details>
@code{List<RecruiterActionItem> actions=[];WorkNotifications data=new([],[],0);protected override async Task OnInitializedAsync(){Updates.Changed+=Refresh;await Load();}async Task Load(){try{data=await Work.Notifications();actions=await Actions.Notifications();}catch(UnauthorizedAccessException){data=new([],[],0);actions=[];}}async Task Read(RecruiterActionItem item){try{await Actions.Acknowledge(item.Action.Id,item.Action.Revision,true);await Load();}catch(Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException){await Load();}catch(UnauthorizedAccessException){await Load();}}void Refresh()=>_=InvokeAsync(async()=>{await Load();StateHasChanged();});public void Dispose()=>Updates.Changed-=Refresh;}
