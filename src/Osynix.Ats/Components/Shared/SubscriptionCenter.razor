@inherits PageBase
@inject SubscriptionService Subscriptions
@inject EmployerService Employers
@inject RecruitmentUpdates Updates
@implements IDisposable
<PageTitle>Subscriptions · Osynix ATS</PageTitle>
<div class="subscription-center">
<Feedback Error="@Error" Notice="@Notice" Busy="Busy" />
@if(data is null){<p class="sc-muted" role="status">Loading subscriptions…</p>}else{
<div class="sc-heading"><div><h1>Subscriptions</h1><p class="sc-muted">A clear view of your plan, usage and available upgrades.</p></div><span class="sc-badge">@Category · @data.Workspace.SubscriptionName</span></div>
<nav class="sc-tabs" aria-label="Subscription sections">@foreach(var name in new[]{"My subscription","Compare plans","Upgrade requests"}){<button class="sc-tab @(tab==name?"selected":"")" aria-pressed="@(tab==name)" @onclick="()=>Select(name)">@name @if(name=="Upgrade requests"&&Pending>0){<span>(@Pending)</span>}</button>}</nav>
@if(data.ScheduledChange is {} change){
    <section class="sc-info sc-heading"><div><b>@(change.Kind=="Cancellation"?"Cancellation scheduled":$"Downgrade to {change.PlanName} scheduled")</b><p>Your @data.Workspace.SubscriptionName plan remains active until @change.EffectiveDate.ToString("dd MMM yyyy") (Pakistan time). @(change.Kind=="Cancellation"?"You will move to Free.":$"Your next plan is {change.PlanName}.") Unused AI allowance will not carry forward.</p></div><button class="sc-button" disabled="@Busy" @onclick="KeepPlan">Keep current plan</button></section>
}
@if(selected is not null){
<button class="sc-button" @onclick="()=>selected=null">← Back to plans</button>
<section class="sc-panel">
<div class="sc-heading"><h2>@(IsLower(selected)?selected.Code=="free"?"Cancel subscription":"Schedule downgrade":"Upgrade plan")</h2><span class="sc-badge wait">@(IsLower(selected)?"Effective at renewal":"Instant after payment confirmation")</span></div>
<div class="sc-facts"><div><small>Current plan</small><b>@data.Workspace.SubscriptionName</b></div><div><small>Next plan</small><b>@selected.Name</b></div><div><small>Billing period</small><b>@billing</b></div><div><small>Plan price</small><b>@Price(selected)</b></div></div>
<h3>Included access</h3><p>@string.Join(" · ",Benefits(selected).Select(b=>b.Text))</p>
@if(IsLower(selected)){
    <div class="sc-info">Your current @data.Workspace.SubscriptionName plan stays active until @(data.Workspace.SubscriptionRenewalDate?.ToString("dd MMM yyyy")??"your renewal date") (Pakistan time). Then @(selected.Code=="free"?"your subscription is cancelled and you move to Free":$"your plan changes to {selected.Name}"). Unused AI allowances expire at the change and do not carry forward. Any pending upgrade requests will be withdrawn.</div>
    @if(selected.Code!="free"){<p class="sc-muted">The displayed price and benefits are saved for the scheduled plan. Payments are arranged outside ATS; this does not charge you automatically.</p>}
}else{
    <label>Message to Admin (optional)<textarea rows="3" maxlength="2000" @bind="note" placeholder="Add a note about your upgrade…"></textarea></label>
    <div class="sc-info">Admin confirms payment outside ATS. Your upgrade activates immediately when approved, with a fresh allowance for the new plan. Unused AI assessments and JD analyses from the old plan do not carry forward. Any scheduled cancellation or downgrade is replaced when the upgrade activates.</div>
}
<div class="sc-actions"><button class="sc-button primary" disabled="@Busy" @onclick="Submit">@(IsLower(selected)?selected.Code=="free"?"Confirm cancellation at renewal":"Confirm downgrade at renewal":"Send upgrade request")</button><button class="sc-button" @onclick="()=>selected=null">Go back</button></div>
</section>}else if(tab=="My subscription"){
@if(Pending>0){<div class="sc-info sc-heading"><span>Your request is awaiting Admin review. Your current plan remains active.</span><button class="sc-button" @onclick='()=>Select("Upgrade requests")'>View request</button></div>}
<section class="sc-panel"><div class="sc-heading"><div><small class="sc-muted">CURRENT PLAN</small><div class="sc-plan-name"><h2>@data.Workspace.SubscriptionName</h2><span class="sc-badge good">Active</span></div><p class="sc-muted">@(data.Workspace.SubscriptionName=="Free"?"Automatically assigned to your account.":"Your active plan and included benefits.")</p><p class="sc-renewal"><b>Renewal date:</b> @(data.Workspace.SubscriptionRenewalDate?.ToString("dd MMM yyyy")??"No renewal scheduled")@(data.Workspace.SubscriptionRenewalDate is not null?" · Pakistan time":"")</p></div><div><div class="sc-price">@ActivePrice</div><button class="sc-button primary" @onclick='()=>Select("Compare plans")'>Change plan ↗</button>@if(SubscriptionRules.Tier(data.CurrentPlanCode)>0){<button class="sc-button sc-cancel-plan" disabled="@Busy" @onclick="ReviewCancellation">Cancel subscription</button>}</div></div>
<div class="sc-usage"><div><small>Active position slots</small><b>@data.Slots / @(data.Workspace.FreePositionSlots+data.Workspace.AdditionalPositionSlots)</b><progress value="@data.Slots" max="@Math.Max(1,data.Workspace.FreePositionSlots+data.Workspace.AdditionalPositionSlots)"></progress><small>Closing or filling releases a slot.</small></div><div><small>AI assessments this month</small><b>@data.Assessments / @Limit(Terms.MonthlyAssessments)</b>@if(Terms.MonthlyAssessments is int assessments){<progress value="@data.Assessments" max="@Math.Max(1,assessments)"></progress>}<small>Manual and careers applications share this allowance.</small></div><div><small>JD analyses this month</small><b>@data.Jds / @Limit(Terms.MonthlyJdAnalyses)</b>@if(Terms.MonthlyJdAnalyses is int jds){<progress value="@data.Jds" max="@Math.Max(1,jds)"></progress>}<small>Monthly allowances apply to annual plans too.</small></div>@if(Category!="Freelancer"){<div><small>Internal team seats</small><b>@data.Seats / @(data.Workspace.FreeRecruiterSeats+data.Workspace.AdditionalRecruiterSeats)</b><small>External recruiters do not consume seats.</small></div>}</div>
</section>
<section class="sc-panel"><h3>Included access</h3><div class="sc-feature"><div><b>Core recruitment workspace</b><small>@(Category=="Employer"?"Company positions, private talent pool, pipeline and hiring-manager links.":"Clients, private talent pool, pipeline and hiring-manager links.")</small></div><span class="sc-badge good">Included</span></div><div class="sc-feature"><div><b>Careers page &amp; automatic assessment</b><small>@(Terms.ApplicationsPerPosition is int apps?$"Up to {apps} applications per position; uses your monthly AI allowance.":"Applications use your workspace AI allowance.")</small></div><span class="sc-badge good">Included</span></div>
@if(Category=="Freelancer"){<div class="sc-feature"><div><b>Marketplace profile, availability &amp; invitations</b><small>Your profile is listed automatically with this plan so Employers and Agencies can find and invite you.</small></div><span class="sc-badge @(Terms.Marketplace?"good":"")">@(Terms.Marketplace?"Included":"Starter and above")</span></div>}
<div class="sc-feature"><div><b>Osynix Master Talent Pool</b><small>Included plan access needs no second approval.</small></div><span class="sc-badge @(Master?"good":"")">@(Master?"Enabled":Category=="Freelancer"?"Growth and above":"Not included")</span></div><div class="sc-feature"><div><b>Online interviews and candidate notifications</b><small>Schedule online or on-site interviews and send candidate email invitations. Provider account authorization may be required.</small></div><span class="sc-badge">@(Terms.MeetingIntegrations?"Included · connection setup coming soon":Category=="Freelancer"?"Growth and above":"Not included")</span></div><div class="sc-feature"><div><b>Email Templates</b><small>Reusable messages with formatting tools.</small></div><span class="sc-badge @(Templates?"good":"")">@(Templates?"Enabled":"Admin grant required")</span></div>
<details><summary>Additional Admin grants</summary><p>@data.Workspace.AdditionalPositionSlots additional position slots · @data.Workspace.AdditionalRecruiterSeats additional internal seats.</p><p class="sc-muted">Separate Admin grants remain identified independently of your plan. Team access and private workspace data remain scoped to the workspace you are working in.</p></details></section>
<div class="sc-info">At the careers application cap or monthly AI limit, the public listing stops accepting applications. The position stays active in ATS. No automatic overage charges. Each AI request or retry uses the allowance.</div>
}else if(tab=="Compare plans"){
<div class="sc-heading"><div><h3>Choose your next plan</h3><span class="sc-muted">@(Category=="Freelancer"?"One Freelancer workspace · no internal team seats":$"{Category} plans · shared workspace capacity")</span></div><div class="sc-actions">@foreach(var period in new[]{"Monthly","Annual"}){<button class="sc-button @(billing==period?"chosen":"")" aria-pressed="@(billing==period)" @onclick="()=>billing=period">@period</button>}@foreach(var currency in new[]{"PKR","USD"}){<button class="sc-button @(money==currency?"chosen":"")" aria-pressed="@(money==currency)" @onclick="()=>money=currency">@currency</button>}</div></div>
<div class="sc-plans">@foreach(var plan in data.Plans.OrderBy(p=>Rank(p.Code))){<article class="sc-plan @(plan.Code=="growth"?"featured":"")" @key="plan.Id"><div class="sc-heading"><h3>@plan.Name</h3>@if(plan.Id==data.Workspace.SubscriptionPlanId){<span class="sc-badge good">Current plan</span>}</div><div class="sc-price">@Price(plan) @if(HasPromotion(plan)){<span class="sc-original-price">@ListPrice(plan)</span><span class="sc-promo-badge">@(string.IsNullOrWhiteSpace(plan.PromotionLabel)?$"{plan.PromotionPercent:N0}% off":plan.PromotionLabel)</span>}</div><p class="sc-muted">@plan.Description</p><ul>@foreach(var benefit in Benefits(plan)){<li class="@(benefit.IsNew?"sc-benefit-new":"") @(benefit.Text.Contains("not included",StringComparison.OrdinalIgnoreCase)?"not-included":"")"><span class="sc-benefit-icon"><NavIcon Name="@BenefitIcon(benefit.Text)" /></span><span>@benefit.Text</span></li>}</ul><button class="sc-button @(plan.Code=="growth"?"primary":"")" disabled="@(Busy||plan.Id==data.Workspace.SubscriptionPlanId||(!IsLower(plan)&&PendingPlan))" @onclick="()=>Review(plan)">@(plan.Id==data.Workspace.SubscriptionPlanId?"Current plan":IsLower(plan)?plan.Code=="free"?"Cancel at renewal":$"Downgrade to {plan.Name}":PendingPlan?"Request pending":$"Upgrade to {plan.Name}")</button></article>}</div>
@if(data.Plans.All(p=>p.Code=="free")){<div class="sc-info">Paid @Category plans are being configured. They will appear here when published by Admin.</div>}
<div class="sc-info">Prices update when Admin publishes changes. Annual billing retains monthly AI allowances. Upgrades start immediately after payment confirmation. Downgrades and cancellation take effect at renewal. Unused AI allowances do not carry forward.</div>
<section class="sc-panel sc-addons"><div class="sc-heading"><div><h3>Add-ons</h3><p class="sc-muted">Request additional capacity or features for this workspace.</p></div><span class="sc-badge">Priced separately</span></div><p class="sc-addon-note">Add-on prices will be confirmed by Admin. Approved add-ons are added to your workspace separately from the subscription plan.</p><div class="form-grid"><label>Add-on<select @bind="feature"><option>Position Slots</option>@if(Category!="Freelancer"){<option>Recruiter Seats</option>@if(!data.Workspace.AgencyEnabled){<option>Agency Account</option>}}else{<option>Employer Account</option>}<option>Email Templates</option><option>Master Talent Pool</option></select></label>@if(feature is "Position Slots" or "Recruiter Seats"){<label>Additional quantity<input type="number" min="1" max="1000" @bind="quantity" /></label>}</div><label>Message to Admin (optional)<textarea rows="3" maxlength="2000" @bind="accessNote" placeholder="Tell Admin what you need this add-on for…"></textarea></label><button class="sc-button primary" disabled="@Busy" @onclick="RequestAccess">Submit add-on request</button></section>
}else{
@if(data.Requests.Count==0){<section class="sc-panel"><h3>No upgrade requests yet</h3><p class="sc-muted">Compare plans whenever you need more capacity or access.</p><button class="sc-button primary" @onclick='()=>Select("Compare plans")'>Explore plans</button></section>}
@foreach(var request in data.Requests){<section class="sc-panel" @key="request.Id"><div class="sc-heading"><h3>@request.Feature</h3><span class="sc-badge @(request.Status=="Granted"?"good":"wait")">@(request.Status=="Granted"?"Approved":request.Status)</span></div><small class="sc-muted">Reference @request.Id.ToString()[..8] · @request.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</small>@if(request.SubscriptionPlanId is not null){<div class="sc-facts"><div><small>Billing &amp; quoted price</small><b>@request.BillingPeriod · @(request.QuotedPrice is decimal amount?$"{request.Currency} {amount:N0}":"Price to be agreed with Admin")</b></div><div><small>Payment status</small><b>@(request.PaymentConfirmed?"Confirmed by Admin":"Awaiting offline confirmation")</b></div></div><div class="sc-steps"><div class="done">01 · Request received</div><div class="@(request.PaymentConfirmed?"done":"")">02 · Payment confirmed</div><div class="@(request.Status=="Granted"?"done":"")">03 · Plan activated</div></div>}
@if(request.Remarks.Length>0){<p class="preserve">Your message: @request.Remarks</p>}@if(request.Status=="Withdrawn"){<div class="sc-info">This upgrade request was withdrawn when you scheduled a cancellation or downgrade.</div>}else if(request.AdminResponse.Length==0){<div class="sc-info">@(request.Status=="Withdrawn"?"You withdrew this upgrade request.":"Admin is reviewing your request. Your current plan remains active.")</div>}else{<div class="sc-info">Admin sent you a message about this request. <a href="@($"/messages?request={request.Id}")">Open the conversation in Messages</a></div>}</section>}
}
}
</div>
@code{
SubscriptionOverview? data;SubscriptionPlan? selected;string tab="My subscription",billing="Monthly",money="PKR",note="",feature="Position Slots",accessNote="";int quantity=1;
string Category=>data is null?"":SubscriptionRules.Category(data.Workspace);
SubscriptionTerms Terms=>data is null?new():SubscriptionRules.Terms(data.Workspace)??new();
bool Master=>Terms.MasterPool||data?.Workspace.MasterTalentPoolEnabled==true;
bool Templates=>Terms.EmailTemplates||data?.Workspace.EmailTemplatesEnabled==true;
int Pending=>data?.Requests.Count(r=>r.Status is "Submitted" or "Under Review" or "Needs Information")??0;
bool PendingPlan=>data?.Requests.Any(r=>r.SubscriptionPlanId!=null&&r.Status is "Submitted" or "Under Review" or "Needs Information")==true;
string ActivePrice=>data?.Workspace is {} w?(w.SubscriptionPrice is decimal value?$"{w.SubscriptionCurrency} {value:N0} / {(w.SubscriptionName=="Free"?"forever":w.SubscriptionBilling=="Annual"?"year":"month")}":"Price agreed with Admin"):"";
record BenefitRow(string Text,bool IsNew=false,string Delta="");
static string Limit(int? n)=>n?.ToString()??"Not capped";
static int Rank(string code)=>code switch{"free"=>0,"starter"=>1,"growth"=>2,_=>3};
string PeriodSuffix(SubscriptionPlan p)=>$" / {(p.Code=="free"?"forever":billing=="Annual"?"year":"month")}";
string Price(SubscriptionPlan p)=>SubscriptionRules.Price(p,billing,money) is decimal amount?$"{money} {amount:N0}{PeriodSuffix(p)}":"Price on request";
string ListPrice(SubscriptionPlan p)=>SubscriptionRules.ListPrice(p,billing,money) is decimal amount?$"{money} {amount:N0}{PeriodSuffix(p)}":"";
bool HasPromotion(SubscriptionPlan p)=>SubscriptionRules.PromotionActive(p,SubscriptionRules.PakistanToday())&&SubscriptionRules.ListPrice(p,billing,money) is not null;
static string BenefitIcon(string benefit)=>benefit.StartsWith("active",StringComparison.OrdinalIgnoreCase)||benefit.Contains("position",StringComparison.OrdinalIgnoreCase)?"positions":benefit.Contains("team seats",StringComparison.OrdinalIgnoreCase)||benefit.Contains("talent pool",StringComparison.OrdinalIgnoreCase)||benefit.Contains("marketplace",StringComparison.OrdinalIgnoreCase)?"talent":benefit.Contains("assessment",StringComparison.OrdinalIgnoreCase)?"assessment":benefit.Contains("JD analyses",StringComparison.OrdinalIgnoreCase)?"import":benefit.Contains("careers",StringComparison.OrdinalIgnoreCase)?"clients":benefit.Contains("meeting",StringComparison.OrdinalIgnoreCase)?"clock":benefit.Contains("reports",StringComparison.OrdinalIgnoreCase)?"pipeline":benefit.Contains("templates",StringComparison.OrdinalIgnoreCase)?"mail":"dashboard";
IEnumerable<BenefitRow> Benefits(SubscriptionPlan p){var t=SubscriptionRules.Terms(p);var previous=data?.Plans.Where(x=>x.AccountCategory==p.AccountCategory&&Rank(x.Code)<Rank(p.Code)).OrderByDescending(x=>Rank(x.Code)).FirstOrDefault();var old=previous is null?null:SubscriptionRules.Terms(previous);static bool Increased(int? value,int? oldValue)=>value is null?oldValue is not null:oldValue is int previousValue&&value>previousValue;static string Delta(int? value,int? oldValue)=>value is null&&oldValue is not null?"Unlimited":$"+{(value??0)-(oldValue??0)}";BenefitRow Num(string label,int? value,int? oldValue)=>new($"{Limit(value)} {label}",old is not null&&Increased(value,oldValue),Delta(value,oldValue));yield return Num("active or on-hold position slots",t.PositionSlots,old?.PositionSlots);if(p.AccountCategory!="Freelancer")yield return Num("internal team seats",t.InternalSeats,old?.InternalSeats);yield return Num("AI assessments / month",t.MonthlyAssessments,old?.MonthlyAssessments);yield return Num("JD analyses / month",t.MonthlyJdAnalyses,old?.MonthlyJdAnalyses);var appText=t.ApplicationsPerPosition is int cap?$"Careers page included · {cap} applications per position":"Careers page included · no per-position application cap";yield return new(appText,old is not null&&Increased(t.ApplicationsPerPosition,old.ApplicationsPerPosition),Delta(t.ApplicationsPerPosition,old?.ApplicationsPerPosition));if(p.AccountCategory=="Freelancer")yield return new(t.Marketplace?"Marketplace profile, availability & invitations":"Marketplace not included",t.Marketplace&&old?.Marketplace!=true,"Included");if(t.MasterPool)yield return new("Master Talent Pool included",old?.MasterPool!=true,"Included");if(t.MeetingIntegrations)yield return new("Online interviews, on-site scheduling & candidate email notifications",old?.MeetingIntegrations!=true,"Included");if(t.Reports)yield return new("Recruitment reports & exports",old?.Reports!=true,"Included");if(t.EmailTemplates)yield return new("Email Templates",old?.EmailTemplates!=true,"Included");yield return new("Private talent pool & core recruitment workflow");}
protected override async Task OnInitializedAsync(){Updates.Changed+=Changed;await Run(Load);}
Task Load()=>LoadCore();async Task LoadCore()=>data=await Subscriptions.Overview();
void Changed()=>_=InvokeAsync(async()=>{await Run(Load);StateHasChanged();});
public void Dispose()=>Updates.Changed-=Changed;
void Select(string value){tab=value;selected=null;}
void Review(SubscriptionPlan plan){selected=plan;note="";}
bool IsLower(SubscriptionPlan plan)=>data is not null&&SubscriptionRules.Tier(plan.Code)<SubscriptionRules.Tier(data.CurrentPlanCode);
void ReviewCancellation(){if(data is null)return;var free=data.Plans.SingleOrDefault(p=>p.Code=="free");if(free is not null)Review(free);}
Task KeepPlan()=>Run(async()=>{if(data?.ScheduledChange is not {} change)return;await Subscriptions.KeepCurrentPlan(change.Id,change.Revision);await Load();Notice="Scheduled change withdrawn. Your current plan continues.";});
Task Submit()=>Run(async()=>{
    if(selected is null||data is null)return;
    if(IsLower(selected)){await Subscriptions.ScheduleChange(selected.Id,selected.Revision,data.Workspace.Revision,billing,money);selected=null;tab="My subscription";await Load();Notice=data?.ScheduledChange is null?"Plan change applied because the renewal date has been reached.":"Plan change saved. Your current benefits remain active until the effective renewal date.";}
    else{await Subscriptions.Request(selected.Id,selected.Revision,billing,money,note);selected=null;tab="Upgrade requests";await Load();Notice="Upgrade requested. It will activate immediately after Admin confirms payment, with no AI allowance carried forward.";}
});
Task RequestAccess()=>Run(async()=>{await Employers.Request(feature,quantity,accessNote);accessNote="";tab="Upgrade requests";await Load();Notice="Add-on request sent to Admin.";});
}
