@page
@model Osynix.Ats.Pages.Account.ForgotPasswordModel
@{ Layout="_AuthLayout"; ViewData["Title"]="Forgot Password"; }
<div class="auth-title"><span class="auth-eyebrow">ACCOUNT RECOVERY</span><h1>Forgot Password?</h1><p>We’ll send a secure link to reset your password.</p></div>
@if(Model.Sent){<div class="auth-success">If this address has an eligible account, reset instructions will be sent to its inbox.</div>}
else{<form method="post"><div asp-validation-summary="All" class="auth-error"></div><label>Email Address<input asp-for="Email" type="email" autocomplete="email" required /></label><button class="auth-primary" type="submit">Send Reset Link →</button></form>}
<p class="auth-switch"><a href="/Account/Login">Back to Sign In</a></p>
