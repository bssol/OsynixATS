@page
@model Osynix.Ats.Pages.Account.PasswordModel
@{ Layout="_AuthLayout"; ViewData["Title"]=Model.HasPassword?"Change Password":"Set Password"; }
<div class="auth-title"><h1>@ViewData["Title"]</h1><p>Your ATS password is separate from your Google password. Google sign-in will remain available.</p></div>
<div asp-validation-summary="All" class="auth-error"></div>
@if(Model.Complete){<div class="auth-success">Your ATS password is saved. You can now sign in with your email and this password.</div>}
else{
 <form method="post">
  @if(Model.HasPassword){<label asp-for="CurrentPassword">Current ATS Password</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" /><p class="auth-switch"><a href="/Account/ForgotPassword">Forgot Your ATS Password?</a></p>}
  else{<p class="auth-note">Your Google account has no ATS password yet. Set one to also sign in with email.</p>}
  <label asp-for="NewPassword">New ATS Password</label><input asp-for="NewPassword" type="password" autocomplete="new-password" />
  <p class="auth-hint">Use at least 6 characters, including uppercase and lowercase letters, a number, and a symbol.</p>
  <label asp-for="ConfirmPassword">Confirm New Password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
  <button type="submit" class="auth-primary">@(Model.HasPassword?"Change Password":"Set Password")</button>
 </form>
}
<p class="auth-switch"><a href="@Model.BackUrl">Back to My Profile</a></p>
