@page
@model Osynix.Ats.Pages.Account.RegisterModel
@{ Layout="_AuthLayout"; ViewData["Title"]="Create Account"; }
<div class="auth-title"><span class="auth-eyebrow">JOIN OSYNIX</span><h1>Create Your Account</h1><p>Choose your role and start your journey.</p></div>
<form method="post" asp-page-handler="Google"><input asp-for="Invite" type="hidden"/><button class="google-button" type="submit"><span class="google-g">G</span>Sign Up With Google</button></form>
<div class="auth-divider"><span>or register with email</span></div>
<form method="post"><input asp-for="Invite" type="hidden"/><div asp-validation-summary="All" class="auth-error"></div><label>Full Name<input asp-for="FullName" autocomplete="name" required /></label>
<label>Email Address<input asp-for="Email" type="email" autocomplete="email" required /></label>
<label>Account Type<select asp-for="Role"><option value="Recruiter">@(string.IsNullOrEmpty(Model.Invite)?"Freelance Recruiter":"Team Member")</option><option>Employer</option><option>Candidate</option></select></label>
<label>Password<div class="password-field"><input asp-for="Password" type="password" autocomplete="new-password" required /><button type="button" class="password-toggle" aria-label="Show Password">Show</button></div><small>6+ characters, uppercase, lowercase, a number and a symbol.</small></label>
<label>Confirm Password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required /></label>
<button class="auth-primary" type="submit">Send Verification Code <span>→</span></button></form><p class="auth-switch">Already registered? <a href="/Account/Login">Sign In</a></p>
