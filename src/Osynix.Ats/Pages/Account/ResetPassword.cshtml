@page
@model Osynix.Ats.Pages.Account.ResetPasswordModel
@{ Layout="_AuthLayout"; ViewData["Title"]="Reset Password"; }
<div class="auth-title"><span class="auth-eyebrow">ACCOUNT RECOVERY</span><h1>Choose a New Password</h1><p>Use a strong password unique to your account.</p></div>
@if(Model.Complete){<div class="auth-success">Your password has been reset.</div><a class="auth-primary auth-link" href="/Account/Login">Sign In →</a>}
else{<form method="post"><div asp-validation-summary="All" class="auth-error"></div><input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" /><label>New Password<div class="password-field"><input asp-for="Password" type="password" autocomplete="new-password" required /><button type="button" class="password-toggle" aria-label="Show Password">Show</button></div><small>6+ characters, uppercase, lowercase, a number and a symbol.</small></label><label>Confirm Password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required /></label><button class="auth-primary" type="submit">Reset Password →</button></form>}
