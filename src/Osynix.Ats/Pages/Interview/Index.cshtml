@page "/interview"
@{Layout=null; Response.Headers.CacheControl="no-store";Response.Headers["Referrer-Policy"]="no-referrer";}
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Interview Invitation · Osynix ATS</title><link rel="stylesheet" href="/app.css" asp-append-version="true" /><link rel="stylesheet" href="/review.css" asp-append-version="true" /></head><body><header class="review-header"><img src="/images/osynix-group-logo.png" alt="Osynix Group" width="175" height="30" /><span>Interview Invitation</span></header><main class="review-main interview-response-page"><h1 id="title">Your Interview Invitation</h1><div id="notice" role="status" aria-live="polite"></div><form id="csrf" hidden method="post">@Html.AntiForgeryToken()</form><section id="invitation" class="panel" hidden><h2 id="position"></h2><p id="company"></p><span id="status" class="badge"></span><h3 id="when"></h3><p id="format"></p><a id="meeting" class="button secondary" target="_blank" rel="noopener noreferrer" hidden>Open Meeting Link</a><p id="address" class="preserve"></p><p id="message" class="preserve"></p><p id="proposed"></p><form id="response"><label>Your Response<select id="choice" required><option value="Accepted">Confirm Availability</option><option value="Declined">Decline Interview</option><option value="New Time Proposed">Propose New Time</option></select></label><div id="proposal" hidden><label>Proposed Date And Time<input type="datetime-local" id="start" /></label><label>Time Zone<input id="zone" list="zones" maxlength="100" /><datalist id="zones"><option>Asia/Karachi</option><option>UTC</option><option>Europe/London</option><option>Asia/Dubai</option><option>America/New_York</option></datalist></label></div><label>Notes (Optional)<textarea id="notes" rows="3" maxlength="2000"></textarea></label><button id="submit" type="submit">Submit Response</button></form><p class="muted small">Your Response Updates The Recruiter And Hiring Manager. No Account Is Required.</p></section></main><script src="/interview.js" asp-append-version="true"></script></body></html>
