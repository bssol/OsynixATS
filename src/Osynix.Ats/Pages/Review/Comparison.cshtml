@page "/review/comparison"
@{ Layout=null; }
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" /><title>Candidate Comparison · Osynix ATS</title><link rel="stylesheet" href="/app.css" asp-append-version="true" /><link rel="stylesheet" href="/review.css" asp-append-version="true" /></head>
<body><header class="review-header"><img src="/images/osynix-group-logo.png" alt="Osynix Group" width="175" height="30" /><span>Client Review</span></header>
<main class="review-main"><div class="page-heading"><div><h1>Candidate Comparison</h1><p id="comparison-position" class="muted"></p></div><div><a id="back-review" class="button secondary" href="/review">Back To Review</a> <a id="download-comparison" class="button secondary">Download Comparison PDF</a></div></div><div id="notice" role="status"></div>
<section class="panel"><h2>Candidate Summary</h2><div class="table-wrap"><table><thead><tr><th>Candidate Name</th><th>ATS Match</th><th>Must-Have Fit</th><th>Recommendation</th><th>View Assessment</th></tr></thead><tbody id="comparison-rows"></tbody></table></div><p id="comparison-empty" class="empty">Loading submitted candidates…</p></section>
<section id="comparison-detail" class="panel"><div class="section-heading"><h2 id="assessment-name">Assessment Results</h2><a id="assessment-feedback" class="button secondary" hidden>Review And Give Feedback</a></div><p id="assessment-hint" class="muted">Choose View beside a candidate to display their assessment results below.</p><iframe id="comparison-report" title="Selected Candidate Assessment Results" referrerpolicy="no-referrer" sandbox="allow-same-origin" hidden></iframe></section></main>
<script src="/comparison.js" asp-append-version="true"></script></body></html>
