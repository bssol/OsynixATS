@page "/review"
@{ Layout=null; }
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" /><title>Client Portal · Osynix ATS</title><link rel="stylesheet" href="/review.css" asp-append-version="true" /><link rel="stylesheet" href="/client-portal.css" asp-append-version="true" /></head>
<body><header class="review-header"><img src="/images/osynix-group-logo.png" alt="Osynix Group" width="175" height="30" /><span>Secure Hiring Review</span></header>
<main class="review-main"><div class="page-heading"><div><div class="eyebrow">HIRING MANAGER</div><h1 id="welcome">Review Submitted Profiles</h1><p class="muted">Review assessment reports, share your feedback, and propose interview availability.</p></div><button id="refresh" class="secondary" type="button">Refresh</button></div>
<div id="notice" role="status" aria-live="polite"></div><form id="csrf" hidden method="post">@Html.AntiForgeryToken()</form>
<div id="review-kpis" class="review-kpis"></div>
<section class="panel"><label>Shared position<select id="position"><option value="">All shared positions</option></select></label><label>Search candidates<input id="candidate-search" type="search" placeholder="Search shared candidates…" /></label><p id="position-context" class="muted"></p><div class="section-heading"><p id="count" class="muted"></p><div><a id="comparison" class="button secondary" target="_blank" rel="noopener noreferrer">View Comparison Report</a> <a id="pdf" class="button secondary">Download PDF</a></div></div>
<div class="table-wrap"><table><thead><tr><th>Candidate Name</th><th>ATS Match</th><th>AI Decision</th><th>Current Status</th><th>Your Feedback</th></tr></thead><tbody id="profiles"></tbody></table></div><p id="empty" class="empty">Loading shared positions…</p></section>
<section class="panel"><h2>Interview Updates</h2><p class="muted">Review Candidate Confirmations, Proposed Times And Upcoming Interviews.</p><div id="interviews"></div></section>
<p class="muted small">This page contains only profiles explicitly shared with you. Candidate contact details, CVs, and internal Recruiter notes are excluded. Share the link only with your authorized client review team.</p></main>
<dialog id="profile"><div class="drawer-head"><div><h2 id="profile-name"></h2><p id="profile-summary" class="muted small"></p></div><button id="close-profile" type="button" class="secondary">Close</button></div><div class="review-profile"><div><div class="section-heading"><h3>Assessment Report</h3><a id="single-pdf" class="button secondary">Download PDF</a></div><iframe id="report" title="Candidate Assessment Report" referrerpolicy="no-referrer" sandbox="allow-same-origin"></iframe></div>
<form id="feedback"><section id="recruiter-response" hidden><h3>Recruiter Response</h3><p id="response-text" class="preserve"></p></section><section id="evaluation-interview" class="evaluation-interview" hidden><h3>Interview Details</h3><span id="evaluation-status" class="badge"></span><p id="evaluation-schedule"></p><p id="evaluation-response"></p><a id="evaluation-meeting" class="button" target="_blank" rel="noopener noreferrer" hidden>Join Online Interview</a><p id="evaluation-link" class="small preserve"></p><p id="evaluation-location" class="preserve"></p><p id="evaluation-guidance" class="muted small"></p></section><h3 id="feedback-heading">Your Feedback</h3><label id="completion-confirmation" class="check" hidden><input type="checkbox" id="interview-completed" /> I Confirm The Interview Has Taken Place</label><label>Next Step<select id="status" required><option value="">Choose Status</option><option>Shortlist</option><option value="Request Interview">Arrange Interview</option><option>Hold</option><option>Reject</option><option value="More Information Required">Request Information</option><option value="Recommend Hire">Recommend hire</option><option value="Send Offer">Request offer</option></select></label><label>Remarks<textarea id="remarks" rows="4" maxlength="5000"></textarea></label><div id="interview-preferences" hidden><h3>Interview Preferences</h3><label>Interview Mode<select id="mode"><option value="">Not Provided</option><option>Online</option><option>On-Site</option></select></label><label>Date And Time<input id="start" type="datetime-local" /></label><small id="day"></small><label>Time Zone<select id="zone"></select></label><label>Duration (Minutes)<input id="duration" type="number" min="15" max="240" step="15" value="30" /></label><label id="location-label">On-Site Location / Instructions<textarea id="location" rows="2" maxlength="500"></textarea></label><p class="muted small">Your Recruiter will confirm the slot and arrange the interview invitation.</p></div><p id="offer-guidance" class="muted small" hidden>The Recruiter Will Receive An Action To Prepare And Send The Offer. This Decision Does Not Email An Offer Letter Automatically.</p><div id="form-notice" role="status"></div><button id="submit" type="submit">Submit Feedback</button></form></div></dialog>
<script src="/review.js" asp-append-version="true"></script><script src="/client-portal.js" asp-append-version="true"></script></body></html>
