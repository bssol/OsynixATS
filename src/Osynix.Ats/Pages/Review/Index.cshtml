@page "/review"
@{ Layout=null; }
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" /><title>Hiring Manager Review · Osynix ATS</title><link rel="stylesheet" href="/app.css" asp-append-version="true" /><link rel="stylesheet" href="/review.css" asp-append-version="true" /></head>
<body><header class="review-header"><img src="/images/osynix-group-logo.png" alt="Osynix Group" width="175" height="30" /><span>Secure Hiring Review</span></header>
<main class="review-main"><div class="page-heading"><div><div class="eyebrow">HIRING MANAGER</div><h1 id="welcome">Review Submitted Profiles</h1><p class="muted">Review assessment reports, share your feedback, and propose interview availability.</p></div><button id="refresh" class="secondary" type="button">Refresh</button></div>
<div id="notice" role="status" aria-live="polite"></div><form id="csrf" hidden method="post">@Html.AntiForgeryToken()</form>
<section class="panel"><label>Select Position<select id="position"><option value="">Choose Position</option></select></label><div class="section-heading"><p id="count" class="muted"></p><div><a id="comparison" class="button secondary" target="_blank" rel="noopener noreferrer">View Comparison Report</a> <a id="pdf" class="button secondary">Download PDF</a></div></div>
<div class="table-wrap"><table><thead><tr><th>Candidate Name</th><th>ATS Match</th><th>AI Decision</th><th>Recruitment Stage</th><th>Your Feedback</th></tr></thead><tbody id="profiles"></tbody></table></div><p id="empty" class="empty">Loading shared positions…</p></section>
<section class="panel"><h2>Interview Updates</h2><p class="muted">Proposed availability is sent to the Recruiter. It becomes a booking after the Recruiter confirms it.</p><div id="interviews"></div></section>
<p class="muted small">This page contains only profiles explicitly shared with you. Candidate contact details, CVs, and internal Recruiter notes are excluded. Share the link only with your authorized client review team.</p></main>
<dialog id="profile"><div class="drawer-head"><div><h2 id="profile-name"></h2></div><button id="close-profile" type="button" class="secondary">Close</button></div><div class="review-profile"><div><div class="section-heading"><h3>Assessment Report</h3><a id="single-pdf" class="button secondary">Download PDF</a></div><iframe id="report" title="Candidate Assessment Report" referrerpolicy="no-referrer" sandbox="allow-same-origin"></iframe></div>
<form id="feedback"><h3>Your Feedback</h3><label>Status<select id="status" required><option value="">Choose Status</option><option>Shortlist</option><option>Request Interview</option><option>Hold</option><option>Reject</option></select></label><label>Remarks<textarea id="remarks" rows="4" maxlength="5000"></textarea></label><h3>Interview Availability</h3><label>Interview Mode<select id="mode"><option value="">Not Provided</option><option>Online</option><option>On-Site</option></select></label><label>Date And Time<input id="start" type="datetime-local" /></label><small id="day"></small><label>Time Zone<input id="zone" list="zones" /><datalist id="zones"><option>Asia/Karachi</option><option>UTC</option><option>Europe/London</option><option>America/New_York</option><option>Asia/Dubai</option></datalist></label><label>Duration (Minutes)<input id="duration" type="number" min="15" max="240" step="15" value="30" /></label><label>On-Site Location / Instructions<textarea id="location" rows="2" maxlength="500"></textarea></label><p class="muted small">Your Recruiter will confirm the slot and arrange the interview invitation.</p><div id="form-notice" role="status"></div><button id="submit" type="submit">Submit Feedback</button></form></div></dialog>
<script src="/review.js" asp-append-version="true"></script></body></html>
